---
// Code Preview — urduai.org/code/
// Paste HTML code, preview it live, and download as HTML file
import '../../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HTML کوڈ پریویو اور ڈاؤن لوڈ — Urdu Ai</title>
  <meta name="description" content="HTML کوڈ پیسٹ کریں، لائیو پریویو دیکھیں اور فائل ڈاؤن لوڈ کریں۔ اردو اے آئی کا مفت ٹول۔" />
  <link rel="canonical" href="https://urduai.org/code/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&family=Inter:wght@400;700;800&display=swap" rel="stylesheet" />
  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Noto Nastaliq Urdu', serif;
      background: #f8f9fc;
      color: #1a2236;
      min-height: 100vh;
    }

    .tool-header {
      background: linear-gradient(160deg, #153d75 0%, #1d559f 50%, #1a4a8a 100%);
      color: #fff;
      padding: 1.5rem 1rem;
      text-align: center;
    }

    .tool-header h1 {
      font-size: 1.6rem;
      line-height: 1.8;
      margin-bottom: 0.3rem;
    }

    .tool-header p {
      font-size: 0.9rem;
      color: #fef9e0;
      line-height: 2;
    }

    .tool-header__brand {
      font-family: 'Inter', sans-serif;
      font-weight: 800;
      font-size: 0.85rem;
      color: #fff;
      text-decoration: none;
      direction: ltr;
      unicode-bidi: embed;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    .tool-header__brand span { color: #f1cc11; }

    .tool-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    .tool-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    @media (max-width: 768px) {
      .tool-grid {
        grid-template-columns: 1fr;
      }
    }

    .tool-panel {
      background: #fff;
      border: 1px solid #d0d7e2;
      border-radius: 12px;
      overflow: hidden;
    }

    .tool-panel__header {
      background: #eef1f7;
      padding: 0.6rem 1rem;
      font-weight: 700;
      font-size: 0.9rem;
      border-bottom: 1px solid #d0d7e2;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .tool-panel__header span {
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      color: #6078a0;
      direction: ltr;
    }

    #code-input {
      width: 100%;
      min-height: 400px;
      padding: 1rem;
      border: none;
      font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
      font-size: 0.85rem;
      line-height: 1.6;
      direction: ltr;
      unicode-bidi: embed;
      resize: vertical;
      background: #fff;
      color: #1a2236;
    }

    #code-input:focus {
      outline: 2px solid #1d559f;
      outline-offset: -2px;
    }

    #code-input::placeholder {
      color: #a8b3c4;
    }

    #preview-frame {
      width: 100%;
      min-height: 400px;
      border: none;
      background: #fff;
    }

    .tool-actions {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-tool {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7em 1.5em;
      border-radius: 8px;
      font-family: 'Noto Nastaliq Urdu', serif;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.2s;
    }

    .btn-tool:hover {
      transform: translateY(-2px);
    }

    .btn-tool--primary {
      background: #1d559f;
      color: #fff;
    }

    .btn-tool--primary:hover {
      box-shadow: 0 4px 16px rgba(29, 85, 159, 0.3);
    }

    .btn-tool--gold {
      background: #f1cc11;
      color: #1a2236;
    }

    .btn-tool--gold:hover {
      box-shadow: 0 4px 16px rgba(241, 204, 17, 0.3);
    }

    .btn-tool--outline {
      background: transparent;
      color: #1d559f;
      border: 2px solid #1d559f;
    }

    .tool-footer {
      text-align: center;
      padding: 2rem 1rem;
      font-size: 0.8rem;
      color: #6078a0;
      line-height: 2;
    }

    .tool-footer a {
      color: #1d559f;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="tool-header">
    <a href={`${base}/`} class="tool-header__brand">Urdu <span>Ai</span></a>
    <h1>HTML کوڈ پریویو اور ڈاؤن لوڈ</h1>
    <p>HTML کوڈ پیسٹ کریں، لائیو پریویو دیکھیں اور فائل ڈاؤن لوڈ کریں</p>
  </div>

  <div class="tool-container">
    <div class="tool-grid">
      <div class="tool-panel">
        <div class="tool-panel__header">
          کوڈ لکھیں
          <span>HTML / CSS / JS</span>
        </div>
        <textarea id="code-input" placeholder="یہاں HTML کوڈ پیسٹ کریں..."></textarea>
      </div>

      <div class="tool-panel">
        <div class="tool-panel__header">
          پریویو
          <span>Live Preview</span>
        </div>
        <iframe id="preview-frame" sandbox="allow-scripts allow-same-origin"></iframe>
      </div>
    </div>

    <div class="tool-actions">
      <button class="btn-tool btn-tool--primary" id="btn-preview" type="button">پریویو دکھائیں</button>
      <button class="btn-tool btn-tool--gold" id="btn-download" type="button">HTML ڈاؤن لوڈ کریں</button>
      <button class="btn-tool btn-tool--outline" id="btn-clear" type="button">صاف کریں</button>
    </div>
  </div>

  <div class="tool-footer">
    <a href={`${base}/`}>urduai.org</a> — پاکستان کا سب سے بڑا اردو AI پلیٹ فارم
  </div>

  <script is:inline>
    const codeInput = document.getElementById('code-input');
    const previewFrame = document.getElementById('preview-frame');
    const btnPreview = document.getElementById('btn-preview');
    const btnDownload = document.getElementById('btn-download');
    const btnClear = document.getElementById('btn-clear');

    function updatePreview() {
      const code = codeInput.value;
      const doc = previewFrame.contentDocument || previewFrame.contentWindow.document;
      doc.open();
      doc.write(code);
      doc.close();
    }

    // Live preview as user types
    let debounceTimer;
    codeInput.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(updatePreview, 300);
    });

    btnPreview.addEventListener('click', updatePreview);

    btnDownload.addEventListener('click', function() {
      const code = codeInput.value;
      if (!code.trim()) return;
      const blob = new Blob([code], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'urduai-code.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    btnClear.addEventListener('click', function() {
      codeInput.value = '';
      const doc = previewFrame.contentDocument || previewFrame.contentWindow.document;
      doc.open();
      doc.write('');
      doc.close();
    });
  </script>

</body>
</html>
