---
import Base from '../layouts/Base.astro';
import ContentImage from '../components/ContentImage.astro';
import HomeHeader from '../components/HomeHeader.astro';
import HomeFooter from '../components/HomeFooter.astro';
import HomeVideoCard from '../components/HomeVideoCard.astro';
import { getCollection } from 'astro:content';
import { lessons } from '../data/masterclass-lessons';
import videoFeed from '../../public/data/youtube-videos.json';
import { newestPublished, validVideos, formatUrduDate } from '../utils/homepage-content.mjs';
import '../styles/homepage.css';

const [posts, guides, tutorials, prompts] = await Promise.all([
  getCollection('blog'), getCollection('guides'), getCollection('howto'), getCollection('prompts'),
]);
const publishedPosts = newestPublished(posts);
const featuredPost = publishedPosts[0];
const morePosts = publishedPosts.slice(1, 7);
const learningLinks = [
  ...newestPublished(guides).slice(0, 2).map(entry => ({ ...entry, route: '/guides' })),
  ...newestPublished(tutorials).slice(0, 1).map(entry => ({ ...entry, route: '/how-to' })),
];
const promptItems = Object.fromEntries([['student', 'students'], ['teacher', 'teachers'], ['business', 'small-business']].map(([key, id]) => {
  const entry = prompts.find(item => item.id === id && !item.data.draft);
  const text = entry?.body?.match(/پرامٹ:\s*\n([\s\S]*?)(?=\n\s*نتیجہ:|\n[─]+)/)?.[1]?.trim() ?? '';
  return [key, { text, href: `/prompts/${id}/` }];
}));
const videos = validVideos(videoFeed);
---
<Base bodyClass="homepage" title="اردو اے آئی — پاکستان کا سب سے بڑا اردو اے آئی پلیٹ فارم" description="اردو اے آئی پاکستان کا سب سے بڑا اردو زبان میں مصنوعی ذہانت کا پلیٹ فارم ہے۔ اے آئی ٹولز، گائیڈز، ٹیوٹوریلز اور پرامٹس — سب اردو میں۔" canonical="https://urduai.org/" ogImage="/og/urduai-og.jpg" adsense={true}>
  <HomeHeader slot="header" />
  <HomeFooter slot="footer" />

  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">اردو اے آئی</p>
      <h1>مصنوعی ذہانت کو اردو میں سمجھیں،<br class="desktop-break"> استعمال کریں، اور <span class="highlight">آگے بڑھیں۔</span></h1>
      <p class="hero-description">۲۵ کروڑ اردو بولنے والوں کے لیے — بالکل مفت۔</p>
      <div class="hero-actions"><a class="button" href="#start-learning" data-analytics-event="learning_path_open" data-analytics-location="homepage-hero">اے آئی سیکھنا شروع کریں</a><a class="text-link" href="/app/">ایپ ڈاؤن لوڈ کریں <span aria-hidden="true">←</span></a></div>
    </div>
    <dl class="metrics">
      <div><dt>اردو بولنے والے</dt><dd dir="ltr">250M+</dd></div>
      <div><dt>آن لائن کمیونٹی</dt><dd dir="ltr">1M+</dd></div>
      <div><dt>ایپ ڈاؤن لوڈز</dt><dd dir="ltr">50K+</dd></div>
    </dl>
  </section>
  {featuredPost && <section class="lead-band" aria-labelledby="lead-title">
    <a class="lead wrap" href={`/blog/${featuredPost.id}/`}>
      {featuredPost.data.image && <ContentImage src={featuredPost.data.image} width="1200" height="630" alt="" loading="eager" fetchpriority="high" sizes="(max-width: 760px) calc(100vw - 36px), 650px" />}
      <div class="lead-copy">
        <p class="kicker">نمایاں اے آئی اپڈیٹ</p>
        <h2 id="lead-title">{featuredPost.data.title}</h2>
        {featuredPost.data.description?.trim() && <p class="lead-excerpt">{featuredPost.data.description}</p>}
        <p class="date"><time datetime={featuredPost.data.published_at ?? featuredPost.data.date}>{formatUrduDate(featuredPost.data.date)}</time></p>
        <span class="read-link">مکمل پڑھیں ←</span>
      </div>
    </a>
  </section>}
  <div class="wrap ad-slot" data-ad-placement="homepage-top"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-8532451951782012" data-ad-slot="3562374472" data-ad-format="auto" data-full-width-responsive="true"></ins></div>
  <section class="learning wrap" id="start-learning" aria-labelledby="learning-title">
    <h2 id="learning-title">پہلی بار اے آئی سیکھ رہے ہیں؟</h2>
    <ol class="steps">
      <li><a href="/guides/ai-kya-hai-urdu-ai-master-class-1/"><span class="step-number" aria-hidden="true">01</span><h3>اے آئی کو سمجھیں</h3></a></li>
      <li><a href="/how-to/how-to-install-original-chatgpt-app/"><span class="step-number" aria-hidden="true">02</span><h3>چیٹ جی پی ٹی شروع کریں</h3></a></li>
      <li><a href="/practice/"><span class="step-number" aria-hidden="true">03</span><h3>اپنے کام کا پرامٹ آزمائیں</h3></a></li>
    </ol>
  </section>
  <section class="latest wrap" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">تازہ ترین خبریں</h2><a href="/blog/">تمام مضامین ←</a></div>
    <div class="stories news-grid">
      {morePosts.map(post => <article><a href={`/blog/${post.id}/`}>
        {post.data.image && <ContentImage src={post.data.image} alt="" width="1200" height="630" loading="lazy" sizes="(max-width: 760px) calc(100vw - 36px), 400px" />}
        <h3>{post.data.title}</h3></a><p class="date"><time datetime={post.data.date}>{formatUrduDate(post.data.date)}</time></p></article>)}
    </div>
  </section>

  <section class="video-section" id="videos" aria-labelledby="video-heading"><div class="wrap">
    <div class="section-heading"><div><h2 id="video-heading">دیکھیں، سمجھیں، پھر آزمائیں</h2><p class="section-intro">ہمارے یوٹیوب چینل کی تازہ ویڈیوز</p></div><a href="https://www.youtube.com/@Urduaiorg/videos" target="_blank" rel="noopener">تمام ویڈیوز ↗</a></div>
    <div class="video-grid" id="homepage-videos">{videos.slice(0, 3).map(video => <HomeVideoCard video={video} />)}</div>
    <p class="video-status" id="video-status" role="status" aria-live="polite"></p>
  </div></section>
  <section class="practical wrap" aria-labelledby="practical-heading">
    <div class="guide-list"><h2 id="practical-heading">گائیڈز اور عملی سبق</h2><ol>{learningLinks.map((entry, i) => <li><a href={`${entry.route}/${entry.id}/`}><span class="guide-number latin">{String(i + 1).padStart(2, '0')}</span><h3>{entry.data.title}</h3><span aria-hidden="true">←</span></a></li>)}</ol><a class="text-link" href="/guides/">تمام گائیڈز ←</a></div>
    <aside class="prompt-panel" aria-labelledby="prompt-heading"><h2 id="prompt-heading">آج کا پرامٹ</h2><div class="prompt-options" role="group" aria-label="اپنا کام منتخب کریں"><button class="selected" data-prompt="student" aria-pressed="true">طالب علم</button><button data-prompt="teacher" aria-pressed="false">استاد</button><button data-prompt="business" aria-pressed="false">کاروبار</button></div><p id="prompt-copy">{promptItems.student.text}</p><button class="button" id="copy-prompt">پرامٹ کاپی کریں</button><p id="copy-status" role="status" aria-live="polite"></p><a id="prompt-more" href="/prompts/students/">مزید پرامٹس ←</a></aside>
  </section>
  <section class="course-section"><div class="course-inner wrap"><div><p class="course-label">مفت کورس</p><h2>اے آئی ماسٹرکلاس</h2><p>اے آئی بالکل شروع سے سیکھیں۔ ہر سبق کے بعد اپنی سمجھ جانچیں اور اگلا قدم اٹھائیں۔</p><a class="button" href="/courses/masterclass/">کورس شروع کریں ←</a></div><div class="course-details"><div><strong class="latin">{String(lessons.length).padStart(2, "0")}</strong><span>ویڈیو اسباق</span></div><ol><li>مصنوعی ذہانت کی بنیادی سمجھ</li><li>تحریر، تصاویر اور ویڈیوز بنانا</li><li>اے آئی سے ایپس اور ویب سائٹس بنانا</li></ol><a href="/courses/">تمام کورسز دیکھیں ←</a></div></div></section>
  <div class="wrap ad-slot" data-ad-placement="homepage-middle"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-8532451951782012" data-ad-slot="8933556005" data-ad-format="auto" data-full-width-responsive="true"></ins></div>
  <section class="app-section" id="app" aria-labelledby="app-heading"><div class="app-inner wrap"><div class="app-copy"><h2 id="app-heading">اردو اے آئی،<br>اب آپ کی جیب میں</h2><p>سبق دیکھیں، مشق کریں، سیکھتے رہیں۔</p><p class="app-stat"><strong class="latin" dir="ltr">50K+</strong><span>ایپ ڈاؤن لوڈز</span></p><div class="store-buttons"><a class="button latin" href="https://play.google.com/store/apps/details?id=com.yourname.urduaiwebwrapperfixed" target="_blank" rel="noopener">Android ↗</a><a class="button latin" href="https://apps.apple.com/ca/app/urdu-ai/id6809815120" target="_blank" rel="noopener">iPhone ↗</a></div><a class="app-guide" href="/guides/urdu-ai-app-android-iphone-guide/">ایپ کی گائیڈ پڑھیں ←</a></div><figure class="app-visual"><div class="phone-gallery"><button class="screen-open" data-screen="/images/guides/urdu-ai-app-android-iphone-guide/iphone-home.jpg" data-label="ہوم" aria-label="ہوم اسکرین بڑی کر کے دیکھیں"><ContentImage src="/images/guides/urdu-ai-app-android-iphone-guide/iphone-home.jpg" alt="آئی فون ایپ کی ہوم اسکرین" width="221" height="480" loading="lazy" sizes="(max-width: 760px) 110px, 240px" /></button><button class="screen-open" data-screen="/images/guides/urdu-ai-app-android-iphone-guide/iphone-learn.jpg" data-label="سیکھیں" aria-label="سیکھیں اسکرین بڑی کر کے دیکھیں"><ContentImage src="/images/guides/urdu-ai-app-android-iphone-guide/iphone-learn.jpg" alt="آئی فون ایپ میں کورسز اور سیکھنے کا حصہ" width="221" height="480" loading="lazy" sizes="(max-width: 760px) 110px, 240px" /></button><button class="screen-open" data-screen="/images/guides/urdu-ai-app-android-iphone-guide/iphone-practice.jpg" data-label="پریکٹس لیب" aria-label="پریکٹس لیب بڑی کر کے دیکھیں"><ContentImage src="/images/guides/urdu-ai-app-android-iphone-guide/iphone-practice.jpg" alt="آئی فون ایپ کی پریکٹس لیب" width="221" height="480" loading="lazy" sizes="(max-width: 760px) 110px, 240px" /></button></div><figcaption>آئی فون ایپ کی اصل تصاویر — اینڈرائیڈ کی ترتیب مختلف ہو سکتی ہے۔</figcaption></figure></div></section>
  <section class="newsletter substack" id="newsletter"><div class="wrap newsletter-inner"><div><h2>اے آئی کی اہم باتیں،<br>ہر ہفتے آپ کے نام</h2><p>قیصر رونجھا کے ساتھ اردو میں سیکھیں۔</p></div><div class="substack-actions"><p class="latin" dir="ltr">Urdu Ai Updates</p><a class="button" id="substack-subscribe" data-analytics-event="newsletter_open" data-analytics-location="homepage" href="https://www.urduaiupdates.com/subscribe" target="_blank" rel="noopener"><bdi class="latin">Substack</bdi> پر سبسکرائب کریں ↗</a><a href="https://www.urduaiupdates.com/" target="_blank" rel="noopener">پچھلے شمارے پڑھیں ←</a></div></div></section>
  <section class="impact-link wrap" id="community-impact" aria-labelledby="impact-heading"><h2 id="impact-heading">کمیونٹی میں ہمارے کام کے بارے میں جانیئے۔</h2><a class="button latin" href="https://impact.urduai.org/" target="_blank" rel="noopener" dir="ltr">Impact.urduai.org ↗</a></section>
  <section class="community wrap"><h2>اپنی کمیونٹی کے ساتھ سیکھیں</h2><div><a href="https://whatsapp.com/channel/0029VaXXgd00AgW6jAZGw83j" target="_blank" rel="noopener">واٹس ایپ چینل ↗</a><a href="https://www.youtube.com/@Urduaiorg" target="_blank" rel="noopener">یوٹیوب ↗</a><a href="https://www.instagram.com/urduaiorg/" target="_blank" rel="noopener">انسٹاگرام ↗</a></div></section>
<dialog id="search-dialog" aria-labelledby="search-title"><button class="close-search icon-button" aria-label="تلاش بند کریں">×</button><h2 id="search-title">آپ کیا سیکھنا چاہتے ہیں؟</h2><form action="/search/" method="get"><label for="search-input">موضوع یا ٹول تلاش کریں</label><div class="search-row"><input type="search" id="search-input" name="q" placeholder="مثلاً چیٹ جی پی ٹی" required><button class="button" type="submit">تلاش کریں</button></div></form></dialog>
<dialog id="screen-dialog" aria-labelledby="screen-title"><button class="icon-button dialog-close" aria-label="تصویر بند کریں">×</button><h2 id="screen-title"></h2><img id="screen-full" alt=""></dialog>

  <script id="homepage-prompts" type="application/json" is:inline set:html={JSON.stringify(promptItems).replace(/</g, '\u003c')} />
  <script>
    import '../scripts/homepage.js';
  </script>
</Base>
