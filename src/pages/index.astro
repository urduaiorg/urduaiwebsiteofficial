---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const recentGuides = allGuides
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Base
  title="اردو اے آئی — پاکستان کا سب سے بڑا اردو اے آئی پلیٹ فارم"
  description="اردو اے آئی پاکستان کا سب سے بڑا اردو زبان میں مصنوعی ذہانت کا پلیٹ فارم ہے۔ اے آئی ٹولز، گائیڈز، ٹیوٹوریلز اور پرامٹس — سب اردو میں۔"
  adsense={true}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__brand">Urdu <span>Ai</span></h1>
      <p>
        مصنوعی ذہانت کو اردو میں سمجھیں، استعمال کریں، اور آگے بڑھیں۔
        ۲۵ کروڑ اردو بولنے والوں کے لیے — بالکل مفت۔
      </p>

      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-number" dir="ltr">50K+</span>
          <span class="hero__stat-label">ایپ ڈاؤن لوڈز</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-number" dir="ltr">1M+</span>
          <span class="hero__stat-label">آن لائن کمیونٹی</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-number" dir="ltr">250M+</span>
          <span class="hero__stat-label">اردو بولنے والے</span>
        </div>
      </div>

      <a href="/app/" class="btn-playstore" style="font-size:1.1rem; padding: 0.7em 2em;">
        مفت ایپ ڈاؤن لوڈ کریں
      </a>

      <div class="supported-by" style="margin-block-start:var(--space-lg);">
        <span style="color:var(--gold-pale);">S&P Global Foundation</span>
        <span style="color:var(--gold-pale);">·</span>
        <span style="color:var(--gold-pale);">Internet Society</span>
        <span style="color:var(--gold-pale);">·</span>
        <span style="color:var(--gold-pale);">Google.org</span>
        <span style="color:var(--gold-pale);">·</span>
        <span style="color:var(--gold-pale);">ElevenLabs</span>
      </div>
    </div>
  </section>

  <!-- Top banner ad -->
  <div class="container ad-slot" aria-hidden="true">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
      data-ad-slot="TOP_BANNER_SLOT"
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <!-- Recent blog posts -->
  <section class="container" style="margin-block-start: var(--space-lg);">
    <h2 class="section-heading">تازہ ترین خبریں</h2>
    <div class="post-grid">
      {recentPosts.map(post => (
        <article class="card">
          {post.data.image ? (
            <img
              src={post.data.image}
              alt={post.data.title}
              width="400"
              height="225"
              loading="lazy"
              style="border-radius:6px; margin-block-end:var(--space-sm); width:100%; height:160px; object-fit:cover;"
            />
          ) : (
            <div class="card__image-placeholder">
              <span>Urdu Ai</span>
            </div>
          )}
          <p class="card__meta">
            <span class="badge">{post.data.category}</span>
            &nbsp;
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('ur-PK', { year:'numeric', month:'long', day:'numeric' })}
            </time>
          </p>
          <h3 class="card__title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p class="card__excerpt">{post.data.description}</p>
        </article>
      ))}
    </div>
    <p style="text-align:center; margin-block-start: var(--space-md);">
      <a href="/blog/" style="color:var(--teal); font-weight:600;">تمام مضامین پڑھیں ←</a>
    </p>
  </section>

  <!-- Mid-page ad -->
  <div class="container ad-slot" aria-hidden="true">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
      data-ad-slot="MID_PAGE_SLOT"
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <!-- Guides section -->
  {recentGuides.length > 0 && (
    <section class="container" style="margin-block-start: var(--space-2xl);">
      <h2 class="section-heading">تازہ گائیڈز</h2>
      <div class="post-grid">
        {recentGuides.map(guide => (
          <article class="card">
            <p class="card__meta">
              <span class="badge badge--teal">{guide.data.level}</span>
              {guide.data.tool && <span style="margin-inline-start:0.5em">{guide.data.tool}</span>}
            </p>
            <h3 class="card__title"><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
            <p class="card__excerpt">{guide.data.description}</p>
          </article>
        ))}
      </div>
      <p style="text-align:center; margin-block-start: var(--space-md);">
        <a href="/guides/" style="color:var(--teal); font-weight:600;">تمام گائیڈز ←</a>
      </p>
    </section>
  )}

  <!-- Newsletter strip -->
  <section style="background:var(--ink); color:var(--paper); padding-block:var(--space-xl); margin-block-start:var(--space-2xl);">
    <div class="container" style="text-align:center;">
      <h2 style="color:var(--gold-light); margin-block-end:var(--space-sm);">اردو اے آئی نیوز لیٹر</h2>
      <p style="color:var(--gold-pale); margin-block-end:var(--space-md);">
        ہر ہفتے اے آئی کی تازہ ترین خبریں، گائیڈز اور پرامٹس — سیدھے آپ کی ای میل میں
      </p>
      <form
        action="https://urduai.beehiiv.com/subscribe"
        method="post"
        style="display:flex; gap:var(--space-sm); justify-content:center; flex-wrap:wrap;"
      >
        <input
          type="email"
          name="email"
          placeholder="آپ کی ای میل"
          required
          dir="ltr"
          style="padding:0.6em 1em; border-radius:6px; border:none; min-width:240px; font-size:1rem;"
        />
        <button type="submit" class="btn-playstore" style="border:none; cursor:pointer;">
          سبسکرائب کریں
        </button>
      </form>
    </div>
  </section>

  <!-- Content category quick links -->
  <section class="container" style="margin-block-start:var(--space-2xl); margin-block-end:var(--space-2xl);">
    <h2 class="section-heading">سیکھنے کے راستے</h2>
    <div class="post-grid">
      <a href="/how-to/" class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <path d="M13 16h14M13 20h10M13 24h12" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <circle cx="28" cy="24" r="4" stroke="#f1cc11" stroke-width="2"/>
            <path d="M31 27l2 2" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">ہاؤ ٹو ٹیوٹوریلز</h3>
        <p class="card__excerpt">قدم بقدم ہدایات — اسکرین شاٹس کے ساتھ</p>
      </a>
      <a href="/prompts/" class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#f1cc11" fill-opacity="0.12"/>
            <path d="M14 28V14l4 3 4-3 4 3 4-3v14l-4-3-4 3-4-3-4 3z" stroke="#1d559f" stroke-width="2" stroke-linejoin="round"/>
            <path d="M18 20h4M18 23h6" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">اردو پرامٹس</h3>
        <p class="card__excerpt">کاپی پیسٹ کے لیے تیار اردو پرامٹس</p>
      </a>
      <a href="/learn/" class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <path d="M12 14h6a2 2 0 012 2v12a1 1 0 01-1-1 2 2 0 012-2h7" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <path d="M28 14h-6a2 2 0 00-2 2v12a1 1 0 001-1 2 2 0 012-2h5" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <circle cx="20" cy="20" r="2" fill="#f1cc11"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">اردو اے آئی لغت</h3>
        <p class="card__excerpt">اے آئی اصطلاحات آسان اردو میں</p>
      </a>
      <a href="/courses/" class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#f1cc11" fill-opacity="0.12"/>
            <rect x="12" y="16" width="16" height="12" rx="2" stroke="#1d559f" stroke-width="2"/>
            <path d="M17 16v-2a3 3 0 016 0v2" stroke="#1d559f" stroke-width="2"/>
            <circle cx="20" cy="22" r="2" fill="#f1cc11"/>
            <path d="M20 24v2" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">مفت کورسز</h3>
        <p class="card__excerpt">مرحلہ وار اے آئی تعلیم — اردو میں</p>
      </a>
    </div>
  </section>
</Base>
