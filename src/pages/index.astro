    </section>
  )}

  <!-- ============================================================
       PROMPTS SECTION
       ============================================================ -->
  {recentPrompts.length > 0 && (
    <section class="container" style="margin-block-start: var(--space-2xl);">
      <h2 class="section-heading">تازہ پرامٹس</h2>
      <div class="post-grid">
        {recentPrompts.map(prompt => (
          <article class="card">
            {prompt.data.image ? (
              <img
                src={`${base}${prompt.data.image}`}
                alt={prompt.data.title}
                width="400"
                height="225"
                loading="lazy"
                style="border-radius:6px; margin-block-end:var(--space-sm); width:100%; height:auto; object-fit:contain;"
              />
            ) : (
              <div class="card__image-placeholder">
                <span>Urdu Ai</span>
              </div>
            )}
            <p class="card__meta">
              <span class="badge badge--gold">{prompt.data.prompt_count} پرامٹس</span>
              {prompt.data.profession && <span style="margin-inline-start:0.5em">{prompt.data.profession}</span>}
            </p>
            <h3 class="card__title"><a href={`${base}/prompts/${prompt.id}/`}>{prompt.data.title}</a></h3>
            <p class="card__excerpt">{prompt.data.description}</p>
          </article>
        ))}
      </div>
      <p style="text-align:center; margin-block-start: var(--space-md);">
        <a href={`${base}/prompts/`} style="color:var(--teal); font-weight:600;">تمام پرامٹس ←</a>
      </p>
    </section>
  )}

  <!-- ============================================================
       NEWSLETTER + AI VIEWER
       ============================================================ -->
  <section style="background:var(--ink); color:var(--paper); padding-block:var(--space-xl); margin-block-start:var(--space-2xl);">
    <div class="container" style="text-align:center;">
      <h2 style="color:var(--gold-light); margin-block-end:var(--space-sm);">ہفتہ وار AI نیوز لیٹر سبسکرائب کریں</h2>
      <p style="color:var(--gold-pale); margin-block-end:var(--space-md); line-height:2.2;">
        تازہ ترین AI خبریں، گائیڈز اور پرامٹس — ہر ہفتے آپ کے ای میل میں
      </p>
      <div style="display:flex; gap:0.8rem; justify-content:center; flex-wrap:wrap;">
        <a
          href="https://www.urduaiupdates.com/subscribe"
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-block; background:var(--gold); color:var(--ink); padding:0.6em 1.6em; border-radius:8px; font-weight:700; text-decoration:none; font-size:1rem;"
        >نیوز لیٹر سبسکرائب کریں</a>
        <a
          href="https://www.aiviewer.ai/"
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-block; background:transparent; color:var(--gold-light); padding:0.6em 1.6em; border-radius:8px; font-weight:700; text-decoration:none; font-size:1rem; border:1px solid var(--gold-light);"
        >AI Viewer — انگریزی مواد</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       START HERE — Learner path
       ============================================================ -->
  <section class="container" style="margin-block-start:var(--space-2xl); margin-block-end:var(--space-2xl);">
    <h2 class="section-heading">شروع یہاں سے</h2>
    <p class="text-muted" style="text-align:center; max-width:52rem; margin:0 auto var(--space-lg);">
      اگر آپ پہلی بار اردو اے آئی پر آئے ہیں تو ان چار قدموں سے آغاز کریں: پہلے اصطلاحات سمجھیں، پھر ایک ٹول استعمال کرنا سیکھیں، اس کے بعد اپنے لیے مناسب ٹول ڈھونڈیں، اور آخر میں تیار پرامٹس آزما لیں۔
    </p>
    <div class="post-grid">
      <a href={`${base}/learn/`} class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <path d="M12 14h6a2 2 0 012 2v12a1 1 0 01-1-1 2 2 0 012-2h7" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <path d="M28 14h-6a2 2 0 00-2 2v12a1 1 0 001-1 2 2 0 012-2h5" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <circle cx="20" cy="20" r="2" fill="#f1cc11"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">اردو اے آئی لغت</h3>
        <p class="card__excerpt">AI کیا ہے، ایجنٹ کیا ہوتا ہے، اور پرامپٹ انجینئرنگ کیوں اہم ہے — سب آسان اردو میں</p>
      </a>
      <a href={`${base}/how-to/`} class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <path d="M13 16h14M13 20h10M13 24h12" stroke="#1d559f" stroke-width="2" stroke-linecap="round"/>
            <circle cx="28" cy="24" r="4" stroke="#f1cc11" stroke-width="2"/>
            <path d="M31 27l2 2" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">پہلا ٹول کیسے استعمال کریں؟</h3>
        <p class="card__excerpt">ChatGPT، Gemini اور دوسرے ٹولز کے لیے قدم بہ قدم ہدایات</p>
      </a>
      <a href={`${base}/tools/`} class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <rect x="10" y="10" width="8" height="8" rx="2" stroke="#1d559f" stroke-width="2"/>
            <rect x="22" y="10" width="8" height="8" rx="2" stroke="#f1cc11" stroke-width="2"/>
            <rect x="10" y="22" width="8" height="8" rx="2" stroke="#f1cc11" stroke-width="2"/>
            <rect x="22" y="22" width="8" height="8" rx="2" stroke="#1d559f" stroke-width="2"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">پاکستان میں چلنے والے ٹولز</h3>
        <p class="card__excerpt">اپنے کام کے لیے درست مفت AI ٹول تلاش کریں</p>
      </a>
      <a href={`${base}/prompts/`} class="card card--category" style="text-decoration:none;">
        <span class="card__icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#f1cc11" fill-opacity="0.12"/>
            <path d="M14 28V14l4 3 4-3 4 3 4-3v14l-4-3-4 3-4-3-4 3z" stroke="#1d559f" stroke-width="2" stroke-linejoin="round"/>
            <path d="M18 20h4M18 23h6" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <h3 class="card__title" style="margin-block-start:0;">کاپی پیسٹ پرامٹس</h3>
        <p class="card__excerpt">تیار اردو پرامٹس جنہیں فوراً ChatGPT، Gemini یا Claude میں آزما سکتے ہیں</p>
      </a>
    </div>
  </section>
</Base>
