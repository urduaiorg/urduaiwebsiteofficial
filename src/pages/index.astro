  <!-- ============================================================
       HOW-TO TUTORIALS SECTION
       ============================================================ -->
  {recentHowTo.length > 0 && (
    <section class="container" style="margin-block-start: var(--space-2xl);">
      <h2 class="section-heading">تازہ ٹیوٹوریلز</h2>
      <div class="post-grid">
