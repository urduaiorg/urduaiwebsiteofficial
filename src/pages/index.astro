---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => {
    const aPublishedAt = a.data.published_at ?? `${a.data.date}T00:00:00Z`;
    const bPublishedAt = b.data.published_at ?? `${b.data.date}T00:00:00Z`;
    const newestFirst = Date.parse(bPublishedAt) - Date.parse(aPublishedAt);

    // Exact publication time decides the homepage order. The ID fallback
    // keeps legacy same-date posts deterministic when they have no timestamp.
    return newestFirst || b.id.localeCompare(a.id);
  });

const featuredPost = recentPosts[0];
const morePosts = recentPosts.slice(1, 7);

const formatUrduDate = (date: string) => {
  const [year, month, day] = date.split('-').map(Number);
  return new Date(year, month - 1, day).toLocaleDateString('ur-PK', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const recentGuides = allGuides
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const allHowTo = await getCollection('howto', ({ data }) => !data.draft);
const recentHowTo = allHowTo
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const allPrompts = await getCollection('prompts', ({ data }) => !data.draft);
const recentPrompts = allPrompts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
