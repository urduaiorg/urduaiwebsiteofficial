---
import Base from '../../layouts/Base.astro';

export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Advertise with Urdu Ai — Pakistan's Largest Urdu AI Community"
  description="Reach 1M+ Urdu-speaking AI enthusiasts through Urdu Ai. Newsletter sponsorship, sponsored articles, and display advertising on urduai.org."
  canonical="https://urduai.org/advertise/"
  adsense={false}
>
  <!-- Hero -->
  <section class="adv-hero">
    <div class="container" style="text-align:center;">
      <p class="adv-hero__eyebrow">Sponsorship &amp; Advertising</p>
      <h1 class="adv-hero__title" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Reach the Largest Urdu-Speaking<br/>AI Audience in the World</h1>
      <p class="adv-hero__sub" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
        Urdu Ai is the leading AI literacy platform for 250M+ Urdu speakers worldwide.
        We help technology brands, education platforms, and digital services connect with
        a highly engaged, mobile-first audience across Pakistan, India, the Gulf, and the global diaspora.
        Operated by WALI PVT Limited, Pakistan.
      </p>
      <a href="mailto:ai@urduai.org" class="btn-playstore" dir="ltr" style="font-size:1.1rem; padding:0.7em 2.5em; font-family: system-ui, -apple-system, sans-serif;">
        Get in Touch
      </a>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="adv-stats">
    <div class="container">
      <div class="adv-stats__grid">
        <div class="adv-stat">
          <span class="adv-stat__number" dir="ltr">42,000+</span>
          <span class="adv-stat__label" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Newsletter Subscribers</span>
          <span class="adv-stat__note" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Weekly email delivery</span>
        </div>
        <div class="adv-stat">
          <span class="adv-stat__number" dir="ltr">1,000,000+</span>
          <span class="adv-stat__label" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Online Community</span>
          <span class="adv-stat__note" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Facebook, Instagram, X, TikTok</span>
        </div>
        <div class="adv-stat">
          <span class="adv-stat__number" dir="ltr">50,000+</span>
          <span class="adv-stat__label" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">App Downloads</span>
          <span class="adv-stat__note" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Google Play Store</span>
        </div>
        <div class="adv-stat">
          <span class="adv-stat__number" dir="ltr">250M+</span>
          <span class="adv-stat__label" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Urdu Speakers Worldwide</span>
          <span class="adv-stat__note" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Pakistan, India, Diaspora</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="container adv-credentials">
    <h2 class="section-heading" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Trust &amp; Recognition</h2>
    <div class="adv-credentials__grid">
      <div class="adv-credential">
        <div class="adv-credential__logo" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="48" height="48" rx="10" fill="#f97316" fill-opacity="0.1"/>
            <path d="M16 32V16M20 32V20M24 32V24M28 32V20M32 32V16" stroke="#f97316" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">ElevenLabs</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Official Case Study</p>
      </div>
      <div class="adv-credential">
        <div class="adv-credential__logo" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="48" height="48" rx="10" fill="#4285f4" fill-opacity="0.1"/>
            <circle cx="24" cy="24" r="10" stroke="#4285f4" stroke-width="2"/>
            <path d="M24 14v10l6 3" stroke="#f1cc11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Google.org</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Grant Partner</p>
      </div>
      <div class="adv-credential">
        <div class="adv-credential__logo" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="48" height="48" rx="10" fill="#0e6b5e" fill-opacity="0.1"/>
            <circle cx="24" cy="24" r="10" stroke="#0e6b5e" stroke-width="2"/>
            <path d="M14 24h20M24 14a10 10 0 010 20M24 14a10 10 0 000 20" stroke="#0e6b5e" stroke-width="1.5"/>
          </svg>
        </div>
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Internet Society</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Partner Organization</p>
      </div>
    </div>
  </section>

  <!-- Audience profile -->
  <section class="adv-audience">
    <div class="container">
      <h2 class="section-heading" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Who Is Our Audience?</h2>
      <div class="adv-audience__grid">
        <div class="adv-audience__item">
          <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Geography</strong>
          <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Pakistan (primary), India, United Kingdom, United States, Canada, Gulf countries (UAE, Saudi Arabia)</p>
        </div>
        <div class="adv-audience__item">
          <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Interests</strong>
          <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Artificial intelligence, technology, education, freelancing, digital business, career development</p>
        </div>
        <div class="adv-audience__item">
          <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Demographics</strong>
          <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Ages 18-45 -- educated, digitally active, Urdu-speaking professionals and students</p>
        </div>
        <div class="adv-audience__item">
          <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Devices</strong>
          <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">70%+ mobile users on Android and iOS. Mobile-first content consumption.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="container adv-packages">
    <h2 class="section-heading" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Sponsorship Packages</h2>
    <div class="adv-packages__grid">

      <div class="adv-package adv-package--featured">
        <div class="adv-package__badge" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Most Popular</div>
        <div class="adv-package__icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#f1cc11" fill-opacity="0.2"/>
            <rect x="8" y="14" width="24" height="16" rx="3" stroke="#1d559f" stroke-width="2"/>
            <path d="M8 20l12 7 12-7" stroke="#1d559f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Newsletter Sponsorship</h3>
        <p class="adv-package__reach" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">42,000+ subscribers per send</p>
        <ul dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          <li>Dedicated sponsor block in one newsletter edition</li>
          <li>Your logo + bilingual copy (Urdu/English) + link</li>
          <li>42,000+ inbox delivery with high open rates</li>
          <li>Post-campaign click and engagement report</li>
        </ul>
        <p class="adv-package__fit" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Best for: EdTech, SaaS, AI tools, FinTech, brands targeting Pakistan</p>
        <a href="mailto:ai@urduai.org?subject=Newsletter Sponsorship Inquiry" class="btn-playstore adv-package__cta" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          Get Pricing
        </a>
      </div>

      <div class="adv-package">
        <div class="adv-package__icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1d559f" fill-opacity="0.1"/>
            <rect x="8" y="10" width="24" height="20" rx="3" stroke="#1d559f" stroke-width="2"/>
            <path d="M12 18h16M12 22h10" stroke="#f1cc11" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Sponsored Article</h3>
        <p class="adv-package__reach" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Permanent SEO + 1M+ social reach</p>
        <ul dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          <li>Full-length article about your brand in Urdu</li>
          <li>Permanent page on urduai.org with SEO value</li>
          <li>Shared across 1M+ social media community</li>
          <li>Long-term Google visibility for your brand in Urdu search</li>
        </ul>
        <p class="adv-package__fit" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Best for: Product launches, apps, courses, services entering Pakistan market</p>
        <a href="mailto:ai@urduai.org?subject=Sponsored Article Inquiry" class="btn-playstore adv-package__cta" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          Get Pricing
        </a>
      </div>

      <div class="adv-package">
        <div class="adv-package__icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#f1cc11" fill-opacity="0.12"/>
            <rect x="8" y="12" width="24" height="16" rx="3" stroke="#1d559f" stroke-width="2"/>
            <circle cx="20" cy="20" r="4" fill="#f1cc11"/>
            <path d="M20 16v8M16 20h8" stroke="#1d559f" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Website Banner</h3>
        <p class="adv-package__reach" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">High-traffic pages -- blog + homepage</p>
        <ul dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          <li>Banner placement on homepage and blog pages</li>
          <li>Sidebar visibility across 655+ article pages</li>
          <li>Mobile and desktop responsive display</li>
          <li>Monthly impression and click report</li>
        </ul>
        <p class="adv-package__fit" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Best for: Brand awareness, recruitment, local business, app installs</p>
        <a href="mailto:ai@urduai.org?subject=Banner Advertising Inquiry" class="btn-playstore adv-package__cta" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
          Get Pricing
        </a>
      </div>

    </div>
  </section>

  <!-- Why Urdu Ai -->
  <section class="container adv-why" style="margin-block-end: var(--space-2xl);">
    <h2 class="section-heading" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Why Advertise with Urdu Ai?</h2>
    <div class="adv-audience__grid">
      <div class="adv-audience__item">
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Untapped Market</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">250M+ Urdu speakers are underserved by English-only AI platforms. Urdu Ai is the only credible bridge.</p>
      </div>
      <div class="adv-audience__item">
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Institutional Credibility</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Backed by S&amp;P Global, Google.org, Internet Society, AVPN. Featured as an ElevenLabs case study.</p>
      </div>
      <div class="adv-audience__item">
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Engaged Community</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Not vanity metrics. Our 1M+ community actively reads, shares, and discusses AI content daily.</p>
      </div>
      <div class="adv-audience__item">
        <strong dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Full-Funnel Options</strong>
        <p dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">From awareness (banners) to consideration (articles) to direct response (newsletter). All in one platform.</p>
      </div>
    </div>
  </section>

  <!-- CTA strip -->
  <section class="adv-cta">
    <div class="container adv-cta__inner">
      <p class="adv-cta__eyebrow" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Get Started</p>
      <h2 class="adv-cta__title" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Ready to Reach the Urdu-Speaking World?</h2>
      <p class="adv-cta__copy" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">
        Tell us about your brand and goals. We will respond within 48 hours
        with audience fit analysis, placement options, and pricing.
      </p>
      <p class="adv-cta__note" dir="ltr" style="font-family: system-ui, -apple-system, sans-serif;">Urdu Ai is a product of WALI PVT Limited, Pakistan.</p>
      <a href="mailto:ai@urduai.org" class="btn-playstore" dir="ltr" style="font-size:1.1rem; padding:0.7em 2.5em; font-family: system-ui, -apple-system, sans-serif;">
        ai@urduai.org
      </a>
    </div>
  </section>

</Base>

<style>
  /* Hero */
  .adv-hero {
    background: var(--ink);
    padding-block: var(--space-2xl);
    margin-block-end: 0;
  }
  .adv-hero__eyebrow {
    color: var(--gold);
    font-size: var(--text-sm);
    letter-spacing: 0;
    margin-block-end: var(--space-xs);
  }
  .adv-hero__title {
    font-size: var(--text-h1);
    color: white;
    line-height: 1.3;
    margin-block-end: var(--space-md);
  }
  .adv-hero__sub {
    color: var(--gold-pale);
    max-width: 640px;
    margin-inline: auto;
    margin-block-end: var(--space-lg);
    line-height: 1.7;
  }

  /* Stats bar */
  .adv-stats {
    background: var(--navy, #1d559f);
    padding-block: var(--space-xl);
    margin-block-end: var(--space-2xl);
  }
  .adv-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-lg);
    text-align: center;
  }
  .adv-stat__number {
    display: block;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
    margin-block-end: 0.2em;
  }
  .adv-stat__label {
    display: block;
    color: white;
    font-size: var(--text-base);
    margin-block-end: 0.2em;
  }
  .adv-stat__note {
    display: block;
    color: var(--gold-pale);
    font-size: var(--text-sm);
  }

  /* Credentials */
  .adv-credentials {
    margin-block-end: var(--space-2xl);
  }
  .adv-credentials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
  }
  .adv-credential {
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }
  .adv-credential strong {
    color: var(--ink);
    font-size: var(--text-base);
  }
  .adv-credential p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  /* Audience */
  .adv-audience {
    background: var(--paper-warm);
    padding-block: var(--space-2xl);
    margin-block-end: var(--space-2xl);
  }
  .adv-audience__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }
  .adv-audience__item {
    background: var(--paper-card);
    border-radius: 8px;
    padding: var(--space-md);
    border: 1px solid var(--border);
  }
  .adv-audience__item strong {
    display: block;
    color: var(--navy, #1d559f);
    margin-block-end: var(--space-xs);
  }
  .adv-audience__item p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.7;
  }

  /* Packages */
  .adv-packages {
    margin-block-end: var(--space-2xl);
  }
  .adv-packages__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
    align-items: start;
  }
  .adv-package {
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: var(--space-lg);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .adv-package--featured {
    border-color: var(--gold);
    box-shadow: 0 4px 24px rgba(241, 204, 17, 0.15);
  }
  .adv-package__badge {
    position: absolute;
    top: -0.7em;
    inset-inline-start: var(--space-md);
    background: var(--gold);
    color: var(--ink);
    font-size: var(--text-sm);
    padding: 0.15em 0.8em;
    border-radius: 20px;
    font-weight: 700;
  }
  .adv-package h3 {
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0;
  }
  .adv-package__reach {
    color: var(--navy, #1d559f);
    font-size: var(--text-sm);
    margin: 0;
  }
  .adv-package ul {
    padding-inline-start: 1.2em;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
  }
  .adv-package__fit {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
    font-style: italic;
  }
  .adv-package__cta {
    border: none;
    cursor: pointer;
    text-align: center;
    margin-block-start: var(--space-xs);
  }

  /* Bottom CTA */
  .adv-cta {
    background: var(--ink);
    padding-block: var(--space-2xl);
  }
  .adv-cta__inner {
    text-align: center;
  }
  .adv-cta__eyebrow {
    color: var(--gold);
    margin-block-end: var(--space-xs);
  }
  .adv-cta__title {
    color: var(--gold-light);
    margin-block-end: var(--space-sm);
    line-height: 1.3;
  }
  .adv-cta__copy {
    color: var(--gold-pale);
    max-width: 650px;
    margin-inline: auto;
    margin-block-end: var(--space-md);
    line-height: 1.7;
  }
  .adv-cta__note {
    color: rgba(253, 244, 216, 0.85);
    font-size: var(--text-sm);
    margin-block-end: var(--space-lg);
  }
</style>
