---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('learn', ({ data }) => !data.draft);
  return entries.map(e => ({
    params: { slug: e.id },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = `https://urduai.org/learn/${entry.id}/`;

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": entry.data.title,
  "description": entry.data.description,
  "inDefinedTermSet": "https://urduai.org/learn/",
  "termCode": entry.data.term_english,
  "url": canonical,
  "inLanguage": "ur",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "اردو اے آئی لغت", "item": "https://urduai.org/learn/" },
    { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": canonical },
  ],
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  adsense={entry.data.adsense}
  schema={[definedTermSchema, breadcrumbSchema]}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/learn/`}>اردو اے آئی لغت</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <article class="container--narrow" style="margin-block-start: var(--space-md);">
      <span class="badge">{entry.data.term_english}</span>
      <h1 style="margin-block-start: var(--space-xs);">{entry.data.title}</h1>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>
