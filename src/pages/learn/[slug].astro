---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('learn', ({ data }) => !data.draft);
  return entries.map(e => ({
    params: { slug: e.id },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = `https://urduai.org/learn/${entry.id}/`;

// Related terms — 4 random terms from the same collection, excluding current
const allTerms = await getCollection('learn', ({ data }) => !data.draft);
const otherTerms = allTerms.filter(t => t.id !== entry.id);
const relatedTerms = otherTerms.sort(() => Math.random() - 0.5).slice(0, 4);

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": entry.data.title,
  "description": entry.data.description,
  "inDefinedTermSet": "https://urduai.org/learn/",
  "termCode": entry.data.term_english,
  "url": canonical,
  "inLanguage": "ur",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "اردو اے آئی لغت", "item": "https://urduai.org/learn/" },
    { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": canonical },
  ],
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  adsense={entry.data.adsense}
  schema={[definedTermSchema, breadcrumbSchema]}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/learn/`}>اردو اے آئی لغت</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <article class="container--narrow" style="margin-block-start: var(--space-md);">
      <span class="badge">{entry.data.term_english}</span>
      <h1 style="margin-block-start: var(--space-xs);">{entry.data.title}</h1>

      <div class="prose">
        <Content />
      </div>
    </article>

    <!-- Related Terms -->
    {relatedTerms.length > 0 && (
      <section class="container--narrow" style="margin-block-start: var(--space-2xl); border-block-start: 2px solid var(--border); padding-block-start: var(--space-lg);">
        <h2 style="font-size: 1.4rem;">مزید اصطلاحات سیکھیں</h2>
        <div class="related-terms-grid">
          {relatedTerms.map(term => (
            <a href={`${base}/learn/${term.id}/`} class="related-term-card">
              <span class="related-term-card__english">{term.data.term_english}</span>
              <span class="related-term-card__title">{term.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Newsletter + WhatsApp + App CTA -->
    <section class="container--narrow" style="margin-block-start: var(--space-xl); background: var(--ink); color: var(--paper); padding: var(--space-lg); border-radius: 12px; text-align: center;">
      <h2 style="color: var(--gold-light); font-size: 1.3rem; margin-block-end: var(--space-xs);">اردو اے آئی سے جڑے رہیں</h2>
      <div style="display:flex; justify-content:center; gap:var(--space-sm); flex-wrap:wrap; margin-block-start:var(--space-md);">
        <a
          href="https://www.urduaiupdates.com/subscribe"
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-flex; align-items:center; gap:0.4em; background:var(--navy); color:#fff; padding:0.6em 1.2em; border-radius:8px; font-weight:600; text-decoration:none; font-size:0.9rem;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          نیوز لیٹر سبسکرائب کریں
        </a>
        <a
          href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D"
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-flex; align-items:center; gap:0.4em; background:#25D366; color:#fff; padding:0.6em 1.2em; border-radius:8px; font-weight:600; text-decoration:none; font-size:0.9rem;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          واٹس ایپ چینل جوائن کریں
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=org.urduai.app"
          target="_blank"
          rel="noopener"
          style="display:inline-flex; align-items:center; gap:0.4em; background:var(--gold); color:var(--ink); padding:0.6em 1.2em; border-radius:8px; font-weight:600; text-decoration:none; font-size:0.9rem;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 13l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/></svg>
          ایپ ڈاؤن لوڈ کریں
        </a>
      </div>
    </section>

    <!-- App CTA -->
    <section class="container--narrow" style="margin-block-start: var(--space-lg); margin-block-end: var(--space-xl); text-align: center; padding: var(--space-md); background: var(--paper-warm); border-radius: 12px; border: 1px solid var(--border);">
      <p style="font-size: 1rem; margin-block-end: var(--space-sm);">
        اردو اے آئی لغت اور ہزاروں مضامین ایک ایپ میں پڑھیں
      </p>
      <a href="https://play.google.com/store/apps/details?id=com.yourname.urduaiwebwrapperfixed&hl=en-US" target="_blank" rel="noopener" class="btn-playstore" style="display:inline-flex;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-inline-end:6px;"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 13l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/></svg>
        مفت ڈاؤن لوڈ کریں
      </a>
    </section>
  </div>
</Base>
