---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const all = await getCollection('learn', ({ data }) => !data.draft);
const priorityOrder = [
  'artificial-intelligence',
  'google-gemini',
  'claude-ai',
  'generative-ai',
  'machine-learning',
  'large-language-model',
  'prompt-engineering',
  'ai-agent',
  'hallucination',
];

const prioritySet = new Set(priorityOrder);
const byTitle = (a, b) => a.data.title.localeCompare(b.data.title, 'ur');
const beginnerEntries = priorityOrder
  .map((id) => all.find((entry) => entry.id === id))
  .filter(Boolean);
const deeperEntries = all
  .filter((entry) => !prioritySet.has(entry.id))
  .sort(byTitle);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqItems = [
  {
    question: 'AI glossary in Urdu کہاں سے شروع کریں؟',
    answer: 'اگر آپ beginner ہیں تو پہلے مصنوعی ذہانت، مشین لرننگ، لارج لینگویج ماڈل، Gemini اور prompt engineering کی اصطلاحات پڑھیں۔ یہی AI سمجھنے کی بنیادی زبان ہے۔',
  },
  {
    question: 'AI terms in Urdu کیوں ضروری ہیں؟',
    answer: 'AI tools استعمال کرتے وقت prompt، model، token، hallucination، AGI اور machine learning جیسے لفظ بار بار آتے ہیں۔ ان کا آسان مطلب معلوم ہو تو tool کا جواب بہتر سمجھ آتا ہے۔',
  },
  {
    question: 'مصنوعی ذہانت اور machine learning میں کیا فرق ہے؟',
    answer: 'مصنوعی ذہانت بڑا نام ہے۔ Machine learning اس کی ایک شاخ ہے جس میں computer data سے pattern سیکھتا ہے اور prediction یا decision بناتا ہے۔',
  },
  {
    question: 'Prompt engineering پہلے سیکھیں یا AI basics؟',
    answer: 'پہلے AI basics اور large language model سمجھیں، پھر prompt engineering سیکھیں۔ اس ترتیب سے ChatGPT، Gemini اور Claude سے بہتر جواب لینا آسان ہو جاتا ہے۔',
  },
  {
    question: 'AI hallucination کیا ہے؟',
    answer: 'AI hallucination وہ حالت ہے جب AI اعتماد سے غلط بات لکھ دیتا ہے۔ اسی لیے خبر، صحت، قانون، پیسے یا حساس معلومات میں AI جواب کو خود بھی verify کرنا ضروری ہے۔',
  },
  {
    question: 'AI glossary پڑھنے کے بعد practical step کیا ہے؟',
    answer: 'پہلے AI meaning، LLM، prompt engineering اور hallucination سمجھیں۔ اس کے بعد Masterclass lesson 1 یا free AI course Urdu guide کھولیں اور Gemini یا ChatGPT میں ایک چھوٹا Urdu prompt آزما کر practice شروع کریں۔',
  },
];

const learnSchema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "AI terms in Urdu glossary",
    "description": "مصنوعی ذہانت، machine learning، LLM، prompt engineering، AGI، Gemini اور AI safety terms آسان اردو میں سیکھیں۔",
    "url": "https://urduai.org/learn/",
    "inLanguage": "ur",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Beginner AI terms in Urdu",
    "itemListElement": beginnerEntries.map((entry, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": entry.data.title,
      "url": `https://urduai.org/learn/${entry.id}/`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      "name": question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": answer,
      },
    })),
  },
];
---

<Base
  title="AI terms in Urdu: AI glossary اور آسان definitions"
  description="AI glossary in Urdu: مصنوعی ذہانت، machine learning، LLM، prompt engineering، AGI، Gemini اور AI safety terms آسان اردو میں سیکھیں۔"
  canonical="https://urduai.org/learn/"
  adsense={true}
  schema={learnSchema}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li aria-current="page">اردو اے آئی لغت</li>
      </ol>
    </nav>

    <h1>اردو اے آئی لغت</h1>
    <p class="text-muted learn-intro">
      AI glossary in Urdu کا مقصد یہ ہے کہ مصنوعی ذہانت، machine learning، LLM، prompt engineering، AGI، Gemini اور AI safety جیسے مشکل الفاظ عام پاکستانی learner کے لیے آسان ہو جائیں۔ پہلے بنیادی terms پڑھیں، پھر practical tools استعمال کریں۔
    </p>

    <section class="learn-answer" aria-labelledby="learn-answer-title">
      <h2 id="learn-answer-title">فوری جواب: پہلے کون سی اصطلاحات پڑھیں؟</h2>
      <p>
        اگر آپ AI بالکل پہلی بار سیکھ رہے ہیں تو <a href={`${base}/learn/artificial-intelligence/`}>مصنوعی ذہانت</a>، <a href={`${base}/learn/machine-learning/`}>مشین لرننگ</a>، <a href={`${base}/learn/large-language-model/`}>لارج لینگویج ماڈل</a>، <a href={`${base}/learn/prompt-engineering/`}>prompt engineering</a> اور <a href={`${base}/learn/hallucination/`}>AI hallucination</a> سے شروع کریں۔
        اس کے بعد <a href={`${base}/courses/masterclass/1/`}>Masterclass lesson 1</a> یا <a href={`${base}/guides/free-ai-course-urdu/`}>free AI course Urdu guide</a> کھول کر practice کریں۔
      </p>
    </section>

    <section class="learn-path" aria-labelledby="learn-path-title">
      <h2 id="learn-path-title">Beginner learning path</h2>
      <div class="learn-path__links">
        <a href={`${base}/learn/artificial-intelligence/`}>AI meaning in Urdu</a>
        <a href={`${base}/guides/ai-kya-hai-urdu-ai-master-class-1/`}>AI beginner guide</a>
        <a href={`${base}/courses/masterclass/1/`}>Masterclass lesson 1</a>
        <a href={`${base}/guides/free-ai-course-urdu/`}>Free AI course Urdu</a>
        <a href={`${base}/learn/google-gemini/`}>Gemini کیا ہے؟</a>
        <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini استعمال کریں</a>
        <a href={`${base}/learn/prompt-engineering/`}>Prompt engineering</a>
        <a href={`${base}/tools/`}>AI tools directory</a>
      </div>
    </section>

    <section class="learn-clusters" aria-labelledby="learn-clusters-title">
      <h2 id="learn-clusters-title">اپنی ضرورت کے مطابق اصطلاحات چنیں</h2>
      <div class="learn-clusters__grid">
        <article>
          <h3>AI basics</h3>
          <p>AI، machine learning، deep learning اور neural networks کی بنیاد۔</p>
          <a href={`${base}/learn/artificial-intelligence/`}>مصنوعی ذہانت سے شروع کریں</a>
        </article>
        <article>
          <h3>ChatGPT، Gemini اور Claude</h3>
          <p>LLM، Gemini، Claude، token اور prompt engineering کو آسان مثالوں سے سمجھیں۔</p>
          <a href={`${base}/learn/large-language-model/`}>LLM کیا ہے؟</a>
        </article>
        <article>
          <h3>Safety اور غلط جواب</h3>
          <p>Hallucination، training data، bias اور verification کی بنیادی سمجھ۔</p>
          <a href={`${base}/learn/hallucination/`}>AI hallucination پڑھیں</a>
        </article>
        <article>
          <h3>Advanced AI</h3>
          <p>AGI، AI agents، RAG، fine-tuning، transformer اور embeddings کی اگلی سطح۔</p>
          <a href={`${base}/learn/artificial-general-intelligence/`}>AGI meaning in Urdu</a>
        </article>
      </div>
    </section>

    <section style="margin-block-end: var(--space-xl);">
      <h2 class="section-heading" style="font-size:1.35rem;">پہلے یہ اصطلاحات سمجھیں</h2>
      <p class="text-muted" style="text-align:center; max-width:48rem; margin:0 auto var(--space-md);">
        اگر آپ ابھی AI سیکھنا شروع کر رہے ہیں تو یہی چند بنیادی اصطلاحات پہلے سمجھنا کافی ہیں۔
      </p>
      <div class="post-grid">
        {beginnerEntries.map(e => (
          <article class="card">
            <p class="card__meta">
              <span class="badge">{e.data.term_english}</span>
            </p>
            <h2 class="card__title"><a href={`${base}/learn/${e.id}/`}>{e.data.title}</a></h2>
            <p class="card__excerpt">{e.data.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section style="margin-block-end: var(--space-xl);">
      <h2 class="section-heading" style="font-size:1.35rem;">اب ذرا گہرائی میں جائیں</h2>
      <p class="text-muted" style="text-align:center; max-width:48rem; margin:0 auto var(--space-md);">
        جب بنیادی اصطلاحات واضح ہو جائیں تو ان مزید تصورات کو پڑھ کر اپنی سمجھ مضبوط کریں۔
      </p>
      <div class="post-grid">
        {deeperEntries.map(e => (
          <article class="card">
            <p class="card__meta">
              <span class="badge">{e.data.term_english}</span>
            </p>
            <h2 class="card__title"><a href={`${base}/learn/${e.id}/`}>{e.data.title}</a></h2>
            <p class="card__excerpt">{e.data.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="learn-faq" aria-labelledby="learn-faq-title">
      <h2 id="learn-faq-title">اکثر پوچھے گئے سوالات</h2>
      {faqItems.map((item) => (
        <div class="learn-faq__item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </div>
      ))}
    </section>
  </div>

  <style>
    .learn-intro {
      max-width: 820px;
      margin-block-end: var(--space-lg);
      line-height: var(--lh-prose);
    }

    .learn-answer,
    .learn-path,
    .learn-clusters,
    .learn-faq {
      margin-block-end: var(--space-lg);
    }

    .learn-answer {
      max-width: 860px;
      border-block-start: 1px solid var(--border);
      padding-block-start: var(--space-md);
    }

    .learn-answer h2,
    .learn-path h2,
    .learn-clusters h2,
    .learn-faq h2 {
      font-size: 1.35rem;
      line-height: var(--lh-heading);
      margin-block-end: var(--space-xs);
    }

    .learn-answer p {
      line-height: var(--lh-prose);
      margin: 0;
    }

    .learn-path {
      border-block: 1px solid var(--border);
      padding-block: var(--space-md);
    }

    .learn-path__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .learn-path__links a {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.45em 0.9em;
      background: var(--paper-card);
      color: var(--teal);
      text-decoration: none;
      font-size: var(--text-sm);
    }

    .learn-path__links a:hover {
      border-color: var(--teal);
    }

    .learn-clusters__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-sm);
    }

    .learn-clusters__grid article {
      border-block-start: 3px solid var(--teal);
      background: var(--paper-warm);
      padding: var(--space-sm);
      border-radius: 8px;
    }

    .learn-clusters__grid h3,
    .learn-faq__item h3 {
      font-size: 1.08rem;
      line-height: var(--lh-heading);
      margin-block-end: 0.35em;
    }

    .learn-clusters__grid p,
    .learn-faq__item p {
      font-size: var(--text-sm);
      line-height: var(--lh-prose);
      margin-block-end: 0.45em;
    }

    .learn-faq {
      border-block-start: 1px solid var(--border);
      padding-block-start: var(--space-md);
      max-width: 860px;
    }

    .learn-faq__item {
      border-block-end: 1px solid var(--border);
      padding-block: var(--space-xs);
    }
  </style>
</Base>
