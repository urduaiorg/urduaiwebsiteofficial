---
import Base from '../../layouts/Base.astro';

export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="ٹیم — اردو اے آئی | قیصر رونجھا اور WALI"
  description="اردو اے آئی کی ٹیم — بانی قیصر رونجھا اور Wang Lab of Innovation (WALI) کے تحت پاکستان میں اردو زبان میں اے آئی خواندگی کا مشن۔"
  canonical="https://urduai.org/team/"
  adsense={false}
>
  <div class="container" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">ٹیم</li></ol>
    </nav>

    <h1>ہماری ٹیم</h1>
    <p class="text-muted" style="margin-block-end:var(--space-xl);">
      اردو اے آئی — <strong>Wang Lab of Innovation (WALI)</strong> کی ایک پروڈکٹ
    </p>

    <!-- WALI section -->
    <div class="team-card team-card--founder">
      <div class="team-card__info" style="width:100%;">
        <h2 class="team-card__name" dir="ltr" style="font-family:'Inter',sans-serif;">Wang Lab of Innovation (WALI)</h2>
        <p class="team-card__role">پاکستان میں ٹیکنالوجی، جدت اور مقامی زبانوں میں علم کی رسائی</p>

        <div class="prose" style="margin-block-start:var(--space-md);">
          <p>
            اردو اے آئی <strong>Wang Lab of Innovation (WALI)</strong> کی ایک پروڈکٹ ہے۔
            WALI پاکستان میں رجسٹرڈ ادارہ ہے جو ٹیکنالوجی اور مقامی زبانوں میں علم کی رسائی کے لیے کام کرتا ہے۔
            اردو اے آئی اس کا مرکزی عوامی پلیٹ فارم ہے جو ۲۵ کروڑ اردو بولنے والوں کو اے آئی انقلاب سے جوڑ رہا ہے۔
          </p>
        </div>

        <div style="margin-block-start:var(--space-md);">
          <a href="https://www.walipak.com" target="_blank" rel="noopener noreferrer" class="team-link-btn">walipak.com پر مزید جانیں</a>
        </div>
      </div>
    </div>

    <!-- Internet Society Video -->
    <div style="margin-block-start:var(--space-2xl);">
      <h2>اردو اے آئی — Internet Society</h2>
      <p class="text-muted" style="margin-block-end:var(--space-md);">
        Internet Society کی ویڈیو میں دیکھیں کہ اردو اے آئی کیسے کام کرتا ہے
      </p>
      <div class="video-embed">
        <iframe
          src="https://www.youtube.com/embed/F0aSyRMBrLE"
          title="Urdu AI — Internet Society"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <!-- Urdu AI Impact Program -->
    <div style="margin-block-start:var(--space-2xl);">
      <h2>اردو اے آئی امپیکٹ پروگرام</h2>
      <div class="team-card" style="margin-block-start:var(--space-md);">
        <div class="team-card__info" style="width:100%;">
          <div class="impact-stat">
            <span class="impact-stat__number" dir="ltr">40,000+</span>
            <span class="impact-stat__label">افراد کی تربیت کمیونٹیز میں</span>
          </div>

          <div class="prose" style="margin-block-start:var(--space-md);">
            <p>
              اردو اے آئی امپیکٹ پروگرام کے تحت پاکستان بھر میں 40 ہزار سے زائد افراد کو کمیونٹیز میں AI کی تربیت دی جا رہی ہے۔
              یہ پروگرام <strong>AVPN</strong>، <strong>Google.org</strong> اور <strong>Asian Development Bank (ADB)</strong> کے تعاون سے چل رہا ہے۔
            </p>
          </div>

          <div style="display:flex; gap:var(--space-xs); flex-wrap:wrap; margin-block:var(--space-md);">
            <span class="badge">AVPN</span>
            <span class="badge">Google.org</span>
            <span class="badge">ADB</span>
          </div>

          <a href="https://impact.urduai.org" target="_blank" rel="noopener noreferrer" class="team-link-btn">impact.urduai.org پر تفصیلات دیکھیں</a>
        </div>
      </div>
    </div>

    <!-- Join us -->
    <div class="prose" style="margin-block-start:var(--space-2xl);">
      <h2>ہمارے ساتھ کام کریں</h2>
      <p>
        کیا آپ اردو زبان میں اے آئی تعلیم کے مشن میں حصہ لینا چاہتے ہیں؟
        ہم مضمون نگاروں، مترجمین، ویڈیو بنانے والوں اور اردو AI کمیونٹی کے رضاکاروں کا خیرمقدم کرتے ہیں۔
      </p>
      <p>
        <a href={`${base}/contact/`}>رابطہ صفحہ</a> کے ذریعے ہم سے بات کریں۔
      </p>
    </div>
  </div>
</Base>

<style>
  .team-card {
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: var(--space-xl);
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .team-card--founder {
    border-color: var(--gold);
    box-shadow: 0 4px 24px rgba(241, 204, 17, 0.12);
  }

  .team-card__avatar { flex-shrink: 0; }

  .team-card__name {
    font-size: var(--text-h2);
    margin: 0 0 var(--space-xs);
    color: var(--ink);
  }

  .team-card__role {
    color: var(--navy);
    margin: 0 0 0.2em;
    font-size: var(--text-base);
  }

  .team-link-btn {
    display: inline-block;
    background: var(--navy);
    color: #fff;
    padding: 0.5em 1.4em;
    border-radius: 8px;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .team-link-btn:hover {
    opacity: 0.9;
    color: #fff;
  }

  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .impact-stat {
    text-align: center;
    margin-block-end: var(--space-sm);
  }

  .impact-stat__number {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1.2;
  }

  .impact-stat__label {
    font-size: var(--text-base);
    color: var(--ink-soft);
  }
</style>
