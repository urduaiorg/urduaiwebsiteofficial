---
import Base from '../../layouts/Base.astro';

export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const certSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "اردو اے آئی",
  "alternateName": "Urdu AI",
  "url": "https://urduai.org",
  "description": "اردو اے آئی پاکستانی learners کے لیے Google AI certificate، AI courses اور global learning scholarships کی رہنمائی اردو میں فراہم کرتا ہے۔",
  "areaServed": "PK",
  "availableLanguage": ["ur", "en"]
};

const faqItems = [
  {
    question: 'Google AI certificate scholarship کیا ہے؟',
    answer: 'یہ اردو اے آئی کمیونٹی کے ذریعے شیئر ہونے والا limited scholarship موقع ہے جس میں eligible learners کو Google AI Essentials یا اسی طرح کے AI certificate courses تک رسائی مل سکتی ہے۔ seats، timing اور course access ہر batch میں بدل سکتے ہیں۔',
  },
  {
    question: 'کیا Google AI certificate ہر وقت مفت ملتا ہے؟',
    answer: 'نہیں۔ Google اور Coursera پر قیمت، trial، region اور enrollment options بدل سکتے ہیں۔ اردو اے آئی جب scholarship seats دستیاب ہوں تو اپنی community، newsletter اور WhatsApp channel پر اطلاع دیتا ہے۔',
  },
  {
    question: 'Google AI Essentials میں کیا سکھایا جاتا ہے؟',
    answer: 'Google AI Essentials beginners کے لیے generative AI، prompting، responsible AI اور daily work میں AI tools کے استعمال کی بنیاد سمجھاتا ہے۔ Google کی آفیشل معلومات کے مطابق یہ self-paced course ہے اور completion پر certificate ملتا ہے۔',
  },
  {
    question: 'کیا یہ course beginners کے لیے مناسب ہے؟',
    answer: 'جی ہاں۔ اگر آپ طالب علم، teacher، freelancer یا small business owner ہیں اور AI شروع سے سیکھنا چاہتے ہیں تو پہلے Urdu AI Masterclass یا AI basics پڑھیں، پھر Google AI certificate جیسے course کی طرف جائیں۔',
  },
  {
    question: 'Scholarship apply کرنے کا بہترین طریقہ کیا ہے؟',
    answer: 'Urdu AI newsletter، WhatsApp channel اور Android app follow کریں۔ نیا batch کھلنے پر form یا instructions وہیں share ہوتے ہیں۔ اپنی Gmail ID، درست نام اور learning commitment پہلے سے تیار رکھیں۔',
  },
  {
    question: 'Certificate ملنے کے بعد کیا فائدہ ہے؟',
    answer: 'Certificate آپ کے CV، LinkedIn profile، freelance profile یا scholarship application میں AI learning کا ثبوت بن سکتا ہے، لیکن job guarantee نہیں ہے۔ اصل فائدہ course مکمل کر کے practical AI skills استعمال کرنے سے آتا ہے۔',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "Google AI certificate scholarships", "item": "https://urduai.org/certified/" },
  ],
};
---

<Base
  title="Google AI certificate scholarships — Urdu AI free courses"
  description="Google AI certificate scholarships، Urdu AI free courses، newsletter alerts اور beginner AI learning path ایک جگہ۔ seats limited ہوتی ہیں؛ batch کھلنے پر اطلاع ملتی ہے۔"
  canonical="https://urduai.org/certified/"
  adsense={true}
  schema={[certSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Hero -->
  <section style="background:var(--ink); padding-block:var(--space-2xl); margin-block-end:var(--space-2xl);">
    <div class="container" style="text-align:center;">
      <h1 style="color:white; margin-block-end:var(--space-sm);">Google AI certificate scholarships</h1>
      <p style="color:var(--gold-pale); max-width:650px; margin-inline:auto; line-height:var(--lh-prose);">
        Urdu AI beginners کے لیے Google AI certificate، مفت AI courses، scholarship alerts
        اور اردو learning path ایک جگہ
      </p>
    </div>
  </section>

  <div class="container" style="margin-block-end:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">Google AI certificate scholarships</li></ol>
    </nav>

    <!-- AEO first paragraph -->
    <div class="prose" style="margin-block-end:var(--space-2xl);">
      <p>
        <strong>Google AI certificate scholarships</strong> کے لیے اردو اے آئی پاکستانی beginners کو اردو میں رہنمائی، scholarship alerts اور <a href={`${base}/courses/`}>free Urdu AI courses</a> دیتا ہے۔ جب Google AI Essentials یا دوسرے عالمی AI certificate courses کی limited seats دستیاب ہوں، اردو اے آئی newsletter، WhatsApp channel اور <a href={`${base}/app/`}>Android app</a> پر واضح instructions شیئر کرتا ہے۔
      </p>
    </div>

    <!-- Impact stats -->
    <div class="cert-stats">
      <div class="cert-stat">
        <span class="cert-stat__number" dir="ltr">1000+</span>
        <span class="cert-stat__label">مفت اسکالرشپس تقسیم</span>
      </div>
      <div class="cert-stat">
        <span class="cert-stat__number" dir="ltr">40K+</span>
        <span class="cert-stat__label">کمیونٹی میں تربیت</span>
      </div>
      <div class="cert-stat">
        <span class="cert-stat__number" dir="ltr">10+</span>
        <span class="cert-stat__label">عالمی ادارے</span>
      </div>
    </div>

    <!-- How it works -->
    <h2>Scholarship ملنے کا طریقہ کیا ہے؟</h2>
    <div class="prose" style="margin-block-end:var(--space-xl);">
      <p>
        اردو اے آئی ہر وقت open enrollment کا وعدہ نہیں کرتا۔ درست طریقہ یہ ہے کہ پہلے community میں شامل ہوں، پھر جب scholarship batch کھلے تو اسی وقت apply کریں۔ seats محدود ہو سکتی ہیں، اس لیے نام، Gmail ID اور سیکھنے کا وقت پہلے سے تیار رکھیں۔
      </p>
      <ol>
        <li><strong>اردو اے آئی community join کریں</strong> — newsletter، WhatsApp channel یا app سے updates لیں</li>
        <li><strong>Batch announcement دیکھیں</strong> — form، deadline، eligibility اور course details پڑھیں</li>
        <li><strong>Course مکمل کریں</strong> — videos، assignments یا modules مکمل کر کے certificate حاصل کریں</li>
      </ol>
      <p>
        پہلے سے تیاری کے لیے <a href={`${base}/learn/artificial-intelligence/`}>AI کیا ہے؟</a> اور <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو میں کیسے استعمال کریں؟</a> پڑھ لیں۔
      </p>
    </div>

    <!-- Our courses -->
    <h2> پہلے کون سا Urdu AI course کریں؟</h2>
    <div class="cert-grid">
      <a href={`${base}/courses/masterclass/`} class="cert-card" style="text-decoration:none; color:inherit;">
        <h3 class="cert-card__title">اے آئی ماسٹرکلاس</h3>
        <p class="cert-card__desc">AI basics، prompts، tools اور beginner confidence کے لیے پہلا قدم</p>
        <span class="badge">مفت</span>
      </a>
      <a href={`${base}/courses/automation/`} class="cert-card" style="text-decoration:none; color:inherit;">
        <h3 class="cert-card__title">اے آئی آٹومیشن</h3>
        <p class="cert-card__desc">Google Forms، Sheets، email اور reports جیسے کام automate کرنا سمجھیں</p>
        <span class="badge">مفت</span>
      </a>
      <a href={`${base}/courses/champs/`} class="cert-card" style="text-decoration:none; color:inherit;">
        <h3 class="cert-card__title">اے آئی چیمپس</h3>
        <p class="cert-card__desc">Young learners اور families کے لیے AI کو آسان، محفوظ انداز میں شروع کریں</p>
        <span class="badge">مفت</span>
      </a>
    </div>

    <!-- External scholarships -->
    <h2>Google AI Essentials certificate میں کیا ہوتا ہے؟</h2>
    <div class="prose" style="margin-block-end:var(--space-xl);">
      <p>
        Google کی آفیشل Grow with Google معلومات کے مطابق <a href="https://grow.google/ai-essentials/" target="_blank" rel="noopener noreferrer">Google AI Essentials</a> beginners کے لیے generative AI، prompting، responsible AI اور daily work میں AI tools کے استعمال کی training دیتا ہے۔ Course self-paced ہے، 5 modules پر مشتمل ہے، اور completion کے بعد Google certificate ملتا ہے۔
      </p>
      <p>
        اہم بات: Google یا Coursera کی pricing، trial اور country availability بدل سکتی ہے۔ اسی لیے اردو اے آئی scholarship announcement میں واضح کرتا ہے کہ کس batch میں کون سا course، کتنی seats اور کیا deadline ہے۔ Google کے دیگر programs دیکھنے کے لیے <a href="https://grow.google/certificates/" target="_blank" rel="noopener noreferrer">Google Career Certificates</a> کی آفیشل page بھی check کریں۔
      </p>
      <p>
        اردو اے آئی کی پچھلی Google scholarship story یہاں پڑھیں: <a href={`${base}/blog/google-ai-certified-specialist-scholarships/`}>گوگل کے سرٹیفکیٹ کے ساتھ کیریئر میں آگے بڑھنے کا موقع</a>۔
      </p>
    </div>

    <!-- Who is this for -->
    <h2>یہ کس کے لیے ہے؟</h2>
    <div class="prose" style="margin-block-end:var(--space-xl);">
      <ul>
        <li><strong>طلبہ</strong> — CV، internship یا scholarship application میں AI learning کا ثبوت شامل کریں</li>
        <li><strong>فری لانسرز</strong> — client communication، research، proposals اور delivery میں AI کو بہتر استعمال کریں</li>
        <li><strong>اساتذہ</strong> — lesson planning، quizzes اور student support کے لیے AI basics سمجھیں</li>
        <li><strong>چھوٹے کاروبار</strong> — marketing copy، customer replies اور simple reports میں AI کی مدد لیں</li>
        <li><strong>نئے learners</strong> — اگر English course مشکل لگتا ہے تو پہلے اردو میں بنیاد مضبوط کریں</li>
      </ul>
    </div>

    <h2>Apply کرنے سے پہلے کیا تیار رکھیں؟</h2>
    <div class="cert-grid cert-grid--two">
      <div class="cert-card">
        <h3 class="cert-card__title">Learning profile</h3>
        <p class="cert-card__desc">اپنا درست نام، Gmail ID، شہر، profession اور سیکھنے کا مقصد لکھ کر رکھیں۔ غلط email سے invitation ضائع ہو سکتا ہے۔</p>
      </div>
      <div class="cert-card">
        <h3 class="cert-card__title">Time commitment</h3>
        <p class="cert-card__desc">Certificate course صرف form بھرنے سے مکمل نہیں ہوتا۔ ہفتے میں کچھ گھنٹے videos، readings اور exercises کے لیے رکھیں۔</p>
      </div>
      <div class="cert-card">
        <h3 class="cert-card__title">AI basics</h3>
        <p class="cert-card__desc">اگر AI بالکل نیا ہے تو پہلے <a href={`${base}/courses/masterclass/`}>Urdu AI Masterclass</a> یا <a href={`${base}/learn/generative-ai/`}>Generative AI</a> کی وضاحت پڑھیں۔</p>
      </div>
      <div class="cert-card">
        <h3 class="cert-card__title">Proof of completion</h3>
        <p class="cert-card__desc">Course مکمل ہونے کے بعد certificate کو CV، LinkedIn یا freelance profile میں لگائیں، لیکن skills کو practical examples سے بھی ثابت کریں۔</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="cert-cta">
      <h2 style="color:var(--gold-light); margin-block-end:var(--space-xs);">ابھی جوائن کریں — مفت مواقع سے فائدہ اٹھائیں</h2>
      <p style="color:var(--gold-pale); margin-block-end:var(--space-md); line-height:var(--lh-body);">
        Newsletter، WhatsApp channel یا Android app سے scholarship batch کی اطلاع حاصل کریں
      </p>
      <div style="display:flex; gap:0.8rem; justify-content:center; flex-wrap:wrap;">
        <a
          href="https://www.urduaiupdates.com/subscribe"
          target="_blank"
          rel="noopener noreferrer"
          class="cert-btn cert-btn--primary"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          نیوز لیٹر سبسکرائب کریں
        </a>
        <a
          href={`${base}/app/`}
          class="cert-btn cert-btn--app"
        >
          Urdu AI app
        </a>
        <a
          href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D"
          target="_blank"
          rel="noopener noreferrer"
          class="cert-btn cert-btn--whatsapp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          واٹس ایپ چینل
        </a>
      </div>
    </div>

    <section class="cert-faq" aria-labelledby="cert-faq-title">
      <h2 id="cert-faq-title">Google AI certificate scholarships کے عام سوالات</h2>
      <div class="prose">
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Impact program reference -->
    <div class="prose" style="margin-block-start:var(--space-2xl);">
      <h2>اردو اے آئی امپیکٹ پروگرام</h2>
      <p>
        اسکالرشپس کے علاوہ، اردو اے آئی امپیکٹ پروگرام کے تحت پاکستان بھر میں <strong>40,000+ افراد</strong> کو کمیونٹیز میں AI کی تربیت دی جا رہی ہے۔ یہ پروگرام AVPN، Google.org اور Asian Development Bank کے تعاون سے چل رہا ہے۔
      </p>
      <p>
        <a href="https://impact.urduai.org" target="_blank" rel="noopener noreferrer">impact.urduai.org</a> پر تفصیلات دیکھیں۔
      </p>
    </div>

  </div>
</Base>

<style>
  .cert-stats {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-block-end: var(--space-2xl);
  }

  .cert-stat {
    text-align: center;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md) var(--space-lg);
  }

  .cert-stat__number {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1.2;
  }

  .cert-stat__label {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-block-end: var(--space-2xl);
  }

  .cert-grid--two {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 768px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }

  .cert-card {
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-md);
  }

  .cert-card__title {
    font-family: 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 var(--space-xs);
  }

  .cert-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: var(--lh-body);
    margin: 0 0 var(--space-xs);
  }

  .cert-cta {
    background: var(--ink);
    border-radius: 12px;
    padding: var(--space-xl);
    text-align: center;
    margin-block-end: var(--space-2xl);
  }

  .cert-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6em 1.4em;
    border-radius: 8px;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .cert-btn:hover { opacity: 0.9; }

  .cert-btn--primary {
    background: var(--gold);
    color: var(--ink);
  }

  .cert-btn--whatsapp {
    background: #25D366;
    color: #fff;
  }

  .cert-btn--app {
    background: var(--teal);
    color: #fff;
  }

  .cert-faq {
    margin-block: var(--space-2xl);
  }

  .cert-faq details {
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-sm) var(--space-md);
    margin-block-end: var(--space-sm);
  }

  .cert-faq summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
  }

  .cert-faq p {
    margin-block-end: 0;
  }
</style>
