---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="پرائیویسی پالیسی — اردو اے آئی"
  description="اردو اے آئی کی پرائیویسی پالیسی — ہم آپ کا ڈیٹا کیسے استعمال کرتے ہیں۔"
  canonical="https://urduai.org/privacy/"
  adsense={false}
>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">پرائیویسی پالیسی</li></ol>
    </nav>
    <h1>پرائیویسی پالیسی</h1>
    <div class="prose">
      <p class="text-muted">آخری اپڈیٹ: اپریل ۲۰۲۶</p>
      <h2>ہم کیا ڈیٹا جمع کرتے ہیں؟</h2>
      <p>اردو اے آئی Google Analytics 4 استعمال کرتا ہے جو آپ کے دورے کی عمومی معلومات جمع کرتا ہے۔ ہم آپ کا نام، ای میل یا ذاتی معلومات جمع نہیں کرتے جب تک آپ نیوز لیٹر سبسکرائب نہ کریں۔</p>
      <h2>Google AdSense</h2>
      <p>ہم Google AdSense استعمال کرتے ہیں جو آپ کی دلچسپیوں کی بنیاد پر اشتہار دکھا سکتا ہے۔ مزید معلومات: <a href="https://policies.google.com/privacy" rel="noopener" dir="ltr">Google Privacy Policy</a>۔</p>
      <h2>نیوز لیٹر</h2>
      <p>نیوز لیٹر Beehiiv کے ذریعے چلایا جاتا ہے۔ آپ کسی بھی وقت ان سبسکرائب کر سکتے ہیں۔</p>
      <h2>رابطہ</h2>
      <p>پرائیویسی سے متعلق سوالات کے لیے: <a href={`${base}/contact/`}>رابطہ کریں</a></p>
    </div>
  </div>
</Base>
