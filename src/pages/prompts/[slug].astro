---
import Article from '../../layouts/Article.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const prompts = await getCollection('prompts', ({ data }) => !data.draft);
  return prompts.map(p => ({
    params: { slug: p.id },
    props: { promptCollection: p },
  }));
}

const { promptCollection } = Astro.props;
const { Content } = await render(promptCollection);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Article
  title={promptCollection.data.title}
  description={promptCollection.data.description}
  date={promptCollection.data.date}
  category={promptCollection.data.category}
  image={promptCollection.data.image}
  adsense={promptCollection.data.adsense}
  slug={promptCollection.id}
  collection="prompts"
  tools={promptCollection.data.tools}
  faq={promptCollection.data.faq}
  last_updated={promptCollection.data.last_updated}
>
  <Content />
</Article>
