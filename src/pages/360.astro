---
import Base from '../layouts/Base.astro';

const title = 'ChatGPT 360° تصویر کو ویڈیو میں تبدیل کریں — Urdu Ai';
const description = 'ChatGPT کی نئی 360° تصویر جنریشن کو انٹرایکٹو 360 ویو اور MP4 ویڈیو میں تبدیل کریں — مکمل مفت، Urdu Ai واٹر مارک کے ساتھ۔';

// Cache-bust the viewer iframe on every build so clients always pick up
// the latest viewer.html (Hostinger serves static assets with a 7-day
// Cache-Control: public, max-age=604800).
const viewerVersion = new Date().toISOString().replace(/[:.TZ-]/g, '').slice(0, 12);

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "ChatGPT کی 360° تصویر کو ویڈیو میں کیسے تبدیل کریں",
  "description": description,
  "inLanguage": "ur",
  "totalTime": "PT2M",
  "supply": [
    { "@type": "HowToSupply", "name": "ChatGPT اکاؤنٹ" },
    { "@type": "HowToSupply", "name": "360° equirectangular JPG یا PNG تصویر" }
  ],
  "tool": [
    { "@type": "HowToTool", "name": "Urdu Ai 360° Viewer (urduai.org/360)" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "ChatGPT میں 360° تصویر بنائیں",
      "text": "ChatGPT کو کہیں: 'Generate a 360 equirectangular panorama of ...' جیسا کوئی پرامٹ لکھیں اور تیار ہونے والی 2:1 تصویر ڈاؤن لوڈ کریں۔"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Urdu Ai 360° Viewer میں اپ لوڈ کریں",
      "text": "urduai.org/360 پر آ کر 'Choose image' دبائیں یا تصویر کو ڈراپ کریں۔ یہ فوری طور پر 360° ویو میں کھل جائے گی۔"
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "ریکارڈ 360° pan دبائیں",
      "text": "دورانیہ (8، 15 یا 30 سیکنڈ) اور ریزولوشن (720p، 1080p، 1440p) منتخب کریں، پھر 'Record 360° pan' دبائیں۔ ویڈیو خود بخود Urdu Ai واٹر مارک کے ساتھ ڈاؤن لوڈ ہو جائے گی۔"
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "سوشل میڈیا پر شیئر کریں",
      "text": "ڈاؤن لوڈ شدہ MP4 کو Instagram، TikTok، YouTube Shorts، Facebook یا X پر شیئر کریں۔"
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Urdu Ai 360° Viewer",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "inLanguage": "ur",
  "url": "https://urduai.org/360/"
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [howToSchema, appSchema]
};
---
<Base title={title} description={description} schema={schema} ogImage="/og/360-viewer.jpg">
  <article class="p360">
    <header class="p360__hero">
      <div class="container">
        <div class="p360__badge">نیا فیچر · Free Tool</div>
        <h1 class="p360__title">
          ChatGPT کی <span class="highlight">360° تصویر</span> کو<br />
          ویڈیو میں تبدیل کریں
        </h1>
        <p class="p360__lede">
          ChatGPT اب 360° equirectangular تصاویر بنا سکتا ہے۔ لیکن ایک فلیٹ تصویر سے کیا کرنا؟
          Urdu Ai 360° Viewer اسے انٹرایکٹو 360 ویو میں کھولتا ہے اور خود بخود ایک گھومتی ہوئی
          MP4 ویڈیو بناتا ہے — جسے آپ فوراً سوشل میڈیا پر شیئر کر سکتے ہیں۔
        </p>
        <div class="p360__meta">
          <span>مکمل مفت</span>
          <span class="dot"></span>
          <span>براؤزر میں چلتا ہے</span>
          <span class="dot"></span>
          <span>نہ اکاؤنٹ، نہ ڈاؤن لوڈ</span>
        </div>
      </div>
    </header>

    <section class="p360__viewer-section">
      <div class="container">
        <div class="p360__viewer-frame">
          <iframe
            src={`/360/viewer.html?v=${viewerVersion}`}
            title="Urdu Ai 360° Viewer"
            loading="lazy"
            allow="fullscreen"
            allowfullscreen
          ></iframe>
        </div>
        <p class="p360__viewer-caption">
          تصویر کو ڈراپ کریں یا 'Choose image' دبائیں۔
          <a href="/360/viewer.html" target="_blank" rel="noopener">فل اسکرین موڈ میں کھولیں ←</a>
        </p>
      </div>
    </section>

    <section class="p360__steps">
      <div class="container">
        <h2>کیسے استعمال کریں</h2>
        <ol class="p360__step-list">
          <li>
            <div class="p360__step-num">۱</div>
            <div>
              <h3>ChatGPT میں 360° تصویر بنائیں</h3>
              <p>
                ChatGPT کو کہیں:
                <code dir="ltr">Generate a 360 equirectangular panorama of [your scene]</code> —
                ChatGPT ایک 2:1 تناسب کی پینوراما تصویر بنائے گا۔ اسے JPG یا PNG کی شکل میں ڈاؤن لوڈ کریں۔
              </p>
            </div>
          </li>
          <li>
            <div class="p360__step-num">۲</div>
            <div>
              <h3>Urdu Ai Viewer میں اپ لوڈ کریں</h3>
              <p>
                اوپر دیے گئے viewer میں تصویر کو ڈراپ کریں یا 'Choose image' دبائیں۔ یہ فوراً
                انٹرایکٹو 360° ویو میں کھل جائے گی — موبائل پر ٹچ سے، کمپیوٹر پر ماؤس سے گھمائیں۔
              </p>
            </div>
          </li>
          <li>
            <div class="p360__step-num">۳</div>
            <div>
              <h3>ویڈیو ریکارڈ کریں</h3>
              <p>
                'Record 360° pan' دبائیں۔ دورانیہ اور کوالٹی منتخب کریں۔ Urdu Ai کے واٹر مارک کے ساتھ
                ایک MP4 ویڈیو خود بخود ڈاؤن لوڈ ہو جائے گی۔
              </p>
            </div>
          </li>
          <li>
            <div class="p360__step-num">۴</div>
            <div>
              <h3>شیئر کریں</h3>
              <p>
                Instagram Reels، TikTok، YouTube Shorts، Facebook اور X — ہر جگہ یہ ویڈیو شیئر کریں۔
                Urdu Ai کا واٹر مارک خود بخود شامل ہوگا تاکہ آپ کے دوست بھی یہ ٹول استعمال کر سکیں۔
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="p360__faq">
      <div class="container">
        <h2>اکثر پوچھے گئے سوالات</h2>

        <details>
          <summary>کیا یہ واقعی مفت ہے؟</summary>
          <p>جی ہاں، مکمل مفت۔ نہ اکاؤنٹ بنانا ہے، نہ کوئی سبسکرپشن۔ ہر چیز آپ کے براؤزر میں چلتی ہے — آپ کی تصویر ہماری سرور پر نہیں جاتی۔</p>
        </details>

        <details>
          <summary>کون سی تصاویر کام کرتی ہیں؟</summary>
          <p>equirectangular 360° تصاویر جن کا تناسب 2:1 ہو (مثلاً 2048×1024، 4096×2048)۔ ChatGPT، Skybox AI، Blockade Labs، اور Google Street View جیسے ٹولز سے بننے والی تصاویر۔</p>
        </details>

        <details>
          <summary>iPhone پر ویڈیو ریکارڈ کیوں نہیں ہوتی؟</summary>
          <p>Safari پر iPhone اور iPad میں MediaRecorder API محدود ہے۔ اس صورت میں 'Save PNG' بٹن استعمال کریں — یہ آپ کو حالیہ ویو کی ایک تصویر Urdu Ai واٹر مارک کے ساتھ دے گا۔ ڈیسک ٹاپ یا Android پر Chrome میں ویڈیو ریکارڈ کام کرتی ہے۔</p>
        </details>

        <details>
          <summary>ویڈیو کہاں محفوظ ہوتی ہے؟</summary>
          <p>آپ کی ڈیوائس کے 'Downloads' فولڈر میں۔ فائل کا نام <code dir="ltr">urdu-ai-360-[time].mp4</code> ہوگا۔</p>
        </details>

        <details>
          <summary>کیا ویڈیو کی کوالٹی تبدیل کر سکتا ہوں؟</summary>
          <p>جی — 720p (موبائل کے لیے بہترین)، 1080p (سوشل میڈیا کے لیے)، اور 1440p (یوٹیوب کے لیے)۔ دورانیہ 8، 15 یا 30 سیکنڈ۔</p>
        </details>
      </div>
    </section>

    <section class="p360__app-cta">
      <div class="container">
        <h2>مزید AI ٹولز اردو میں چاہئیں؟</h2>
        <p>Urdu Ai ایپ ڈاؤن لوڈ کریں — 50,000+ لوگ روزانہ استعمال کرتے ہیں۔</p>
        <a href="/app/" class="btn-primary">ایپ دیکھیں ←</a>
      </div>
    </section>
  </article>

  <style>
    .p360 {
      padding-bottom: 80px;
    }
    .p360 .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Hero */
    .p360__hero {
      background: linear-gradient(135deg, #1d559f 0%, #0f2340 100%);
      color: #fff;
      padding: 64px 0 56px;
      text-align: center;
      margin-bottom: 40px;
    }
    .p360__badge {
      display: inline-block;
      background: rgba(241, 204, 17, 0.15);
      color: #f1cc11;
      padding: 6px 16px;
      border-radius: 999px;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
      margin-bottom: 20px;
      direction: ltr;
    }
    .p360__title {
      font-size: 2.4rem;
      font-weight: 700;
      line-height: 1.8;
      color: #fff;
      margin: 0 0 20px;
    }
    .p360__title .highlight { color: #f1cc11; }
    .p360__lede {
      font-size: 1.05rem;
      line-height: 2.1;
      color: rgba(255, 255, 255, 0.88);
      max-width: 720px;
      margin: 0 auto 24px;
    }
    .p360__meta {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
    }
    .p360__meta .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
    }

    /* Viewer embed */
    .p360__viewer-section {
      margin-bottom: 56px;
    }
    .p360__viewer-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      overflow: hidden;
      background: #0a1525;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
      border: 1px solid var(--border, #e2d9c8);
    }
    .p360__viewer-frame iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    .p360__viewer-caption {
      margin-top: 12px;
      text-align: center;
      color: var(--ink-muted, #7a6a52);
      font-size: 0.9rem;
    }
    .p360__viewer-caption a {
      color: var(--teal, #0e6b5e);
      font-weight: 600;
      margin-inline-start: 8px;
    }

    /* Steps */
    .p360__steps {
      margin-bottom: 56px;
    }
    .p360__steps h2 {
      font-size: 1.7rem;
      margin: 0 0 24px;
      text-align: center;
    }
    .p360__step-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 20px;
    }
    .p360__step-list > li {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 20px;
      align-items: flex-start;
      background: var(--paper-card, #fff);
      padding: 24px;
      border-radius: 12px;
      border: 1px solid var(--border, #e2d9c8);
    }
    .p360__step-num {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #1d559f;
      color: #f1cc11;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Noto Nastaliq Urdu', serif;
      font-weight: 700;
      font-size: 1.5rem;
      line-height: 1;
    }
    .p360__step-list h3 {
      font-size: 1.2rem;
      margin: 0 0 8px;
    }
    .p360__step-list p {
      margin: 0;
      line-height: 2;
    }
    .p360__step-list code {
      direction: ltr;
      unicode-bidi: embed;
      background: #f5f0e8;
      padding: 2px 8px;
      border-radius: 4px;
      font-family: 'SFMono-Regular', Menlo, monospace;
      font-size: 0.85em;
    }

    /* FAQ */
    .p360__faq {
      margin-bottom: 56px;
    }
    .p360__faq h2 {
      font-size: 1.7rem;
      margin: 0 0 20px;
      text-align: center;
    }
    .p360__faq details {
      background: var(--paper-card, #fff);
      border: 1px solid var(--border, #e2d9c8);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 12px;
    }
    .p360__faq summary {
      font-weight: 700;
      cursor: pointer;
      font-size: 1.05rem;
      padding: 4px 0;
    }
    .p360__faq details[open] summary { margin-bottom: 10px; }
    .p360__faq details p {
      margin: 0;
      line-height: 2;
      color: var(--ink-soft, #3d3222);
    }

    /* App CTA */
    .p360__app-cta {
      text-align: center;
      background: var(--paper-warm, #f5f0e8);
      padding: 40px 20px;
      border-radius: 16px;
      margin: 0 20px;
      max-width: 920px;
      margin-inline: auto;
    }
    .p360__app-cta h2 {
      margin: 0 0 10px;
      font-size: 1.5rem;
    }
    .p360__app-cta p {
      margin: 0 0 20px;
      color: var(--ink-soft, #3d3222);
    }
    .btn-primary {
      display: inline-block;
      background: #1d559f;
      color: #fff;
      padding: 12px 28px;
      border-radius: 10px;
      font-weight: 700;
      text-decoration: none;
      font-size: 1rem;
    }
    .btn-primary:hover { filter: brightness(1.08); }

    /* Mobile */
    @media (max-width: 640px) {
      .p360__hero { padding: 40px 0 36px; }
      .p360__title { font-size: 1.8rem; }
      .p360__lede { font-size: 0.95rem; }
      .p360__step-list > li {
        grid-template-columns: 44px 1fr;
        gap: 14px;
        padding: 18px;
      }
      .p360__step-num { width: 40px; height: 40px; font-size: 1.25rem; }
    }
  </style>
</Base>
