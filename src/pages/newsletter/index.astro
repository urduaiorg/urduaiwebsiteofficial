---
import Base from '../../layouts/Base.astro';

export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="نیوز لیٹر سبسکرائب کریں — اردو اے آئی اپڈیٹس"
  description="اردو اے آئی کا ہفتہ وار نیوز لیٹر سبسکرائب کریں۔ تازہ ترین AI خبریں، گائیڈز اور پرامٹس ای میل اور واٹس ایپ پر حاصل کریں۔"
  canonical="https://urduai.org/newsletter/"
  adsense={false}
>
  <section class="newsletter-hero">
    <div class="container" style="text-align:center;">
      <div class="newsletter-hero__icon" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="64" height="64" rx="16" fill="#25D366" fill-opacity="0.15"/>
          <path d="M42.472 38.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0037.05 24C30.495 24 25.16 29.335 25.157 35.892c0 2.096.547 4.142 1.588 5.945L25.057 48l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" fill="#25D366"/>
        </svg>
      </div>
      <h1 class="newsletter-hero__title">اردو اے آئی نیوز لیٹر</h1>
      <p class="newsletter-hero__sub">
        اے آئی کی تازہ ترین خبریں، گائیڈز اور پرامٹس<br/>
        ہفتہ وار ای میل اور واٹس ایپ پر — مفت
      </p>

      <div class="newsletter-stats">
        <div class="newsletter-stat">
          <span class="newsletter-stat__number" dir="ltr">1M+</span>
          <span class="newsletter-stat__label">کمیونٹی</span>
        </div>
        <div class="newsletter-stat">
          <span class="newsletter-stat__number" dir="ltr">50K+</span>
          <span class="newsletter-stat__label">ایپ ڈاؤن لوڈز</span>
        </div>
        <div class="newsletter-stat">
          <span class="newsletter-stat__number" dir="ltr">100%</span>
          <span class="newsletter-stat__label">مفت</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="newsletter-layout">

      <!-- What you get -->
      <div class="newsletter-features">
        <h2>واٹس ایپ چینل پر آپ کو ملے گا</h2>
        <ul class="newsletter-feature-list">
          <li class="newsletter-feature">
            <span class="newsletter-feature__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" rx="6" fill="#1d559f" fill-opacity="0.1"/>
                <path d="M5 12h14M12 5l7 7-7 7" stroke="#1d559f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <strong>تازہ ترین اے آئی خبریں</strong>
              <p>ChatGPT، Gemini، Claude اور دیگر ٹولز کی نئی اپڈیٹس — پاکستانی نقطہ نظر سے تجزیہ</p>
            </div>
          </li>
          <li class="newsletter-feature">
            <span class="newsletter-feature__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" rx="6" fill="#1d559f" fill-opacity="0.1"/>
                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="#1d559f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <strong>عملی گائیڈز</strong>
              <p>اے آئی ٹولز کو اپنے کام میں کیسے استعمال کریں — قدم بقدم ہدایات</p>
            </div>
          </li>
          <li class="newsletter-feature">
            <span class="newsletter-feature__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" rx="6" fill="#f1cc11" fill-opacity="0.15"/>
                <path d="M14 3v4a1 1 0 001 1h4M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8M14 3l5 5" stroke="#1d559f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <strong>تیار اردو پرامٹس</strong>
              <p>کاپی پیسٹ کے لیے تیار پرامٹس — ہر ہفتے نئے، مختلف پیشوں کے لیے</p>
            </div>
          </li>
        </ul>

        <div class="newsletter-social-proof">
          <p>
            <strong>قیصر رونجھا</strong> کی جانب سے — اردو اے آئی کے بانی۔
            ElevenLabs اور Google.org کے تعاون یافتہ۔
          </p>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="newsletter-cta-wrap">
        <div class="newsletter-cta-card newsletter-cta-card--featured">
          <h3>نیوز لیٹر سبسکرائب کریں</h3>
          <p>ہفتہ وار AI اپڈیٹس سیدھے اپنے ای میل میں حاصل کریں</p>
          <a
            href="https://www.urduaiupdates.com/subscribe"
            target="_blank"
            rel="noopener noreferrer"
            class="newsletter-cta-btn newsletter-cta-btn--subscribe"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            ابھی سبسکرائب کریں
          </a>
          <span class="newsletter-cta-card__note">پچھلے شمارے: <a href="https://www.urduaiupdates.com/" target="_blank" rel="noopener">urduaiupdates.com</a></span>
        </div>

        <div class="newsletter-cta-card">
          <h3>واٹس ایپ چینل جوائن کریں</h3>
          <p>اے آئی اپڈیٹس فوری طور پر واٹس ایپ پر حاصل کریں</p>
          <a
            href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D"
            target="_blank"
            rel="noopener noreferrer"
            class="newsletter-cta-btn newsletter-cta-btn--whatsapp"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            واٹس ایپ چینل جوائن کریں
          </a>
        </div>

        <div class="newsletter-cta-card">
          <h3>اردو اے آئی ایپ ڈاؤن لوڈ کریں</h3>
          <p>ہزاروں مضامین، گائیڈز اور پرامٹس ایک ایپ میں</p>
          <a
            href="https://play.google.com/store/apps/details?id=org.urduai.app"
            target="_blank"
            rel="noopener"
            class="newsletter-cta-btn newsletter-cta-btn--app"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 13l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/></svg>
            مفت ڈاؤن لوڈ کریں
          </a>
        </div>

        <div class="newsletter-cta-card newsletter-cta-card--alt">
          <h3>انگریزی میں AI مواد چاہیے؟</h3>
          <p>AI Viewer پر تازہ ترین AI خبریں اور گائیڈز انگریزی میں پڑھیں</p>
          <a
            href="https://www.aiviewer.ai/"
            target="_blank"
            rel="noopener noreferrer"
            class="newsletter-cta-btn newsletter-cta-btn--aiviewer"
          >
            AI Viewer دیکھیں
          </a>
        </div>
      </div>

    </div>
  </div>
</Base>

<style>
  .newsletter-hero {
    background: var(--ink);
    padding-block: var(--space-2xl);
    margin-block-end: var(--space-2xl);
  }

  .newsletter-hero__icon {
    display: flex;
    justify-content: center;
    margin-block-end: var(--space-md);
  }

  .newsletter-hero__title {
    font-size: var(--text-h1);
    color: var(--gold-light);
    margin-block-end: var(--space-sm);
  }

  .newsletter-hero__sub {
    color: var(--gold-pale);
    font-size: var(--text-base);
    line-height: var(--lh-prose);
    margin-block-end: var(--space-lg);
  }

  .newsletter-stats {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .newsletter-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2em;
  }

  .newsletter-stat__number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }

  .newsletter-stat__label {
    font-size: var(--text-sm);
    color: var(--gold-pale);
  }

  .newsletter-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
    margin-block-end: var(--space-2xl);
  }

  .newsletter-features h2 {
    font-size: var(--text-h2);
    margin-block-end: var(--space-lg);
    color: var(--ink);
  }

  .newsletter-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .newsletter-feature {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .newsletter-feature__icon {
    flex-shrink: 0;
    margin-block-start: 0.2em;
  }

  .newsletter-feature strong {
    display: block;
    color: var(--ink);
    margin-block-end: 0.2em;
  }

  .newsletter-feature p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: var(--lh-body);
    margin: 0;
  }

  .newsletter-social-proof {
    background: var(--paper-warm);
    border-inline-start: 3px solid var(--gold);
    padding: var(--space-sm) var(--space-md);
    border-radius: 0 6px 6px 0;
  }

  .newsletter-social-proof p {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin: 0;
    line-height: var(--lh-body);
  }

  .newsletter-cta-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .newsletter-cta-card {
    background: var(--paper-warm);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md);
    text-align: center;
  }

  .newsletter-cta-card--alt {
    background: var(--ink);
    border-color: var(--ink);
  }

  .newsletter-cta-card--alt h3 {
    color: var(--gold-light);
  }

  .newsletter-cta-card--alt p {
    color: var(--gold-pale);
  }

  .newsletter-cta-card h3 {
    font-size: 1.15rem;
    margin-block-end: var(--space-xs);
    color: var(--ink);
  }

  .newsletter-cta-card p {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-block-end: var(--space-sm);
    line-height: var(--lh-body);
  }

  .newsletter-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6em 1.4em;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    font-size: var(--text-sm);
    transition: opacity 0.2s;
  }

  .newsletter-cta-btn:hover {
    opacity: 0.9;
  }

  .newsletter-cta-btn--whatsapp {
    background: #25D366;
    color: #fff;
  }

  .newsletter-cta-btn--app {
    background: var(--gold);
    color: var(--ink);
  }

  .newsletter-cta-btn--subscribe {
    background: var(--navy);
    color: #fff;
  }

  .newsletter-cta-btn--aiviewer {
    background: #1d559f;
    color: #fff;
  }

  .newsletter-cta-card--featured {
    background: var(--paper-card);
    border: 2px solid var(--gold);
  }

  .newsletter-cta-card__note {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin-block-start: var(--space-xs);
  }

  .newsletter-cta-card__note a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .newsletter-layout {
      grid-template-columns: 1fr;
    }
    .newsletter-cta-wrap {
      order: -1;
    }
  }
</style>
