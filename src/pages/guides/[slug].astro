---
import Article from '../../layouts/Article.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/download-guide.css';

export const prerender = true;

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map(g => ({
    params: { slug: g.id },
    props: { guide: g },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Article
  title={guide.data.title}
  description={guide.data.description}
  date={guide.data.date}
  author={guide.data.author}
  category={guide.data.category}
  image={guide.data.image}
  ogImage={guide.data.og_image}
  imageWidth={guide.data.image_width}
  imageHeight={guide.data.image_height}
  imageFit={guide.data.image_fit}
  adsense={guide.data.adsense}
  slug={guide.id}
  collection="guides"
  tools={guide.data.tools}
  faq={guide.data.faq}
  howToSteps={guide.data.howto_steps}
  last_updated={guide.data.last_updated}
>
  <Content />
</Article>
