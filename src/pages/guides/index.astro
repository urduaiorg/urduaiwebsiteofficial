---
import Base from '../../layouts/Base.astro';
import LegacyCommentsSection from '../../components/LegacyCommentsSection.astro';
import legacyCommentsPayload from '../../data/legacy-comments.json';
import { getCollection } from 'astro:content';

export const prerender = true;

const all = await getCollection('guides', ({ data }) => !data.draft);
const guides = all.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const legacyCommentsData = legacyCommentsPayload as {
  commentsByCollection: Record<string, Record<string, unknown[]>>;
};
const legacyGuideHubComments =
  legacyCommentsData.commentsByCollection.pages?.['guides-index'] ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqItems = [
  {
    question: 'AI guides in Urdu کہاں سے شروع کریں؟',
    answer: 'اگر آپ beginner ہیں تو پہلے AI کیا ہے؟ والی گائیڈ پڑھیں، پھر Gemini اردو گائیڈ سے پہلا practical prompt لکھیں، اور اس کے بعد free AI course یا prompt engineering پر جائیں۔',
  },
  {
    question: 'کیا یہ گائیڈز beginners کے لیے ہیں؟',
    answer: 'جی ہاں۔ اردو اے آئی گائیڈز عام mobile users، students، teachers، freelancers اور small business owners کے لیے آسان اردو اور پاکستانی مثالوں کے ساتھ لکھی گئی ہیں۔',
  },
  {
    question: 'ChatGPT اور Gemini سیکھنے کے لیے کون سی گائیڈ پہلے پڑھیں؟',
    answer: 'پہلے AI کی بنیادی گائیڈ پڑھیں، پھر Gemini اردو گائیڈ یا ChatGPT app guide کھولیں، اور آخر میں prompt engineering سیکھیں تاکہ جواب بہتر ملے۔',
  },
  {
    question: 'کیا اردو اے آئی پر free AI course موجود ہے؟',
    answer: 'اردو اے آئی پر free AI course اور ماسٹرکلاس کے راستے موجود ہیں۔ Guides hub سے آپ beginner course، practical tools اور topic-wise lessons تک جا سکتے ہیں۔',
  },
  {
    question: 'AI tools سیکھنے کے لیے کون سا راستہ بہتر ہے؟',
    answer: 'پہلے اپنی ضرورت چنیں: study، writing، freelancing، business یا coding۔ پھر اسی topic کی guide کھولیں اور ایک tool پر روزانہ چھوٹا practice task کریں۔',
  },
];
const guideHubSchema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "AI guides in Urdu: ChatGPT، Gemini، free course",
    "description": "AI guides in Urdu میں beginners کے لیے ChatGPT، Gemini، prompt engineering، free AI course، tools اور Pakistani examples ایک جگہ۔",
    "url": "https://urduai.org/guides/",
    "inLanguage": "ur",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "اردو اے آئی beginner learning path",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "AI کیا ہے؟ آسان اردو تعریف، مثالیں اور پہلا قدم", "url": "https://urduai.org/guides/ai-kya-hai-urdu-ai-master-class-1/" },
      { "@type": "ListItem", "position": 2, "name": "مفت AI کورس اردو میں کہاں سے شروع کریں", "url": "https://urduai.org/guides/free-ai-course-urdu/" },
      { "@type": "ListItem", "position": 3, "name": "Gemini اردو میں استعمال کرنے کا طریقہ", "url": "https://urduai.org/how-to/how-to-use-gemini-in-urdu/" },
      { "@type": "ListItem", "position": 4, "name": "Prompt engineering کیا ہے؟", "url": "https://urduai.org/learn/prompt-engineering/" },
      { "@type": "ListItem", "position": 5, "name": "AI Tools Directory", "url": "https://urduai.org/tools/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      "name": question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": answer,
      },
    })),
  },
];
---

<Base
  title="AI guides in Urdu: ChatGPT، Gemini، free course"
  description="AI guides in Urdu میں beginners کے لیے ChatGPT، Gemini، prompt engineering، free AI course، tools اور Pakistani examples ایک جگہ۔"
  canonical="https://urduai.org/guides/"
  adsense={true}
  schema={guideHubSchema}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li aria-current="page">گائیڈز</li>
      </ol>
    </nav>

    <h1>اردو میں AI گائیڈز: ChatGPT، Gemini اور free course</h1>
    <p class="text-muted guides-intro">
      AI guides in Urdu کا آسان راستہ یہ ہے کہ پہلے AI کی بنیاد سمجھیں، پھر ChatGPT، Gemini یا Claude میں ایک practical کام کریں، اور اس کے بعد prompt engineering، free AI course یا tools directory سے اپنی ضرورت کے مطابق اگلا سبق چنیں۔
    </p>

    <section class="guides-answer" aria-labelledby="guides-answer-title">
      <h2 id="guides-answer-title">فوری جواب: پہلے کیا پڑھیں؟</h2>
      <p>
        اگر آپ پہلی بار AI سیکھ رہے ہیں تو <a href={`${base}/guides/ai-kya-hai-urdu-ai-master-class-1/`}>AI کیا ہے؟</a> سے شروع کریں۔ اگر آپ پہلے ہی ChatGPT یا Gemini استعمال کر چکے ہیں تو <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو گائیڈ</a>، <a href={`${base}/guides/free-ai-course-urdu/`}>free AI course guide</a> یا <a href={`${base}/learn/prompt-engineering/`}>prompt engineering</a> پر جائیں۔
      </p>
    </section>

    <section class="guides-start" aria-labelledby="guides-start-title">
      <h2 id="guides-start-title">بالکل نئے ہیں؟ یہاں سے شروع کریں</h2>
      <div class="guides-start__links">
        <a href={`${base}/guides/ai-kya-hai-urdu-ai-master-class-1/`}>AI کیا ہے؟</a>
        <a href={`${base}/guides/free-ai-course-urdu/`}>مفت AI کورس گائیڈ</a>
        <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو گائیڈ</a>
        <a href={`${base}/how-to/how-to-install-original-chatgpt-app/`}>ChatGPT app guide</a>
        <a href={`${base}/learn/prompt-engineering/`}>Prompt engineering</a>
        <a href={`${base}/tools/`}>AI tools directory</a>
      </div>
    </section>

    <section class="guides-topics" aria-labelledby="guides-topics-title">
      <h2 id="guides-topics-title">اپنی ضرورت کے مطابق گائیڈ چنیں</h2>
      <div class="guides-topics__grid">
        <article>
          <h3>Students اور learning</h3>
          <p>سبق سمجھنے، notes بنانے اور exam revision کے لیے practical AI workflow۔</p>
          <a href={`${base}/guides/gemini-for-students-urdu/`}>Gemini for students پڑھیں</a>
        </article>
        <article>
          <h3>Writing اور content</h3>
          <p>تحریر، outline، editing، image prompts اور social content کے لیے آسان راستہ۔</p>
          <a href={`${base}/guides/ai-image-expression-prompts-urdu-guide/`}>AI image prompts guide پڑھیں</a>
        </article>
        <article>
          <h3>Freelancing اور business</h3>
          <p>proposal، client work، small business content اور روزمرہ productivity کے لیے tools۔</p>
          <a href={`${base}/guides/ai-tools-for-freelancers-pakistan/`}>Freelancers tools guide پڑھیں</a>
        </article>
        <article>
          <h3>Coding اور websites</h3>
          <p>وائب کوڈنگ، Codex، GitHub، hosting اور simple app بنانے کا beginner path۔</p>
          <a href={`${base}/guides/vibe-coding-kya-hai/`}>Vibe coding کیا ہے؟</a>
        </article>
      </div>
    </section>

    <div class="post-grid">
      {guides.map(g => (
        <article class="card">
          {g.data.image && (
            <img
              src={g.data.image}
              alt={g.data.title}
              width="400"
              height="225"
              loading="lazy"
              class={`guide-card__image${g.data.image_fit === 'contain' ? ' guide-card__image--contain' : ''}${g.data.image_fit === 'portrait' ? ' guide-card__image--portrait' : ''}`}
            />
          )}
          <p class="card__meta">
            <span class="badge badge--teal">{g.data.level}</span>
            {g.data.tool && <span style="margin-inline-start:0.5em">{g.data.tool}</span>}
          </p>
          <h2 class="card__title"><a href={`${base}/guides/${g.id}/`}>{g.data.title}</a></h2>
          <p class="card__excerpt">{g.data.description}</p>
        </article>
      ))}
    </div>

    <section class="guides-faq" aria-labelledby="guides-faq-title">
      <h2 id="guides-faq-title">اکثر پوچھے گئے سوالات</h2>
      {faqItems.map(item => (
        <div class="guides-faq__item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </div>
      ))}
    </section>

    <LegacyCommentsSection comments={legacyGuideHubComments} />
  </div>

  <style>
    .guide-card__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: 6px;
      margin-block-end: var(--space-sm);
    }

    .guide-card__image--contain {
      object-fit: contain;
      background: #03162b;
    }

    .guide-card__image--portrait {
      aspect-ratio: 4 / 5;
      object-fit: contain;
      background: #03162b;
    }

    .guides-intro {
      max-width: 760px;
      margin-block-end: var(--space-md);
      line-height: var(--lh-prose);
    }

    .guides-answer {
      max-width: 820px;
      border-block-start: 1px solid var(--border);
      padding-block-start: var(--space-md);
      margin-block-end: var(--space-md);
    }

    .guides-answer h2,
    .guides-topics h2,
    .guides-faq h2 {
      font-size: 1.35rem;
      line-height: var(--lh-heading);
      margin-block-end: var(--space-xs);
    }

    .guides-answer p {
      line-height: var(--lh-prose);
      margin: 0;
    }

    .guides-start {
      border-block: 1px solid var(--border);
      padding-block: var(--space-md);
      margin-block-end: var(--space-lg);
    }

    .guides-start h2 {
      font-size: 1.35rem;
      line-height: var(--lh-heading);
      margin-block-end: var(--space-xs);
    }

    .guides-start__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .guides-start__links a {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.45em 0.9em;
      background: var(--paper-card);
      color: var(--teal);
      text-decoration: none;
      font-size: var(--text-sm);
    }

    .guides-start__links a:hover {
      border-color: var(--teal);
    }

    .guides-topics {
      margin-block-end: var(--space-lg);
    }

    .guides-topics__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-sm);
    }

    .guides-topics__grid article {
      border-block-start: 3px solid var(--gold);
      background: var(--paper-warm);
      padding: var(--space-sm);
      border-radius: 8px;
    }

    .guides-topics__grid h3,
    .guides-faq__item h3 {
      font-size: 1.08rem;
      line-height: var(--lh-heading);
      margin-block-end: 0.35em;
    }

    .guides-topics__grid p,
    .guides-faq__item p {
      font-size: var(--text-sm);
      line-height: var(--lh-prose);
      margin-block-end: 0.45em;
    }

    .guides-faq {
      border-block-start: 1px solid var(--border);
      padding-block-start: var(--space-md);
      margin-block-start: var(--space-xl);
      margin-block-end: var(--space-lg);
      max-width: 860px;
    }

    .guides-faq__item {
      border-block-end: 1px solid var(--border);
      padding-block: var(--space-xs);
    }
  </style>
</Base>
