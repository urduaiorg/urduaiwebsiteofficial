---
import Base from '../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "اے آئی ریڈینس اسیسمنٹ — پاکستانی اساتذہ کے لیے",
  "description": "اردو اے آئی اور پاک ایجوکیٹ کا مشترکہ اے آئی ریڈینس ٹیسٹ — مفت، اردو میں، یونیسکو معیارات پر مبنی",
  "url": "https://urduai.org/ready",
  "inLanguage": "ur"
};
---

<Base
  title="اے آئی ریڈینس اسیسمنٹ — پاکستانی اساتذہ کے لیے"
  description="جانیں آپ اپنی پڑھائی میں اے آئی کے لیے کتنے تیار ہیں — مفت ٹیسٹ، ذاتی PDF رپورٹ، اور سرٹیفکیٹ۔ اردو اے آئی اور پاک ایجوکیٹ کا مشترکہ اقدام۔"
  canonical="https://urduai.org/ready"
  ogImage="/og/ready-og.png"
  schema={schema}
  adsense={false}
>

<main class="ready-wrap">

  <div class="ready-badge">
    <span>اردو Ai</span>
    <span class="ready-badge-sep">×</span>
    <span>PakEducate</span>
  </div>

  <h1>اے آئی کے لیے کتنے تیار ہیں آپ؟</h1>

  <p class="ready-lead">
    پاکستانی اساتذہ اور اسکولوں کے لیے پہلی اردو اے آئی ریڈینس اسیسمنٹ — یونیسکو کے ۲۰۲۴ معیارات پر مبنی۔
    ٹیسٹ مفت ہے، اردو میں ہے، اور مکمل ہوتے ہی ذاتی PDF رپورٹ اور سرٹیفکیٹ ای میل پر ملتا ہے۔
  </p>

  <div class="ready-hero-img">
    <img
      src="/images/blog/ai-readiness-assessment-for-teachers.png"
      alt="کیا آپ بطور استاد اے آئی کے لیے تیار ہیں؟ — اردو Ai اور PakEducate"
      width="1536"
      height="1024"
      loading="eager"
    />
  </div>

  <div class="ready-cards">

    <div class="ready-card">
      <div class="ready-card-icon">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="12" r="7" stroke="#b8860b" stroke-width="2" fill="none"/>
          <path d="M6 36c0-7.732 6.268-14 14-14s14 6.268 14 14" stroke="#b8860b" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <h2>استاد کا ٹیسٹ</h2>
      <p>اگر آپ پڑھاتے ہیں — پرائمری سے ہائر سیکنڈری تک — یہ ٹیسٹ آپ کی اے آئی تیاری جانچتا ہے۔</p>
      <ul class="ready-meta">
        <li>۵ سے ۷ منٹ</li>
        <li>۱۹ سوالات</li>
        <li>مفت رپورٹ + سرٹیفکیٹ</li>
      </ul>
      <a href="https://assessment.pakeducate.com/teacher" class="ready-btn ready-btn-primary" rel="noopener noreferrer" target="_blank">
        استاد کا ٹیسٹ شروع کریں
      </a>
    </div>

    <div class="ready-card">
      <div class="ready-card-icon">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="4" y="8" width="32" height="24" rx="3" stroke="#0e6b5e" stroke-width="2" fill="none"/>
          <path d="M13 8v24M4 18h36" stroke="#0e6b5e" stroke-width="2"/>
        </svg>
      </div>
      <h2>اسکول کا ٹیسٹ</h2>
      <p>اگر آپ پرنسپل یا منتظم ہیں — یہ ٹیسٹ آپ کے ادارے کی مکمل اے آئی تیاری ناپتا ہے۔</p>
      <ul class="ready-meta">
        <li>۸ سے ۱۰ منٹ</li>
        <li>۵ شعبے</li>
        <li>ادارے کی مفت رپورٹ</li>
      </ul>
      <a href="https://assessment.pakeducate.com/school" class="ready-btn ready-btn-secondary" rel="noopener noreferrer" target="_blank">
        اسکول کا ٹیسٹ شروع کریں
      </a>
    </div>

  </div>

  <div class="ready-tiers">
    <p class="ready-tiers-label">چار سطحیں — آپ کہاں ہیں؟</p>
    <div class="ready-tiers-row">
      <div class="ready-tier">
        <span class="tier-dot tier-1"></span>
        <span>Foundational</span>
      </div>
      <div class="ready-tier">
        <span class="tier-dot tier-2"></span>
        <span>Developing</span>
      </div>
      <div class="ready-tier">
        <span class="tier-dot tier-3"></span>
        <span>Established</span>
      </div>
      <div class="ready-tier">
        <span class="tier-dot tier-4"></span>
        <span>Leading</span>
      </div>
    </div>
  </div>

  <div class="ready-footer-links">
    <a href="/blog/ai-readiness-assessment-for-teachers/" class="ready-link-read">
      اسیسمنٹ کے بارے میں مزید پڑھیں
    </a>
    <span class="ready-divider">·</span>
    <a href="https://pakeducate.com" class="ready-link-ext" rel="noopener noreferrer" target="_blank">
      PakEducate.com
    </a>
  </div>

</main>

</Base>

<style>
.ready-wrap {
  max-width: 780px;
  margin: 0 auto;
  padding: 3rem 1.25rem 4rem;
  text-align: center;
}

.ready-hero-img {
  margin: 0 0 2.5rem;
  border-radius: 0.75rem;
  overflow: hidden;
  border: 1px solid var(--border);
}

.ready-hero-img img {
  width: 100%;
  height: auto;
  display: block;
}

.ready-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--gold-pale);
  border: 1px solid var(--border);
  border-radius: 2rem;
  padding: 0.35rem 1.1rem;
  font-size: 0.85rem;
  color: var(--ink-soft);
  margin-bottom: 1.5rem;
  letter-spacing: 0;
}

.ready-badge-sep {
  color: var(--ink-muted);
}

h1 {
  font-size: 2rem;
  line-height: 1.8;
  color: var(--ink);
  margin: 0 0 1rem;
}

.ready-lead {
  font-size: 1.05rem;
  line-height: 2.0;
  color: var(--ink-soft);
  max-width: 600px;
  margin: 0 auto 2.5rem;
}

.ready-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 2.5rem;
}

@media (max-width: 600px) {
  .ready-cards {
    grid-template-columns: 1fr;
  }
}

.ready-card {
  background: var(--paper-warm);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  padding: 1.75rem 1.5rem;
  text-align: right;
}

.ready-card-icon {
  margin-bottom: 0.75rem;
  display: flex;
  justify-content: flex-end;
}

.ready-card h2 {
  font-size: 1.2rem;
  line-height: 1.8;
  color: var(--ink);
  margin: 0 0 0.5rem;
}

.ready-card p {
  font-size: 0.92rem;
  line-height: 2.0;
  color: var(--ink-soft);
  margin: 0 0 1rem;
}

.ready-meta {
  list-style: none;
  padding: 0;
  margin: 0 0 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.ready-meta li {
  font-size: 0.82rem;
  color: var(--ink-muted);
  line-height: 1.8;
}

.ready-meta li::before {
  content: "— ";
  color: var(--border-dark);
}

.ready-btn {
  display: block;
  width: 100%;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.95rem;
  line-height: 1.8;
  text-decoration: none;
  font-family: inherit;
  text-align: center;
  transition: opacity 0.15s;
}

.ready-btn:hover {
  opacity: 0.88;
}

.ready-btn-primary {
  background: var(--gold);
  color: #fff;
}

.ready-btn-secondary {
  background: var(--teal);
  color: #fff;
}

.ready-tiers {
  border-top: 1px solid var(--border);
  padding-top: 1.75rem;
  margin-bottom: 1.75rem;
}

.ready-tiers-label {
  font-size: 0.85rem;
  color: var(--ink-muted);
  margin: 0 0 0.75rem;
}

.ready-tiers-row {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.ready-tier {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.82rem;
  color: var(--ink-soft);
  direction: ltr;
}

.tier-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.tier-1 { background: #d4edea; border: 1.5px solid var(--teal); }
.tier-2 { background: var(--gold-pale); border: 1.5px solid var(--gold); }
.tier-3 { background: #b8860b33; border: 1.5px solid var(--gold); }
.tier-4 { background: var(--teal); border: 1.5px solid var(--teal); }

.ready-footer-links {
  font-size: 0.85rem;
  color: var(--ink-muted);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.6rem;
}

.ready-link-read {
  color: var(--teal);
  text-decoration: none;
}

.ready-link-read:hover {
  text-decoration: underline;
}

.ready-link-ext {
  color: var(--ink-muted);
  text-decoration: none;
  direction: ltr;
}

.ready-link-ext:hover {
  color: var(--ink-soft);
}

.ready-divider {
  color: var(--border-dark);
}
</style>
