---
import Base from '../../layouts/Base.astro';
---
<Base
  title="شراکت دار — اردو اے آئی"
  description="اردو اے آئی کے شراکت داروں میں S&P Global Foundation، ElevenLabs، Internet Society، AVPN اور Google.org شامل ہیں۔"
  canonical="https://urduai.org/partners/"
  adsense={false}
>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href="/">ہوم</a></li><li aria-current="page">شراکت دار</li></ol>
    </nav>
    <h1>ہمارے شراکت دار</h1>
    <div class="prose">
      <div class="post-grid">
        <div class="card"><h3 class="card__title">S&amp;P Global Foundation</h3><p class="card__excerpt">StepForward Finalist</p></div>
        <div class="card"><h3 class="card__title">ElevenLabs</h3><p class="card__excerpt">Official Case Study</p></div>
        <div class="card"><h3 class="card__title">Internet Society</h3><p class="card__excerpt">ڈیجیٹل شمولیت کے لیے حمایت</p></div>
        <div class="card"><h3 class="card__title">AVPN</h3><p class="card__excerpt">ایشیا وینچر فلانتھروپی نیٹ ورک</p></div>
        <div class="card"><h3 class="card__title">Google.org</h3><p class="card__excerpt">تکنیکی اور مالی معاونت</p></div>
      </div>
      <p style="margin-block-start:var(--space-lg);">
        شراکت داری کے لیے: <a href="/contact/">ہم سے رابطہ کریں</a>
      </p>
    </div>
  </div>
</Base>
