---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="شراکت دار — اردو اے آئی"
  description="اردو اے آئی اور Wang Lab of Innovation (WALI) کے ساتھ کام کرنے والے شراکت دار اور معاون ادارے جانیے۔"
  canonical="https://urduai.org/partners/"
  adsense={false}
>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">شراکت دار</li></ol>
    </nav>
    <h1>ہمارے شراکت دار</h1>
    <div class="prose">
      <p>
        اردو اے آئی کی بڑھتی ہوئی پہنچ اور اعتماد کی ایک اہم وجہ وہ ادارہ جاتی شراکت دار ہیں
        جنہوں نے اس مشن کی اہمیت کو تسلیم کیا۔ یہ پلیٹ فارم <strong>Wang Lab of Innovation (WALI)</strong>
        کی ایک پروڈکٹ ہے، اور اسی بنیاد پر مختلف قومی اور بین الاقوامی اداروں کے ساتھ تعاون ممکن ہوا۔
      </p>
      <p>
        ہماری شراکت داریوں کا مقصد صرف نام جڑنا نہیں، بلکہ اردو بولنے والی کمیونٹی کے لیے
        اے آئی تعلیم، رسائی، اور مواقع کو بہتر بنانا ہے۔
      </p>
      <div class="post-grid">
        <div class="card"><h3 class="card__title">S&amp;P Global Foundation</h3><p class="card__excerpt">StepForward Finalist</p></div>
        <div class="card"><h3 class="card__title">ElevenLabs</h3><p class="card__excerpt">Official Case Study</p></div>
        <div class="card"><h3 class="card__title">Internet Society</h3><p class="card__excerpt">ڈیجیٹل شمولیت کے لیے حمایت</p></div>
        <div class="card"><h3 class="card__title">AVPN</h3><p class="card__excerpt">ایشیا وینچر فلانتھروپی نیٹ ورک</p></div>
        <div class="card"><h3 class="card__title">Google.org</h3><p class="card__excerpt">تکنیکی اور مالی معاونت</p></div>
      </div>
      <h2>ہم کن قسم کی شراکت داریوں کے لیے تیار ہیں</h2>
      <ul>
        <li>اردو زبان میں اے آئی تعلیم اور ڈیجیٹل شمولیت</li>
        <li>اساتذہ، طلبہ، اور نوجوانوں کے لیے تربیتی پروگرام</li>
        <li>مقامی زبانوں میں ٹیکنالوجی کے استعمال کو فروغ دینے والے منصوبے</li>
        <li>تحقیق، آؤٹ ریچ، اور عوامی آگاہی پر مبنی مشترکہ اقدامات</li>
      </ul>
      <p style="margin-block-start:var(--space-lg);">
        شراکت داری کے لیے: <a href={`${base}/contact/`}>ہم سے رابطہ کریں</a>
      </p>
    </div>
  </div>
</Base>
