---
import Base from '../../layouts/Base.astro';
import InlineNewsletter from '../../components/InlineNewsletter.astro';
import { tools } from '../../data/tools';

export const prerender = true;

const categories = [...new Set(tools.map(t => t.category))];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalTools = tools.length;
const freeTools = tools.filter(t => t.pricing === 'free').length;
const trendingTools = tools.filter(t => t.trending).length;
const toolAnchor = (name: string) => `tool-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const quickPaths = [
  { title: 'پہلی بار AI استعمال کر رہے ہیں', href: '/learn/artificial-intelligence/', text: 'AI کی مختصر اور آسان تعریف' },
  { title: 'اردو میں Gemini چلانا ہے', href: '/learn/google-gemini/', text: 'Google Gemini پہلے سمجھیں' },
  { title: 'Google AI Studio سیکھنا ہے', href: '/blog/google-ai-studio-kia-hai/', text: 'API، Build Mode اور prototype' },
  { title: 'مفت AI کورس چاہیے', href: '/guides/free-ai-course-urdu/', text: 'صحیح ترتیب سے course شروع کریں' },
];

const toolsSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "AI Tools in Urdu",
    "description": "پاکستانی صارفین کے لیے منتخب AI tools کی اردو ڈائریکٹری",
    "numberOfItems": tools.length,
    "itemListElement": tools.map((tool, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://urduai.org/tools/#${toolAnchor(tool.name)}`,
      "name": tool.name,
      "item": {
        "@type": "SoftwareApplication",
        "name": tool.name,
        "alternateName": tool.urduName,
        "applicationCategory": tool.category,
        "url": tool.url,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "پاکستان میں کون سے AI tools سے شروع کرنا بہتر ہے؟",
        "acceptedAnswer": { "@type": "Answer", "text": "شروع میں ChatGPT، Gemini، Claude، NotebookLM اور Google AI Studio دیکھیں۔ روزمرہ سوالات کے لیے Gemini، لکھائی کے لیے Claude، اور prototype کے لیے Google AI Studio بہتر آغاز ہیں۔" },
      },
      {
        "@type": "Question",
        "name": "کیا اس ڈائریکٹری کے tools پاکستان میں چلتے ہیں؟",
        "acceptedAnswer": { "@type": "Answer", "text": "ڈائریکٹری میں Pakistan badge والے tools پاکستانی صارفین کے لیے منتخب کیے گئے ہیں۔ قیمت، limits اور دستیابی وقت کے ساتھ بدل سکتی ہے، اس لیے اہم کام سے پہلے آفیشل سائٹ ضرور چیک کریں۔" },
      },
      {
        "@type": "Question",
        "name": "AI tools سیکھنے کا آسان راستہ کیا ہے؟",
        "acceptedAnswer": { "@type": "Answer", "text": "پہلے AI کی بنیادی تعریف پڑھیں، پھر Gemini یا ChatGPT میں اردو پرامٹس آزمائیں، اس کے بعد Google AI Studio یا اردو اے آئی ماسٹرکلاس سے عملی مشق کریں۔" },
      },
    ],
  },
];
---

<Base
  title="AI Tools in Urdu — پاکستان کے لیے منتخب اے آئی ٹولز"
  description="پاکستانی صارفین کے لیے منتخب AI tools: لکھائی، تصویر، ویڈیو، آواز، کوڈنگ اور تحقیق کے ٹولز ایک جگہ، اردو گائیڈز کے ساتھ۔"
  canonical="https://urduai.org/tools/"
  adsense={true}
  schema={toolsSchema}
>
  <!-- Hero Section -->
  <section class="tools-hero">
    <div class="container">
      <nav aria-label="بریڈکرمب">
        <ol class="breadcrumb breadcrumb--light">
          <li><a href={`${base}/`}>ہوم</a></li>
          <li aria-current="page">اے آئی ٹولز</li>
        </ol>
      </nav>
      <h1 class="tools-hero__title">پاکستان کے لیے منتخب AI Tools</h1>
      <p class="tools-hero__sub">
        یہ ڈائریکٹری پاکستانی صارفین کے لیے منتخب AI tools کو ایک جگہ جمع کرتی ہے: ChatGPT، Gemini، Claude، تصویر، ویڈیو، آواز، کوڈنگ اور تحقیق کے ٹولز، ہر ایک کے ساتھ آسان اردو وضاحت۔
      </p>
      <div class="tools-hero__stats">
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{totalTools}</span>
          <span class="tools-hero__stat-label">ٹولز</span>
        </div>
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{freeTools}</span>
          <span class="tools-hero__stat-label">مفت پلان</span>
        </div>
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{trendingTools}</span>
          <span class="tools-hero__stat-label">ٹرینڈنگ</span>
        </div>
      </div>

      <!-- Search -->
      <div class="tools-search-wrap">
        <input
          type="search"
          class="tools-search"
          id="tools-search"
          placeholder="ٹول تلاش کریں — مثلاً ChatGPT, ویڈیو, تصویر..."
          autocomplete="off"
        />
        <svg class="tools-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </section>

  <div class="container" style="margin-block-start: var(--space-lg);">
    <!-- Category filter tabs -->
    <div class="tools-filters" role="tablist" aria-label="زمرہ فلٹر">
      <button class="tools-filter tools-filter--active" data-filter="all">
        سب
        <span class="tools-filter__count">{totalTools}</span>
      </button>
      {categories.map(cat => {
        const count = tools.filter(t => t.category === cat).length;
        return (
          <button class="tools-filter" data-filter={cat}>
            {cat}
            <span class="tools-filter__count">{count}</span>
          </button>
        );
      })}
    </div>

    <section class="tools-paths" aria-labelledby="tools-paths-title">
      <div class="tools-paths__intro">
        <h2 id="tools-paths-title">کس کام کے لیے کون سا راستہ چنیں؟</h2>
        <p>
          اگر آپ پہلی بار AI tools دیکھ رہے ہیں تو سب tools ایک ساتھ آزمانے کی ضرورت نہیں۔ اپنے مقصد کے مطابق ایک راستہ چنیں، پھر اسی سے جڑا ہوا tool کھولیں۔
        </p>
      </div>
      <div class="tools-paths__links">
        {quickPaths.map(path => (
          <a href={path.href} class="tools-path">
            <strong>{path.title}</strong>
            <span>{path.text}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Tools grid -->
    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => (
        <article
          class="tool-card"
          id={toolAnchor(tool.name)}
          data-category={tool.category}
          data-name={tool.name.toLowerCase()}
          data-urdu={tool.urduName}
          data-desc={tool.description}
        >
          {tool.trending && (
            <span class="tool-card__trending">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="currentColor"/>
              </svg>
              ٹرینڈنگ
            </span>
          )}

          <div class="tool-card__header">
            <img class="tool-card__logo" src={tool.logo} alt={tool.name} width="40" height="40" loading="lazy" />
            <div class="tool-card__title-group">
              <h2 class="tool-card__name">{tool.name}</h2>
              <p class="tool-card__urdu-name">{tool.urduName}</p>
            </div>
          </div>

          <p class="tool-card__by">{tool.by}</p>
          <p class="tool-card__desc">{tool.description}</p>

          <div class="tool-card__badges">
            <span class="badge badge--teal">{tool.category}</span>
            <span class={`badge ${tool.pricing === 'free' ? 'badge--green' : tool.pricing === 'freemium' ? 'badge--blue' : 'badge--muted'}`}>
              {tool.pricingLabel}
            </span>
            {tool.pakistan && (
              <span class="badge badge--green">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-1px;margin-inline-end:3px;">
                  <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                پاکستان
              </span>
            )}
          </div>

          <div class="tool-card__actions">
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-playstore tool-card__btn"
            >
              ٹول کھولیں
            </a>
            {tool.guideUrl && (
              <a href={tool.guideUrl} class="tool-card__guide-link">
                اردو گائیڈ ←
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- No results message -->
    <div class="tools-no-results" id="tools-no-results" style="display:none;">
      <p>کوئی ٹول نہیں ملا — دوسرے الفاظ سے تلاش کریں</p>
    </div>

    <!-- Last updated -->
    <p class="tools-updated">
      آخری اپڈیٹ: جون 2026 — ہر ٹول پاکستان سے ٹیسٹ کیا گیا
    </p>

    <section class="tools-faq" aria-labelledby="tools-faq-title">
      <h2 id="tools-faq-title">عام سوالات</h2>
      <details>
        <summary>پاکستان میں کون سے AI tools سے شروع کرنا بہتر ہے؟</summary>
        <p>شروع میں ChatGPT، Gemini، Claude، NotebookLM اور Google AI Studio دیکھیں۔ روزمرہ سوالات کے لیے Gemini، لکھائی کے لیے Claude، اور prototype یا API تجربے کے لیے Google AI Studio بہتر آغاز ہے۔</p>
      </details>
      <details>
        <summary>کیا اس ڈائریکٹری کے tools پاکستان میں چلتے ہیں؟</summary>
        <p>Pakistan badge والے tools پاکستانی صارفین کے لیے منتخب کیے گئے ہیں۔ قیمت، limits اور دستیابی وقت کے ساتھ بدل سکتی ہے، اس لیے اہم کام سے پہلے tool کی آفیشل سائٹ ضرور چیک کریں۔</p>
      </details>
      <details>
        <summary>AI tools سیکھنے کا آسان راستہ کیا ہے؟</summary>
        <p>پہلے <a href="/learn/artificial-intelligence/">مصنوعی ذہانت کیا ہے؟</a> سے بنیاد سمجھیں، پھر <a href="/learn/google-gemini/">Gemini</a> کا مطلب پڑھیں، اور اس کے بعد <a href="/guides/free-ai-course-urdu/">مفت AI کورس اردو میں</a> یا <a href="/courses/masterclass/">ماسٹرکلاس</a> سے عملی مشق کریں۔</p>
      </details>
    </section>
  </div>

  <div class="container" style="margin-block-start: var(--space-2xl);">
    <InlineNewsletter />
  </div>
</Base>

<style>
  /* ── Hero ── */
  .tools-hero {
    background: var(--ink);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .breadcrumb--light a { color: var(--gold-pale); }
  .breadcrumb--light li { color: var(--gold-light); }
  .breadcrumb--light li::before { color: var(--gold-pale); opacity: 0.5; }

  .tools-hero__title {
    font-size: var(--text-h1);
    color: var(--gold-light);
    margin-block-end: var(--space-sm);
  }

  .tools-hero__sub {
    color: var(--gold-pale);
    font-size: var(--text-base);
    line-height: var(--lh-prose);
    margin-block-end: var(--space-lg);
  }

  .tools-hero__stats {
    display: flex;
    gap: var(--space-xl);
    margin-block-end: var(--space-lg);
    flex-wrap: wrap;
  }

  .tools-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
  }

  .tools-hero__stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }

  .tools-hero__stat-label {
    font-size: var(--text-sm);
    color: var(--gold-pale);
  }

  /* ── Search ── */
  .tools-search-wrap {
    position: relative;
    max-width: 480px;
  }

  .tools-search {
    width: 100%;
    padding: 0.7em 1em;
    padding-inline-start: 2.8em;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font-family: inherit;
    font-size: var(--text-base);
    line-height: var(--lh-body);
    transition: border-color 0.2s, background 0.2s;
  }

  .tools-search::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .tools-search:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(255, 255, 255, 0.12);
  }

  .tools-search__icon {
    position: absolute;
    inset-inline-start: 0.8em;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  /* ── Filters ── */
  .tools-filters {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-block-end: var(--space-lg);
  }

  .tools-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 1em;
    border: 1.5px solid var(--border);
    border-radius: 20px;
    background: var(--paper-card);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all 0.15s;
    line-height: var(--lh-body);
  }

  .tools-filter__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4em;
    height: 1.4em;
    font-size: 0.75rem;
    border-radius: 50%;
    background: var(--paper-warm);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .tools-filter:hover,
  .tools-filter--active {
    background: var(--navy);
    color: white;
    border-color: var(--navy);
  }

  .tools-filter:hover .tools-filter__count,
  .tools-filter--active .tools-filter__count {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  /* ── Guided paths ── */
  .tools-paths {
    border-block: 1px solid var(--border);
    padding-block: var(--space-lg);
    margin-block-end: var(--space-lg);
  }

  .tools-paths__intro {
    max-width: 760px;
    margin-block-end: var(--space-md);
  }

  .tools-paths__intro h2 {
    font-size: var(--text-h2);
    line-height: var(--lh-heading);
    margin-block-end: var(--space-xs);
  }

  .tools-paths__intro p {
    color: var(--ink-soft);
    line-height: var(--lh-prose);
    margin: 0;
  }

  .tools-paths__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-sm);
  }

  .tools-path {
    display: block;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-sm);
    background: var(--paper-card);
    color: var(--ink);
    text-decoration: none;
  }

  .tools-path:hover {
    border-color: var(--teal);
  }

  .tools-path strong,
  .tools-path span {
    display: block;
  }

  .tools-path span {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block-start: 0.2em;
  }

  /* ── Grid ── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  /* ── Card ── */
  .tool-card {
    position: relative;
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .tool-card:hover {
    border-color: var(--navy);
    box-shadow: 0 6px 20px rgba(29, 85, 159, 0.1);
    transform: translateY(-2px);
  }

  .tool-card__trending {
    position: absolute;
    top: -8px;
    inset-inline-end: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.2em 0.7em;
    background: var(--gold);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 10px;
    line-height: 1.6;
  }

  .tool-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .tool-card__logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    padding: 4px;
  }

  .tool-card__name {
    font-size: var(--text-base);
    margin: 0;
    color: var(--ink);
    line-height: 1.4;
  }

  .tool-card__urdu-name {
    font-size: var(--text-sm);
    color: var(--navy);
    margin: 0;
    line-height: 1.6;
  }

  .tool-card__by {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: var(--lh-body);
    margin: 0;
    flex: 1;
  }

  .tool-card__badges {
    display: flex;
    gap: 0.4em;
    flex-wrap: wrap;
    margin-block: var(--space-xs);
  }

  .badge--green {
    background: #d4edda;
    color: #155724;
    border-color: #c3e6cb;
  }

  .badge--blue {
    background: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
  }

  .badge--muted {
    background: var(--paper-warm);
    color: var(--ink-muted);
    border-color: var(--border);
  }

  .tool-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-block-start: var(--space-xs);
  }

  .tool-card__btn {
    font-size: 0.9rem;
    padding: 0.5em 1.2em;
  }

  .tool-card__guide-link {
    color: var(--teal);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .tool-card__guide-link:hover {
    text-decoration: underline;
  }

  .tool-card[data-hidden] {
    display: none;
  }

  /* ── No results ── */
  .tools-no-results {
    text-align: center;
    padding: var(--space-2xl);
    color: var(--ink-muted);
    font-size: var(--text-base);
  }

  /* ── Updated note ── */
  .tools-updated {
    text-align: center;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border);
  }

  .tools-faq {
    max-width: 820px;
    margin-inline: auto;
    margin-block: var(--space-xl);
  }

  .tools-faq h2 {
    font-size: var(--text-h2);
    line-height: var(--lh-heading);
    margin-block-end: var(--space-sm);
  }

  .tools-faq details {
    border-block-start: 1px solid var(--border);
    padding-block: var(--space-sm);
  }

  .tools-faq details:last-child {
    border-block-end: 1px solid var(--border);
  }

  .tools-faq summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 700;
  }

  .tools-faq p {
    color: var(--ink-soft);
    line-height: var(--lh-prose);
    margin-block: var(--space-xs) 0;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tools-hero__stats {
      gap: var(--space-lg);
    }

    .tools-hero__stat-num {
      font-size: 1.6rem;
    }
  }
</style>

<script>
  // Category filter
  const filters = document.querySelectorAll('.tools-filter');
  const cards = document.querySelectorAll('.tool-card');
  const noResults = document.getElementById('tools-no-results');
  const searchInput = document.getElementById('tools-search') as HTMLInputElement;

  let activeCategory = 'all';

  function updateVisibility() {
    const query = searchInput?.value?.toLowerCase().trim() || '';
    let visibleCount = 0;

    cards.forEach(card => {
      const category = card.getAttribute('data-category') || '';
      const name = card.getAttribute('data-name') || '';
      const urdu = card.getAttribute('data-urdu') || '';
      const desc = card.getAttribute('data-desc') || '';

      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = !query ||
        name.includes(query) ||
        urdu.includes(query) ||
        desc.includes(query) ||
        category.includes(query);

      if (matchesCategory && matchesSearch) {
        card.removeAttribute('data-hidden');
        visibleCount++;
      } else {
        card.setAttribute('data-hidden', '');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('tools-filter--active'));
      btn.classList.add('tools-filter--active');
      activeCategory = btn.getAttribute('data-filter') || 'all';
      updateVisibility();
    });
  });

  searchInput?.addEventListener('input', updateVisibility);
</script>
