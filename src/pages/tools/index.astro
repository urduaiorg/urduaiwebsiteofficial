const categories = [...new Set(tools.map(t => t.category))];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="اے آئی ٹولز — اردو اے آئی | پاکستان میں بہترین اے آئی ٹولز"
  description="پاکستان میں استعمال ہونے والے بہترین اے آئی ٹولز — اردو میں مکمل گائیڈ۔ ChatGPT، Gemini، Claude اور مزید۔"
  canonical="https://urduai.org/tools/"
  adsense={true}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li aria-current="page">اے آئی ٹولز</li>
      </ol>
    </nav>

    <h1>اے آئی ٹولز</h1>
    <p class="text-muted" style="margin-block-end: var(--space-lg);">
      پاکستان میں چلنے والے بہترین اے آئی ٹولز — کون سا مفت ہے، کون سا بہتر ہے، اور کہاں سے شروع کریں
    </p>

    <!-- Category filter tabs -->
    <div class="tools-filters" role="tablist" aria-label="زمرہ بہ زمرہ فلٹر">
      <button class="tools-filter tools-filter--active" data-filter="all">سب</button>
      {categories.map(cat => (
        <button class="tools-filter" data-filter={cat}>{cat}</button>
      ))}
    </div>

    <!-- Tools grid -->
    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => (
        <article
          class="tool-card"
          data-category={tool.category}
          id={`tool-${tool.name.toLowerCase().replace(/\s+/g, '-')}`}
        >
          <div class="tool-card__header">
            <div class="tool-card__icon" aria-hidden="true" set:html={tool.icon} />
            <div class="tool-card__title-group">
              <h2 class="tool-card__name">{tool.name}</h2>
              <p class="tool-card__urdu-name">{tool.urduName}</p>
            </div>
          </div>

          <p class="tool-card__by">{tool.by}</p>
          <p class="tool-card__desc">{tool.description}</p>

          <div class="tool-card__badges">
            <span class="badge badge--teal">{tool.category}</span>
            <span class={`badge ${tool.free ? 'badge--green' : 'badge--muted'}`}>
              {tool.freeLabel}
            </span>
            {tool.pakistan && (
              <span class="badge badge--green">پاکستان میں دستیاب</span>
            )}
          </div>

          <div class="tool-card__actions">
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-playstore tool-card__btn"
            >
              ٹول کھولیں
            </a>
            {tool.guideUrl && (
              <a href={tool.guideUrl} class="tool-card__guide-link">
                اردو گائیڈ پڑھیں ←
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="container" style="margin-block-start: var(--space-2xl);">
    <InlineNewsletter />
  </div>
</Base>

<style>
  .tools-filters {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-block-end: var(--space-lg);
  }

  .tools-filter {
    padding: 0.4em 1em;
    border: 1.5px solid var(--border);
    border-radius: 20px;
    background: var(--paper-card);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all 0.15s;
    line-height: var(--lh-body);
  }

  .tools-filter:hover,
  .tools-filter--active {
    background: var(--navy);
    color: white;
    border-color: var(--navy);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .tool-card {
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .tool-card:hover {
    border-color: var(--navy);
    box-shadow: 0 4px 16px rgba(29, 85, 159, 0.08);
  }

  .tool-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .tool-card__icon {
    flex-shrink: 0;
    line-height: 0;
  }

  .tool-card__name {
    font-size: var(--text-base);
    margin: 0;
    color: var(--ink);
    line-height: 1.4;
  }

  .tool-card__urdu-name {
    font-size: var(--text-sm);
    color: var(--navy);
    margin: 0;
    line-height: 1.6;
  }

  .tool-card__by {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: var(--lh-body);
    margin: 0;
    flex: 1;
  }

  .tool-card__badges {
    display: flex;
    gap: 0.4em;
    flex-wrap: wrap;
    margin-block: var(--space-xs);
  }

  .badge--green {
    background: #d4edda;
    color: #155724;
    border-color: #c3e6cb;
  }

  .badge--muted {
    background: var(--paper-warm);
    color: var(--ink-muted);
    border-color: var(--border);
  }

  .tool-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-block-start: var(--space-xs);
  }

  .tool-card__btn {
    font-size: 0.9rem;
    padding: 0.5em 1.2em;
  }

  .tool-card__guide-link {
    color: var(--teal);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .tool-card__guide-link:hover {
    text-decoration: underline;
  }

  .tool-card[data-hidden] {
    display: none;
  }
</style>

<script>
  const filters = document.querySelectorAll('.tools-filter');
  const cards = document.querySelectorAll('.tool-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('tools-filter--active'));
      btn.classList.add('tools-filter--active');

      const filter = btn.getAttribute('data-filter');
      cards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.removeAttribute('data-hidden');
        } else {
          card.setAttribute('data-hidden', '');
        }
      });
    });
  });
</script>
