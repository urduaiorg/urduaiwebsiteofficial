---
import Base from '../../layouts/Base.astro';
import InlineNewsletter from '../../components/InlineNewsletter.astro';
import { tools } from '../../data/tools';

export const prerender = true;

const categories = [...new Set(tools.map(t => t.category))];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalTools = tools.length;
const freeTools = tools.filter(t => t.pricing === 'free').length;
const trendingTools = tools.filter(t => t.trending).length;
---

<Base
  title="اے آئی ٹولز — اردو اے آئی | پاکستان میں 50 بہترین مفت اے آئی ٹولز 2026"
  description="پاکستان میں بغیر VPN چلنے والے 50 بہترین اے آئی ٹولز — مفت، موبائل فرینڈلی۔ ChatGPT، Gemini، Claude، Kling، ElevenLabs اور بہت کچھ۔"
  canonical="https://urduai.org/tools/"
  adsense={true}
>
  <!-- Hero Section -->
  <section class="tools-hero">
    <div class="container">
      <nav aria-label="بریڈکرمب">
        <ol class="breadcrumb breadcrumb--light">
          <li><a href={`${base}/`}>ہوم</a></li>
          <li aria-current="page">اے آئی ٹولز</li>
        </ol>
      </nav>
      <h1 class="tools-hero__title">پاکستان کے لیے بہترین اے آئی ٹولز</h1>
      <p class="tools-hero__sub">
        {totalTools} ٹولز، ہر ایک آزمایا ہوا — بغیر VPN، موبائل پر، اردو بولنے والوں کے لیے
      </p>
      <div class="tools-hero__stats">
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{totalTools}</span>
          <span class="tools-hero__stat-label">ٹولز</span>
        </div>
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{freeTools}</span>
          <span class="tools-hero__stat-label">مکمل مفت</span>
        </div>
        <div class="tools-hero__stat">
          <span class="tools-hero__stat-num" dir="ltr">{trendingTools}</span>
          <span class="tools-hero__stat-label">ٹرینڈنگ</span>
        </div>
      </div>

      <!-- Search -->
      <div class="tools-search-wrap">
        <input
          type="search"
          class="tools-search"
          id="tools-search"
          placeholder="ٹول تلاش کریں — مثلاً ChatGPT, ویڈیو, تصویر..."
          autocomplete="off"
        />
        <svg class="tools-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </section>

  <div class="container" style="margin-block-start: var(--space-lg);">
    <!-- Category filter tabs -->
    <div class="tools-filters" role="tablist" aria-label="زمرہ فلٹر">
      <button class="tools-filter tools-filter--active" data-filter="all">
        سب
        <span class="tools-filter__count">{totalTools}</span>
      </button>
      {categories.map(cat => {
        const count = tools.filter(t => t.category === cat).length;
        return (
          <button class="tools-filter" data-filter={cat}>
            {cat}
            <span class="tools-filter__count">{count}</span>
          </button>
        );
      })}
    </div>

    <!-- Tools grid -->
    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => (
        <article
          class="tool-card"
          id={tool.name.toLowerCase().replace(/\s+/g, '-')}
          data-category={tool.category}
          data-name={tool.name.toLowerCase()}
          data-urdu={tool.urduName}
          data-desc={tool.description}
        >
          {tool.trending && (
            <span class="tool-card__trending">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="currentColor"/>
              </svg>
              ٹرینڈنگ
            </span>
          )}

          <div class="tool-card__header">
            <img class="tool-card__logo" src={tool.logo} alt={tool.name} width="40" height="40" loading="lazy" />
            <div class="tool-card__title-group">
              <h2 class="tool-card__name">{tool.name}</h2>
              <p class="tool-card__urdu-name">{tool.urduName}</p>
            </div>
          </div>

          <p class="tool-card__by">{tool.by}</p>
          <p class="tool-card__desc">{tool.description}</p>

          <div class="tool-card__badges">
            <span class="badge badge--teal">{tool.category}</span>
            <span class={`badge ${tool.pricing === 'free' ? 'badge--green' : tool.pricing === 'freemium' ? 'badge--blue' : 'badge--muted'}`}>
              {tool.pricingLabel}
            </span>
            {tool.pakistan && (
              <span class="badge badge--green">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-1px;margin-inline-end:3px;">
                  <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                پاکستان
              </span>
            )}
          </div>

          <div class="tool-card__actions">
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-playstore tool-card__btn"
            >
              ٹول کھولیں
            </a>
            {tool.guideUrl && (
              <a href={tool.guideUrl} class="tool-card__guide-link">
                اردو گائیڈ ←
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- No results message -->
    <div class="tools-no-results" id="tools-no-results" style="display:none;">
      <p>کوئی ٹول نہیں ملا — دوسرے الفاظ سے تلاش کریں</p>
    </div>

    <!-- Last updated -->
    <p class="tools-updated">
      آخری اپڈیٹ: اپریل 2026 — ہر ٹول پاکستان سے ٹیسٹ کیا گیا
    </p>
  </div>

  <div class="container" style="margin-block-start: var(--space-2xl);">
    <InlineNewsletter />
  </div>
</Base>

<style>
  /* ── Hero ── */
  .tools-hero {
    background: var(--ink);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .breadcrumb--light a { color: var(--gold-pale); }
  .breadcrumb--light li { color: var(--gold-light); }
  .breadcrumb--light li::before { color: var(--gold-pale); opacity: 0.5; }

  .tools-hero__title {
    font-size: var(--text-h1);
    color: var(--gold-light);
    margin-block-end: var(--space-sm);
  }

  .tools-hero__sub {
    color: var(--gold-pale);
    font-size: var(--text-base);
    line-height: var(--lh-prose);
    margin-block-end: var(--space-lg);
  }

  .tools-hero__stats {
    display: flex;
    gap: var(--space-xl);
    margin-block-end: var(--space-lg);
    flex-wrap: wrap;
  }

  .tools-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
  }

  .tools-hero__stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }

  .tools-hero__stat-label {
    font-size: var(--text-sm);
    color: var(--gold-pale);
  }

  /* ── Search ── */
  .tools-search-wrap {
    position: relative;
    max-width: 480px;
  }

  .tools-search {
    width: 100%;
    padding: 0.7em 1em;
    padding-inline-start: 2.8em;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font-family: inherit;
    font-size: var(--text-base);
    line-height: var(--lh-body);
    transition: border-color 0.2s, background 0.2s;
  }

  .tools-search::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .tools-search:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(255, 255, 255, 0.12);
  }

  .tools-search__icon {
    position: absolute;
    inset-inline-start: 0.8em;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  /* ── Filters ── */
  .tools-filters {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-block-end: var(--space-lg);
  }

  .tools-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 1em;
    border: 1.5px solid var(--border);
    border-radius: 20px;
    background: var(--paper-card);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all 0.15s;
    line-height: var(--lh-body);
  }

  .tools-filter__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4em;
    height: 1.4em;
    font-size: 0.75rem;
    border-radius: 50%;
    background: var(--paper-warm);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .tools-filter:hover,
  .tools-filter--active {
    background: var(--navy);
    color: white;
    border-color: var(--navy);
  }

  .tools-filter:hover .tools-filter__count,
  .tools-filter--active .tools-filter__count {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  /* ── Grid ── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  /* ── Card ── */
  .tool-card {
    position: relative;
    background: var(--paper-card);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .tool-card:hover {
    border-color: var(--navy);
    box-shadow: 0 6px 20px rgba(29, 85, 159, 0.1);
    transform: translateY(-2px);
  }

  .tool-card__trending {
    position: absolute;
    top: -8px;
    inset-inline-end: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.2em 0.7em;
    background: var(--gold);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 10px;
    line-height: 1.6;
  }

  .tool-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .tool-card__logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    padding: 4px;
  }

  .tool-card__name {
    font-size: var(--text-base);
    margin: 0;
    color: var(--ink);
    line-height: 1.4;
  }

  .tool-card__urdu-name {
    font-size: var(--text-sm);
    color: var(--navy);
    margin: 0;
    line-height: 1.6;
  }

  .tool-card__by {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: var(--lh-body);
    margin: 0;
    flex: 1;
  }

  .tool-card__badges {
    display: flex;
    gap: 0.4em;
    flex-wrap: wrap;
    margin-block: var(--space-xs);
  }

  .badge--green {
    background: #d4edda;
    color: #155724;
    border-color: #c3e6cb;
  }

  .badge--blue {
    background: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
  }

  .badge--muted {
    background: var(--paper-warm);
    color: var(--ink-muted);
    border-color: var(--border);
  }

  .tool-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-block-start: var(--space-xs);
  }

  .tool-card__btn {
    font-size: 0.9rem;
    padding: 0.5em 1.2em;
  }

  .tool-card__guide-link {
    color: var(--teal);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .tool-card__guide-link:hover {
    text-decoration: underline;
  }

  .tool-card[data-hidden] {
    display: none;
  }

  /* ── No results ── */
  .tools-no-results {
    text-align: center;
    padding: var(--space-2xl);
    color: var(--ink-muted);
    font-size: var(--text-base);
  }

  /* ── Updated note ── */
  .tools-updated {
    text-align: center;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tools-hero__stats {
      gap: var(--space-lg);
    }

    .tools-hero__stat-num {
      font-size: 1.6rem;
    }
  }
</style>

<script>
  // Category filter
  const filters = document.querySelectorAll('.tools-filter');
  const cards = document.querySelectorAll('.tool-card');
  const noResults = document.getElementById('tools-no-results');
  const searchInput = document.getElementById('tools-search') as HTMLInputElement;

  let activeCategory = 'all';

  function updateVisibility() {
    const query = searchInput?.value?.toLowerCase().trim() || '';
    let visibleCount = 0;

    cards.forEach(card => {
      const category = card.getAttribute('data-category') || '';
      const name = card.getAttribute('data-name') || '';
      const urdu = card.getAttribute('data-urdu') || '';
      const desc = card.getAttribute('data-desc') || '';

      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = !query ||
        name.includes(query) ||
        urdu.includes(query) ||
        desc.includes(query) ||
        category.includes(query);

      if (matchesCategory && matchesSearch) {
        card.removeAttribute('data-hidden');
        visibleCount++;
      } else {
        card.setAttribute('data-hidden', '');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('tools-filter--active'));
      btn.classList.add('tools-filter--active');
      activeCategory = btn.getAttribute('data-filter') || 'all';
      updateVisibility();
    });
  });

  searchInput?.addEventListener('input', updateVisibility);
</script>
