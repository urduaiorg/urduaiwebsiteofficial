---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base
  title="بلاگ — اردو اے آئی | اے آئی خبریں اور تجزیے"
  description="اردو اے آئی بلاگ پر پاکستانی نقطہ نظر سے اے آئی کی تازہ ترین خبریں، ٹول گائیڈز اور تجزیے پڑھیں۔"
  canonical="https://urduai.org/blog/"
  adsense={true}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href="/">ہوم</a></li>
        <li aria-current="page">بلاگ</li>
      </ol>
    </nav>

    <h1>بلاگ</h1>
    <p class="text-muted" style="margin-block-end: var(--space-lg);">
      مصنوعی ذہانت کی تازہ ترین خبریں — پاکستانی نقطہ نظر سے
    </p>

    <div class="post-grid">
      {posts.map(post => (
        <article class="card">
          {post.data.image ? (
            <img
              src={post.data.image}
              alt={post.data.title}
              width="400"
              height="225"
              loading="lazy"
              style="border-radius:6px; margin-block-end:var(--space-sm); width:100%; height:auto; object-fit:contain;"
            />
          ) : (
            <div class="card__image-placeholder">
              <span>Urdu Ai</span>
            </div>
          )}
          <p class="card__meta">
            <span class="badge">{post.data.category}</span>
            &nbsp;
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('ur-PK', { year:'numeric', month:'long', day:'numeric' })}
            </time>
          </p>
          <h2 class="card__title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p class="card__excerpt">{post.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</Base>
