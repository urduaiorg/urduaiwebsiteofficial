---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="شرائط استعمال — اردو اے آئی"
  description="اردو اے آئی کے استعمال کی شرائط و ضوابط۔"
  canonical="https://urduai.org/terms/"
  adsense={false}
>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">شرائط</li></ol>
    </nav>
    <h1>شرائط استعمال</h1>
    <div class="prose">
      <p class="text-muted">آخری اپڈیٹ: اپریل ۲۰۲۶</p>
      <h2>استعمال کی شرائط</h2>
      <p>urduai.org پر تمام مواد صرف تعلیمی مقاصد کے لیے ہے۔ تمام حقوق محفوظ ہیں — WALI PVT Limited، پاکستان۔</p>
      <h2>مواد کا استعمال</h2>
      <p>بغیر اجازت تجارتی مقاصد کے لیے مواد کاپی کرنا ممنوع ہے۔ ذاتی اور تعلیمی استعمال کے لیے ماخذ بتا کر شیئر کر سکتے ہیں۔</p>
      <h2>ذمہ داری</h2>
      <p>اردو اے آئی اے آئی ٹولز کے استعمال سے ہونے والے کسی بھی نقصان کا ذمہ دار نہیں۔ ہر ٹول کی اپنی شرائط لاگو ہوتی ہیں۔</p>
      <h2>رابطہ</h2>
      <p><a href={`${base}/contact/`}>رابطہ کریں</a></p>
    </div>
  </div>
</Base>
