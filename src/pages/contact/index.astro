>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href="/">ہوم</a></li><li aria-current="page">رابطہ</li></ol>
    </nav>
    <h1>رابطہ کریں</h1>
    <div class="prose">
