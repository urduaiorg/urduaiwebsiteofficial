---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="رابطہ — اردو اے آئی"
  description="اردو اے آئی سے رابطہ کریں۔ شراکت داری، ادارہ جاتی تعاون، میڈیا، یا عمومی رہنمائی کے لیے ہم سے جڑیں۔"
  canonical="https://urduai.org/contact/"
  adsense={false}
>
  <div class="container container--narrow" style="margin-block:var(--space-2xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb"><li><a href={`${base}/`}>ہوم</a></li><li aria-current="page">رابطہ</li></ol>
    </nav>
    <h1>رابطہ کریں</h1>
    <div class="prose">
      <p>
        اردو اے آئی، <strong>Wang Lab of Innovation (WALI)</strong> کی ایک پروڈکٹ ہے۔
        اگر آپ شراکت داری، ادارہ جاتی تعاون، میڈیا گفتگو، یا پلیٹ فارم سے متعلق کسی عمومی
        رہنمائی کے لیے رابطہ کرنا چاہتے ہیں تو درج ذیل چینلز استعمال کریں۔
      </p>
      <h2>سوشل میڈیا کے ذریعے رابطہ</h2>
      <ul>
        <li><a href="https://www.facebook.com/urduaiorg" rel="noopener">فیس بک: urduaiorg</a></li>
        <li><a href="https://x.com/urduaiorg" rel="noopener">X: @urduaiorg</a></li>
        <li><a href="https://www.instagram.com/urduaiorg/" rel="noopener">انسٹاگرام: @urduaiorg</a></li>
      </ul>
      <p>
        <strong>اشتہارات اور برانڈ تعاون:</strong> <a href={`${base}/advertise/`}>اشتہار کا صفحہ دیکھیں</a>
      </p>
      <p>
        <strong>ادارہ جاتی یا شراکتی رابطہ:</strong> اگر آپ کسی پروگرام، ٹریننگ، یا تعاون کے بارے میں
        بات کرنا چاہتے ہیں تو پہلے سوشل میڈیا کے ذریعے اپنا تعارف اور مقصد بھیجیں۔
      </p>
      <p>
        <strong>مواد یا ٹیوٹوریل میں غلطی:</strong> سوشل میڈیا پر بتائیں، تاکہ آئندہ اپڈیٹ میں اسے درست کیا جا سکے۔
      </p>
    </div>
  </div>
</Base>
