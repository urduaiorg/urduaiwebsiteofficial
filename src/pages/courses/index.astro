---
// Courses index — adsense: false — NEVER ads on course pages
import Base from '../../layouts/Base.astro';

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "اردو اے آئی کورسز",
  "description": "اردو زبان میں مفت اے آئی کورسز — سرٹیفکیٹ کے ساتھ۔ ابتدائی سے ماہر تک۔",
  "numberOfItems": 3,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "url": "https://urduai.org/courses/masterclass/",
      "name": "اے آئی ماسٹرکلاس",
      "description": "اے آئی کی بنیادی باتیں — 9 ویڈیو اسباق، کوئزز، اور مفت سرٹیفکیٹ",
    },
    {
      "@type": "ListItem",
      "position": 2,
      "url": "https://urduai.org/courses/automation/",
      "name": "اے آئی آٹومیشن",
      "description": "اے آئی سے اپنا کام خودکار بنائیں — جلد آ رہا ہے",
    },
    {
      "@type": "ListItem",
      "position": 3,
      "url": "https://urduai.org/courses/champs/",
      "name": "اے آئی چیمپس",
      "description": "پیشہ ورانہ سطح کی اے آئی مہارت — جلد آ رہا ہے",
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "کورسز", "item": "https://urduai.org/courses/" },
  ],
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="اردو اے آئی کورسز — مفت اے آئی تعلیم اردو میں"
  description="اردو اے آئی کے مفت کورسز میں اے آئی سیکھیں — ابتدائی سے ماہر تک، ویڈیو اسباق، کوئزز، اور سرٹیفکیٹ کے ساتھ۔ 50 ہزار سے زیادہ طلبا نے سیکھا۔"
  canonical="https://urduai.org/courses/"
  adsense={false}
  schema={[courseSchema, breadcrumbSchema]}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li aria-current="page">کورسز</li>
      </ol>
    </nav>

    <h1>اردو اے آئی کورسز</h1>
    <p style="margin-block-end: var(--space-sm);">
      اردو اے آئی کے مفت کورسز میں آپ اے آئی کی بنیادی باتوں سے لے کر پیشہ ورانہ مہارت تک سیکھ سکتے ہیں — ہر کورس میں ویڈیو اسباق، کوئزز، اور مکمل ہونے پر مفت سرٹیفکیٹ شامل ہے۔
    </p>
    <p class="text-muted" style="margin-block-end: var(--space-lg);">
      مفت — سرٹیفکیٹ کے ساتھ — مکمل اردو میں
    </p>

    <div class="post-grid">
      <a href={`${base}/courses/masterclass/`} class="card" style="text-decoration:none;">
        <span class="badge badge--teal">ابتدائی</span>
        <h2 class="card__title" style="margin-block-start:var(--space-xs);">اے آئی ماسٹرکلاس</h2>
        <p class="card__excerpt">اے آئی کی بنیادی باتیں — بالکل شروع سے</p>
        <p class="text-sm text-muted">مفت · سرٹیفکیٹ</p>
      </a>
      <div class="card card--coming-soon" style="text-decoration:none; position:relative; overflow:hidden;">
        <div class="card--blur">
          <span class="badge">درمیانہ</span>
          <h2 class="card__title" style="margin-block-start:var(--space-xs);">اے آئی آٹومیشن</h2>
          <p class="card__excerpt">اے آئی سے اپنا کام خودکار بنائیں</p>
          <p class="text-sm text-muted">مفت · سرٹیفکیٹ</p>
        </div>
        <span class="coming-soon-label">جلد آ رہا ہے</span>
      </div>
      <div class="card card--coming-soon" style="text-decoration:none; position:relative; overflow:hidden;">
        <div class="card--blur">
          <span class="badge" style="background:var(--ink); color:var(--gold-light); border-color:var(--ink);">ماہر</span>
          <h2 class="card__title" style="margin-block-start:var(--space-xs);">اے آئی چیمپس</h2>
          <p class="card__excerpt">پیشہ ورانہ سطح کی اے آئی مہارت</p>
          <p class="text-sm text-muted">مفت · سرٹیفکیٹ</p>
        </div>
        <span class="coming-soon-label">جلد آ رہا ہے</span>
      </div>
    </div>
  </div>

  <style>
    .card--coming-soon {
      cursor: default;
      pointer-events: none;
    }
    .card--blur {
      filter: blur(3px);
      opacity: 0.5;
    }
    .coming-soon-label {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-h2);
      font-weight: bold;
      color: var(--navy);
      pointer-events: none;
    }
  </style>
</Base>
