---
import Base from '../../../layouts/Base.astro';

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "AI automation course Urdu: workflows، forms اور email",
  "description": "AI automation course Urdu: Google Forms، Sheets، email، ChatGPT، Zapier/Make concepts اور small business workflows کے لیے coming soon course۔",
  "provider": { "@type": "Organization", "name": "اردو اے آئی", "url": "https://urduai.org" },
  "inLanguage": "ur",
  "isAccessibleForFree": true,
  "url": "https://urduai.org/courses/automation/",
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="AI automation course Urdu: workflows، forms اور email"
  description="AI automation course Urdu: Google Forms، Sheets، email، ChatGPT، Zapier/Make concepts اور small business workflows کے لیے coming soon course۔"
  canonical="https://urduai.org/courses/automation/"
  adsense={false}
  schema={courseSchema}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/courses/`}>کورسز</a></li>
        <li aria-current="page">آٹومیشن</li>
      </ol>
    </nav>

    <span class="badge">درمیانہ</span>
    <h1 style="margin-block-start:var(--space-xs);">AI automation course Urdu: workflows، forms اور email</h1>
    <p class="text-muted">Google Forms، Sheets، email، ChatGPT اور small business workflows</p>

    <div class="note" style="margin-block:var(--space-lg);">
      یہ کورس جلد شروع ہو رہا ہے۔ اگر آپ ابھی آغاز کرنا چاہتے ہیں تو پہلے <a href={`${base}/guides/free-ai-course-urdu/`}>free AI course Urdu guide</a>، <a href={`${base}/tools/`}>AI tools directory</a> اور <a href={`${base}/learn/prompt-engineering/`}>prompt engineering</a> پڑھیں، پھر آٹومیشن کورس کے لیے واپس آئیں۔
    </div>

    <section aria-labelledby="automation-fit-title" style="margin-block:var(--space-lg);">
      <h2 id="automation-fit-title">یہ course کس کے لیے ہوگا؟</h2>
      <p>
        یہ course ان freelancers، teachers، nonprofit teams اور small business owners کے لیے ہوگا جو repeated tasks کو زیادہ منظم بنانا چاہتے ہیں: form responses، email drafts، spreadsheet updates، simple reminders اور customer reply workflows۔
      </p>
    </section>

    <a href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D" target="_blank" rel="noopener noreferrer" class="btn-playstore">
      اطلاع کے لیے واٹس ایپ چینل جوائن کریں
    </a>
  </div>
</Base>
