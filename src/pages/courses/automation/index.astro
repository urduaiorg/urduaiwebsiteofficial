---
import Base from '../../../layouts/Base.astro';

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "اردو اے آئی آٹومیشن",
  "description": "اے آئی سے اپنا کام خودکار بنائیں — درمیانہ سطح",
  "provider": { "@type": "Organization", "name": "اردو اے آئی", "url": "https://urduai.org" },
  "inLanguage": "ur",
  "isAccessibleForFree": true,
  "url": "https://urduai.org/courses/automation/",
};
---

<Base
  title="اے آئی آٹومیشن کورس — اردو اے آئی | مفت اردو میں"
  description="اردو اے آئی آٹومیشن کورس میں اے آئی سے اپنا کام خودکار بنانا سیکھیں — مفت، اردو میں، سرٹیفکیٹ کے ساتھ۔"
  canonical="https://urduai.org/courses/automation/"
  adsense={false}
  schema={courseSchema}
>
  <div class="container" style="margin-block-start: var(--space-xl);">
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href="/">ہوم</a></li>
        <li><a href="/courses/">کورسز</a></li>
        <li aria-current="page">آٹومیشن</li>
      </ol>
    </nav>

    <span class="badge">درمیانہ</span>
    <h1 style="margin-block-start:var(--space-xs);">اے آئی آٹومیشن</h1>
    <p class="text-muted">مفت · سرٹیفکیٹ · اردو میں</p>

    <div class="note" style="margin-block:var(--space-lg);">
      یہ کورس جلد شروع ہو رہا ہے۔ نیوز لیٹر سبسکرائب کریں تاکہ اطلاع ملے۔
    </div>

    <a href="https://www.urduaiupdates.com" class="btn-playstore">
      اطلاع کے لیے سبسکرائب کریں
    </a>
  </div>
</Base>
