---
import Base from '../../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="سرٹیفکیٹ حاصل کریں — اردو اے آئی ماسٹرکلاس"
  description="اردو اے آئی ماسٹرکلاس مکمل کرنے کے بعد اپنا مفت سرٹیفکیٹ حاصل کریں۔"
  canonical="https://urduai.org/courses/masterclass/certificate/"
  adsense={false}
>
  <div class="container cert-page" style="margin-block-start: var(--space-xl);">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/courses/`}>کورسز</a></li>
        <li><a href={`${base}/courses/masterclass/`}>ماسٹرکلاس</a></li>
        <li aria-current="page">سرٹیفکیٹ</li>
      </ol>
    </nav>

    <h1>سرٹیفکیٹ حاصل کریں</h1>

    <!-- Not eligible message (shown if not all lessons complete) -->
    <div id="not-eligible" class="note note--warning" style="display:none;">
      <strong>ابھی تمام اسباق مکمل نہیں ہوئے۔</strong>
      <p>سرٹیفکیٹ حاصل کرنے کے لیے تمام 9 اسباق کے کوئزز پاس کرنا ضروری ہے۔</p>
      <a href={`${base}/courses/masterclass/`} class="btn-secondary" style="margin-block-start: var(--space-sm);">
        کورس پر واپس جائیں
      </a>
    </div>

    <!-- Certificate form (shown only when all lessons complete) -->
    <div id="cert-form-section" style="display:none;">
      <div class="cert-stats">
        <p>مبارک ہو! آپ نے ماسٹرکلاس کے تمام 9 اسباق مکمل کر لیے ہیں۔</p>
        <p class="text-muted">اوسط سکور: <strong id="avg-score"></strong>%</p>
      </div>

      <form id="cert-form" class="cert-form">
        <div class="form-group">
          <label for="name-ur">اردو میں نام</label>
          <input type="text" id="name-ur" name="nameUr" required placeholder="مثال: قیصر رونجھا" dir="rtl" />
        </div>
        <div class="form-group">
          <label for="name-en">English Name</label>
          <input type="text" id="name-en" name="nameEn" required placeholder="e.g. Qaisar Roonjha" dir="ltr" />
        </div>
        <div class="form-group">
          <label for="email">ای میل</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" dir="ltr" />
        </div>
        <p class="text-muted" style="font-size: var(--text-sm);">
          سرٹیفکیٹ PDF آپ کے ای میل پر بھیج دیا جائے گا۔
        </p>
        <button type="submit" class="btn-primary" id="cert-submit">
          سرٹیفکیٹ بنائیں
        </button>
      </form>
    </div>

    <!-- Loading state -->
    <div id="cert-loading" class="cert-loading" style="display:none;">
      <p>سرٹیفکیٹ بن رہا ہے... براہ کرم انتظار کریں۔</p>
    </div>

    <!-- Success state -->
    <div id="cert-success" class="cert-success" style="display:none;">
      <h2>مبارک ہو! آپ کا سرٹیفکیٹ تیار ہے</h2>
      <div class="cert-id-box">
        <span class="text-muted">سرٹیفکیٹ ID:</span>
        <strong id="cert-id-display"></strong>
      </div>
      <p>سرٹیفکیٹ PDF آپ کے ای میل <strong id="cert-email-display"></strong> پر بھیج دیا گیا ہے۔</p>
      <p class="text-muted" style="font-size: var(--text-sm);">
        اگر ای میل نظر نہ آئے تو اسپام/جنک فولڈر چیک کریں۔
      </p>
      <div style="margin-block-start: var(--space-lg);">
        <a href={`${base}/courses/`} class="btn-secondary">مزید کورسز دیکھیں</a>
      </div>
    </div>

    <!-- Error state -->
    <div id="cert-error" class="cert-error" style="display:none;">
      <p><strong>کچھ غلطی ہو گئی۔</strong></p>
      <p id="cert-error-msg"></p>
      <button class="btn-secondary" onclick="document.getElementById('cert-error').style.display='none'; document.getElementById('cert-form-section').style.display='block';">
        دوبارہ کوشش کریں
      </button>
    </div>
  </div>

  <style>
    .cert-page {
      max-width: var(--max-width);
      padding-block-end: var(--space-2xl);
    }

    .note--warning {
      background: #fef9e0;
      border: 1px solid var(--gold);
      border-radius: 8px;
      padding: var(--space-md);
    }

    .cert-stats {
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-md);
      margin-block: var(--space-lg);
    }

    .cert-form {
      margin-block: var(--space-lg);
    }
    .form-group {
      margin-block-end: var(--space-md);
    }
    .form-group label {
      display: block;
      font-weight: bold;
      margin-block-end: var(--space-xs);
    }
    .form-group input {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      background: var(--paper-card);
    }
    .form-group input:focus {
      outline: 2px solid var(--navy);
      border-color: var(--navy);
    }

    .btn-primary {
      display: inline-block;
      background: var(--navy);
      color: #fff;
      border: none;
      padding: 0.8rem 2rem;
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-primary:hover { background: var(--navy-dark); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-secondary {
      display: inline-block;
      background: transparent;
      color: var(--navy);
      border: 2px solid var(--navy);
      padding: 0.7rem 1.8rem;
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-secondary:hover { background: var(--navy); color: #fff; }

    .cert-loading {
      text-align: center;
      padding: var(--space-xl);
      color: var(--ink-muted);
    }

    .cert-success {
      background: #d4edda;
      border: 2px solid #0e6b5e;
      border-radius: 8px;
      padding: var(--space-lg);
      margin-block: var(--space-lg);
    }
    .cert-success h2 { color: #0e6b5e; }

    .cert-id-box {
      background: var(--paper-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: var(--space-sm) var(--space-md);
      margin-block: var(--space-md);
      font-size: 1.2rem;
      direction: ltr;
      unicode-bidi: embed;
    }

    .cert-error {
      background: #fde8e8;
      border: 2px solid #c0392b;
      border-radius: 8px;
      padding: var(--space-lg);
      margin-block: var(--space-lg);
    }

    @media (max-width: 600px) {
      .cert-success, .cert-form {
        padding: var(--space-sm);
      }
    }
  </style>

  <script is:inline>
    var totalLessons = 9;

    // IMPORTANT: Replace this URL with your Cloudflare Worker URL after deployment
    var WORKER_URL = 'https://urai-cert.qaisar-roonjha.workers.dev';

    // Check eligibility
    var completed = 0;
    var totalScore = 0;
    for (var i = 1; i <= totalLessons; i++) {
      if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true') {
        completed++;
        var score = parseInt(localStorage.getItem('urai-mc-lesson-' + i + '-score') || '0');
        totalScore += score;
      }
    }

    var avgScore = completed > 0 ? Math.round(totalScore / completed) : 0;

    if (completed < totalLessons) {
      document.getElementById('not-eligible').style.display = 'block';
    } else {
      document.getElementById('cert-form-section').style.display = 'block';
      document.getElementById('avg-score').textContent = avgScore;
    }

    // Generate certificate ID
    function generateCertId() {
      var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      var id = 'URAI-MC-';
      for (var i = 0; i < 6; i++) {
        id += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return id;
    }

    // Form submission
    document.getElementById('cert-form').addEventListener('submit', function(e) {
      e.preventDefault();

      var nameUr = document.getElementById('name-ur').value.trim();
      var nameEn = document.getElementById('name-en').value.trim();
      var email = document.getElementById('email').value.trim();

      if (!nameUr || !nameEn || !email) return;

      var certId = generateCertId();
      var now = new Date().toISOString();

      // Hide form, show loading
      document.getElementById('cert-form-section').style.display = 'none';
      document.getElementById('cert-loading').style.display = 'block';

      var payload = {
        certificateId: certId,
        nameUr: nameUr,
        nameEn: nameEn,
        email: email,
        score: avgScore,
        courseName: 'Urdu AI Master Class',
        issuedAt: now,
      };

      fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          document.getElementById('cert-loading').style.display = 'none';
          if (data.success || data.status === 'success') {
            document.getElementById('cert-success').style.display = 'block';
            document.getElementById('cert-id-display').textContent = certId;
            document.getElementById('cert-email-display').textContent = email;
            localStorage.setItem('urai-mc-certificate-id', certId);
          } else {
            document.getElementById('cert-error').style.display = 'block';
            document.getElementById('cert-error-msg').textContent = data.message || 'سرور سے جواب نہیں آیا۔ براہ کرم بعد میں کوشش کریں۔';
          }
        })
        .catch(function(err) {
          document.getElementById('cert-loading').style.display = 'none';
          document.getElementById('cert-error').style.display = 'block';
          document.getElementById('cert-error-msg').textContent = 'نیٹ ورک ایرر — براہ کرم اپنا انٹرنیٹ چیک کریں اور دوبارہ کوشش کریں۔';
        });
    });
  </script>
</Base>
