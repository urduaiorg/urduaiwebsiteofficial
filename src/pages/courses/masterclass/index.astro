---
import Base from '../../../layouts/Base.astro';
import { lessons } from '../../../data/masterclass-lessons';

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "AI course in Urdu free Pakistan: اردو اے آئی ماسٹرکلاس",
  "description": "AI course in Urdu free Pakistan: beginners کے لیے 9 online video lessons، quizzes، certificate path، ChatGPT، Gemini، prompts اور AI tools۔",
  "provider": { "@type": "Organization", "name": "اردو اے آئی", "url": "https://urduai.org" },
  "inLanguage": "ur",
  "isAccessibleForFree": true,
  "numberOfCredits": 9,
  "educationalLevel": "Beginner",
  "url": "https://urduai.org/courses/masterclass/",
  "coursePrerequisites": "کوئی پیشگی تجربہ درکار نہیں",
  "teaches": "مصنوعی ذہانت کی بنیاد، AI tools کا استعمال، prompts، ChatGPT، Gemini، Claude، وائب کوڈنگ، AI images، voice اور website building",
  "totalHistoricalEnrollment": 50000,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "PKR",
    "availability": "https://schema.org/InStock",
  },
  "instructor": {
    "@type": "Person",
    "name": "قیصر رونجھا",
    "alternateName": "Qaisar Roonjha",
    "url": "https://urduai.org/team/",
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT3H",
    "courseSchedule": {
      "@type": "Schedule",
      "repeatFrequency": "P1D",
      "repeatCount": 9,
    },
  },
  "hasPart": lessons.map((l, i) => ({
    "@type": "Course",
    "name": `سبق ${l.number}: ${l.title}`,
    "url": `https://urduai.org/courses/masterclass/${l.number}/`,
    "position": i + 1,
  })),
  "educationalCredentialAwarded": {
    "@type": "EducationalOccupationalCredential",
    "name": "Urdu AI Master Class Certificate",
    "credentialCategory": "Certificate of Completion",
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "کورسز", "item": "https://urduai.org/courses/" },
    { "@type": "ListItem", "position": 3, "name": "ماسٹرکلاس", "item": "https://urduai.org/courses/masterclass/" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "کیا یہ AI course Urdu میں free ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں، اردو اے آئی ماسٹرکلاس بغیر فیس کے دستیاب ہے۔ اس میں 9 ویڈیو اسباق، quizzes، beginner practice اور کورس مکمل کرنے کے بعد certificate شامل ہے۔" },
    },
    {
      "@type": "Question",
      "name": "AI courses online free Pakistan میں Urdu beginner کہاں سے شروع کرے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "اردو beginner پہلے Masterclass کا lesson 1 کھولے، AI kya hai in Urdu سمجھے، پھر Gemini یا ChatGPT میں ایک prompt آزمائے، اور اس کے بعد 9 lessons ترتیب سے مکمل کرے۔" },
    },
    {
      "@type": "Question",
      "name": "Artificial intelligence course free certificate کیا واقعی ملتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "Masterclass میں lessons اور quizzes مکمل کرنے کے بعد Urdu AI completion certificate کا راستہ موجود ہے۔ یہ learning proof ہے، university degree یا آفیشل educational qualification نہیں۔" },
    },
    {
      "@type": "Question",
      "name": "اردو اے آئی ماسٹرکلاس میں کیا سکھایا جاتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "اس کورس میں AI کیا ہے، ChatGPT، Gemini، Claude، prompts، AI writing، images، voice، avatars، vibe coding اور اپنی پہلی website بنانے کا راستہ سکھایا جاتا ہے۔" },
    },
    {
      "@type": "Question",
      "name": "کیا beginners اس AI course سے شروع کر سکتے ہیں؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں۔ یہ course beginners کے لیے ہے۔ پہلے سبق میں AI کیا ہے سمجھایا جاتا ہے، پھر tools، prompts، content creation اور web/app ideas کی طرف لے جایا جاتا ہے۔" },
    },
    {
      "@type": "Question",
      "name": "ماسٹرکلاس مکمل کرنے میں کتنا وقت لگتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "کل 9 ویڈیو اسباق ہیں جو تقریباً 3 گھنٹے میں مکمل ہو جاتے ہیں۔ آپ اپنی رفتار سے سیکھ سکتے ہیں؛ کوئی مقررہ deadline نہیں۔" },
    },
    {
      "@type": "Question",
      "name": "AI course certificate کیسے ملتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "تمام 9 اسباق کے quizzes پاس کرنے کے بعد certificate form بھریں۔ PDF certificate آپ کے email پر بھیجا جاتا ہے۔" },
    },
    {
      "@type": "Question",
      "name": "کیا یہ AI course mobile پر چلتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں۔ کورس website اور Urdu AI app دونوں پر mobile-friendly ہے۔ آپ browser میں urduai.org کھول سکتے ہیں یا app استعمال کر سکتے ہیں۔" },
    },
    {
      "@type": "Question",
      "name": "کورس شروع کرنے سے پہلے کون سا سبق یا گائیڈ پڑھوں؟",
      "acceptedAnswer": { "@type": "Answer", "text": "اگر آپ بالکل نئے ہیں تو پہلے AI کیا ہے والا بنیادی سبق پڑھیں، پھر Gemini کو اردو میں استعمال کرنے کی گائیڈ دیکھیں، اور اس کے بعد ماسٹرکلاس کا پہلا سبق شروع کریں۔" },
    },
    {
      "@type": "Question",
      "name": "کیا یہ AI courses in Pakistan تلاش کرنے والوں کے لیے مناسب ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں۔ یہ course پاکستان اور اردو بولنے والے beginners کے لیے بنایا گیا ہے، خاص طور پر ان users کے لیے جو mobile پر AI، ChatGPT، Gemini اور prompts سیکھنا چاہتے ہیں۔" },
    },
    {
      "@type": "Question",
      "name": "کیا AI course کے لیے coding آنا ضروری ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "نہیں۔ پہلے اسباق میں coding ضروری نہیں۔ course AI basics، prompts، writing، tools اور beginner workflows سے شروع ہوتا ہے؛ vibe coding بعد کے اسباق میں آتی ہے۔" },
    },
    {
      "@type": "Question",
      "name": "کیا certificate university یا آفیشل تعلیمی ادارے کا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "نہیں۔ یہ Urdu AI completion certificate ہے۔ اسے learning proof کے طور پر استعمال کیا جا سکتا ہے، مگر یہ university degree یا آفیشل educational qualification نہیں۔" },
    },
    {
      "@type": "Question",
      "name": "کیا course میں ChatGPT اور Gemini دونوں شامل ہیں؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں۔ course میں ChatGPT، Gemini، Claude، Google AI Studio اور دوسرے beginner tools کا تعارف اور practical استعمال شامل ہے۔" },
