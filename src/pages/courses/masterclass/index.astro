  <script is:inline>
    var totalLessons = 9;

    function getCompleted() {
      var count = 0;
      for (var i = 1; i <= totalLessons; i++) {
        if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true') count++;
      }
      return count;
    }

    // Check enrollment
    var isEnrolled = localStorage.getItem('urai-mc-enrolled') === 'true';
    var completed = getCompleted();

    function goToNextLesson() {
      var target = 1;
      for (var i = 1; i <= totalLessons; i++) {
        if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') !== 'true') {
          target = i;
          break;
        }
      }
      window.location.href = window.location.pathname.replace(/\/$/, '') + '/' + target + '/';
    }

    if (isEnrolled || completed > 0) {
      // Already enrolled — hide subscribe section entirely
      var subscribeSection = document.getElementById('mc-subscribe');
      if (subscribeSection) {
        subscribeSection.innerHTML = '<a href="javascript:void(0)" class="btn-primary" id="continue-btn" style="font-size:1.1rem; padding:1rem 2.5rem;">' +
          (completed > 0 ? 'کورس جاری رکھیں →' : 'کورس شروع کریں →') + '</a>';
        document.getElementById('continue-btn').addEventListener('click', goToNextLesson);
      }
    }

    // Subscribe form
    var subForm = document.getElementById('subscribe-form');
    if (subForm) {
      subForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = document.getElementById('subscribe-email').value.trim();
        if (!email) return;
        // Open Substack subscribe in new tab with email prefilled
        window.open('https://www.urduaiupdates.com/subscribe?email=' + encodeURIComponent(email), '_blank');
        // Mark enrolled and navigate
        localStorage.setItem('urai-mc-enrolled', 'true');
        goToNextLesson();
      });
    }

    // Update syllabus status + locking
    for (var i = 1; i <= totalLessons; i++) {
      var isComplete = localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true';
      var statusEl = document.getElementById('status-' + i);
      var itemEl = document.querySelector('[data-lesson="' + i + '"]');
      if (isComplete) {
        if (statusEl) statusEl.textContent = 'مکمل';
        if (itemEl) itemEl.classList.add('completed');
      } else if (i > 1) {
        // Lock if previous lesson not complete
        var prevComplete = localStorage.getItem('urai-mc-lesson-' + (i - 1) + '-complete') === 'true';
        if (!prevComplete && itemEl) {
          itemEl.classList.add('locked');
          if (statusEl) statusEl.textContent = 'لاکڈ';
          // Disable the link
          var link = itemEl.querySelector('.mc-syllabus__link');
          if (link) {
            link.style.pointerEvents = 'none';
            link.style.opacity = '0.5';
          }
        }
      }
    }

    // Show progress if any lessons completed
    if (completed > 0) {
      var progressOverview = document.getElementById('mc-progress-overview');
      if (progressOverview) progressOverview.style.display = 'flex';
      var fill = document.getElementById('mc-progress-fill');
      var text = document.getElementById('mc-progress-text');
      var pct = Math.round((completed / totalLessons) * 100);
      if (fill) fill.style.width = pct + '%';
      if (text) text.textContent = completed + '/' + totalLessons + ' مکمل';
    }

    // Show certificate CTA if all complete
    if (completed === totalLessons) {
      var certCta = document.getElementById('mc-cert-cta');
      if (certCta) certCta.style.display = 'block';
    }
  </script>
