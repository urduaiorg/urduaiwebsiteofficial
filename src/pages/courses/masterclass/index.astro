---
import Base from '../../../layouts/Base.astro';
import { lessons } from '../../../data/masterclass-lessons';

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "اردو اے آئی ماسٹرکلاس",
  "description": "اردو اے آئی ماسٹرکلاس ایک مفت اردو AI کورس ہے جس میں 9 ویڈیو اسباق، کوئزز، اور سرٹیفکیٹ شامل ہیں۔ ChatGPT، Gemini، Claude، وائب کوڈنگ، AI تصاویر، آواز، اوتار — سب اردو میں سیکھیں۔",
  "provider": { "@type": "Organization", "name": "اردو اے آئی", "url": "https://urduai.org" },
  "inLanguage": "ur",
  "isAccessibleForFree": true,
  "numberOfCredits": 9,
  "educationalLevel": "Beginner",
  "url": "https://urduai.org/courses/masterclass/",
  "coursePrerequisites": "کوئی پیشگی تجربہ درکار نہیں — بالکل شروع سے",
  "teaches": "مصنوعی ذہانت کے بنیادی تصورات، AI ٹولز کا استعمال، وائب کوڈنگ، AI سے مواد بنانا",
  "totalHistoricalEnrollment": 50000,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "PKR",
    "availability": "https://schema.org/InStock",
  },
  "instructor": {
    "@type": "Person",
    "name": "قیصر رونجھا",
    "alternateName": "Qaisar Roonjha",
    "url": "https://urduai.org/team/",
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT3H",
    "courseSchedule": {
      "@type": "Schedule",
      "repeatFrequency": "P1D",
      "repeatCount": 9,
    },
  },
  "hasPart": lessons.map((l, i) => ({
    "@type": "Course",
    "name": `سبق ${l.number}: ${l.title}`,
    "url": `https://urduai.org/courses/masterclass/${l.number}/`,
    "position": i + 1,
  })),
  "educationalCredentialAwarded": {
    "@type": "EducationalOccupationalCredential",
    "name": "Urdu AI Master Class Certificate",
    "credentialCategory": "Certificate of Completion",
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "کورسز", "item": "https://urduai.org/courses/" },
    { "@type": "ListItem", "position": 3, "name": "ماسٹرکلاس", "item": "https://urduai.org/courses/masterclass/" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "کیا اردو اے آئی ماسٹرکلاس مفت ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں، یہ کورس مکمل طور پر مفت ہے۔ 9 ویڈیو اسباق، کوئزز، اور سرٹیفکیٹ — سب بغیر کسی فیس کے۔" },
    },
    {
      "@type": "Question",
      "name": "ماسٹرکلاس مکمل کرنے میں کتنا وقت لگتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "کل 9 ویڈیو اسباق ہیں جو تقریباً 3 گھنٹے میں مکمل ہو جاتے ہیں۔ آپ اپنی رفتار سے سیکھ سکتے ہیں — کوئی ڈیڈ لائن نہیں۔" },
    },
    {
      "@type": "Question",
      "name": "کیا مجھے پہلے سے AI کا تجربہ ہونا چاہیے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "بالکل نہیں۔ یہ کورس بالکل شروع سے شروع ہوتا ہے — AI کیا ہے سے لے کر ویب سائٹ بنانے تک۔ کوئی پیشگی تجربہ درکار نہیں۔" },
    },
    {
      "@type": "Question",
      "name": "سرٹیفکیٹ کیسے ملتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "تمام 9 اسباق کے کوئزز پاس کرنے کے بعد سرٹیفکیٹ فارم بھریں۔ PDF سرٹیفکیٹ آپ کے ای میل پر خودکار طور پر بھیج دیا جائے گا۔" },
    },
    {
      "@type": "Question",
      "name": "کیا یہ کورس موبائل پر چلتا ہے؟",
      "acceptedAnswer": { "@type": "Answer", "text": "جی ہاں۔ ویب سائٹ اور اردو اے آئی ایپ دونوں پر یہ کورس موبائل فرینڈلی ہے۔ Play Store سے ایپ ڈاؤن لوڈ کریں یا براؤزر میں urduai.org کھولیں۔" },
    },
    {
      "@type": "Question",
      "name": "کورس شروع کرنے سے پہلے کون سا سبق یا گائیڈ پڑھوں؟",
      "acceptedAnswer": { "@type": "Answer", "text": "اگر آپ بالکل نئے ہیں تو پہلے AI کیا ہے والا بنیادی سبق پڑھیں، پھر Gemini کو اردو میں استعمال کرنے کی گائیڈ دیکھیں، اور اس کے بعد ماسٹرکلاس کا پہلا سبق شروع کریں۔" },
    },
  ],
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="مفت AI کورس اردو میں — اردو اے آئی ماسٹرکلاس"
  description="اردو اے آئی ماسٹرکلاس میں AI کی بنیادی باتیں، ChatGPT، Gemini، Claude، وائب کوڈنگ اور AI مواد بنانا 9 ویڈیو اسباق میں سیکھیں۔"
  canonical="https://urduai.org/courses/masterclass/"
  adsense={false}
  schema={courseSchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container mc-landing" style="margin-block-start: var(--space-xl);">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/courses/`}>کورسز</a></li>
        <li aria-current="page">ماسٹرکلاس</li>
      </ol>
    </nav>

    <!-- Hero -->
    <div class="mc-hero">
      <span class="badge badge--gold">مفت کورس</span>
      <h1>مفت AI کورس اردو میں</h1>
      <p class="mc-hero__subtitle">
        اردو اے آئی ماسٹرکلاس ایک مفت AI کورس ہے جو اردو میں مصنوعی ذہانت بالکل شروع سے سکھاتا ہے۔ اس میں 9 ویڈیو اسباق ہیں: ChatGPT، Google Gemini، Claude، وائب کوڈنگ، AI تصاویر، آواز، اوتار، اور ویب سائٹ بنانا۔ ہر سبق کے بعد کوئز دیں اور تمام اسباق مکمل کرنے پر مفت سرٹیفکیٹ حاصل کریں۔
      </p>
      <div class="mc-stats">
        <div class="mc-stat">
          <span class="mc-stat__number">9</span>
          <span class="mc-stat__label">ویڈیو اسباق</span>
        </div>
        <div class="mc-stat">
          <span class="mc-stat__number">50K+</span>
          <span class="mc-stat__label">سیکھنے والے</span>
        </div>
        <div class="mc-stat">
          <span class="mc-stat__number">مفت</span>
          <span class="mc-stat__label">سرٹیفکیٹ</span>
        </div>
      </div>
    </div>

    <section class="mc-start-path" aria-labelledby="mc-start-path-title">
      <h2 id="mc-start-path-title">اگر آپ بالکل نئے ہیں تو یہاں سے شروع کریں</h2>
      <p>
        ماسٹرکلاس شروع کرنے سے پہلے بنیاد صاف رکھیں: پہلے AI کی آسان تعریف پڑھیں، پھر Gemini میں اردو سوال پوچھنے کی مشق کریں، اور پھر سبق 1 شروع کریں۔
      </p>
      <div class="mc-start-path__links">
        <a href={`${base}/learn/artificial-intelligence/`}>مصنوعی ذہانت کیا ہے؟</a>
        <a href={`${base}/guides/free-ai-course-urdu/`}>مفت AI کورس گائیڈ</a>
        <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو گائیڈ</a>
        <a href={`${base}/blog/google-ai-studio-kia-hai/`}>Google AI Studio گائیڈ</a>
        <a href={`${base}/tools/`}>AI Tools Directory</a>
      </div>
    </section>

    <!-- Subscribe + enroll section -->
    <div class="mc-subscribe" id="mc-subscribe">
      <h2>کورس شروع کرنے کے لیے سبسکرائب کریں</h2>
      <p class="text-muted">اپنا ای میل درج کریں — اردو اے آئی اپڈیٹس آپ کو ملتی رہیں گی اور کورس شروع ہو جائے گا۔</p>
      <form id="subscribe-form" class="mc-subscribe__form">
        <div class="mc-subscribe__input-group">
          <input
            type="email"
            id="subscribe-email"
            name="email"
            required
            placeholder="آپ کا ای میل ایڈریس"
            dir="ltr"
          />
          <button type="submit" class="btn-primary">سبسکرائب کریں</button>
        </div>
      </form>
    </div>

    <!-- Syllabus -->
    <div class="mc-syllabus">
      <h2>نصاب — 9 اسباق</h2>
      <div class="mc-progress-overview" id="mc-progress-overview" style="display:none;">
        <div class="mc-progress__bar">
          <div class="mc-progress__fill" id="mc-progress-fill"></div>
        </div>
        <span class="mc-progress__text" id="mc-progress-text"></span>
      </div>
      <ol class="mc-syllabus__list">
        {lessons.map((lesson) => (
          <li class="mc-syllabus__item" data-lesson={lesson.number}>
            <a href={`${base}/courses/masterclass/${lesson.number}/`} class="mc-syllabus__link">
              <span class="mc-syllabus__num">{lesson.number}</span>
              <span class="mc-syllabus__title">{lesson.title}</span>
              <span class="mc-syllabus__status" id={`status-${lesson.number}`}></span>
            </a>
            {lesson.tools.length > 0 && (
              <span class="mc-syllabus__tools">
                {lesson.tools.map((t) => t.name).join('، ')}
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>

    <!-- Certificate CTA -->
    <div class="mc-cert-cta" id="mc-cert-cta" style="display:none;">
      <h2>تمام اسباق مکمل!</h2>
      <p>آپ نے 9 میں سے 9 اسباق مکمل کر لیے ہیں۔ اب اپنا سرٹیفکیٹ حاصل کریں۔</p>
      <a href={`${base}/courses/masterclass/certificate/`} class="btn-primary">
        سرٹیفکیٹ حاصل کریں →
      </a>
    </div>

    <!-- What you'll learn -->
    <div class="mc-learn">
      <h2>آپ کیا سیکھیں گے؟</h2>
      <ul class="mc-learn__list">
        <li>AI کیا ہے اور یہ کیسے کام کرتا ہے — بالکل شروع سے</li>
        <li>ChatGPT، Gemini، Claude — مشہور AI ٹولز استعمال کرنا</li>
        <li>AI سے اردو میں لکھنا، ترجمہ کرنا، اور تجزیہ کرنا</li>
        <li>AI سے تصاویر، ویڈیوز، آواز، اور موسیقی بنانا</li>
        <li>وائب کوڈنگ — بغیر کوڈ سیکھے ایپس اور ویب سائٹس بنانا</li>
        <li>AI اوتار بنانا — ڈیجیٹل انسان جو آپ کے لیے بولے</li>
        <li>اپنی پہلی ویب سائٹ AI سے بنانا اور لائیو کرنا</li>
      </ul>
    </div>

    <!-- FAQ section -->
    <div class="mc-faq">
      <h2>عام سوالات</h2>
      <details>
        <summary>کیا اردو اے آئی ماسٹرکلاس مفت ہے؟</summary>
        <p>جی ہاں، یہ کورس مکمل طور پر مفت ہے۔ 9 ویڈیو اسباق، کوئزز، اور سرٹیفکیٹ — سب بغیر کسی فیس کے۔</p>
      </details>
      <details>
        <summary>ماسٹرکلاس مکمل کرنے میں کتنا وقت لگتا ہے؟</summary>
        <p>کل 9 ویڈیو اسباق ہیں جو تقریباً 3 گھنٹے میں مکمل ہو جاتے ہیں۔ آپ اپنی رفتار سے سیکھ سکتے ہیں — کوئی ڈیڈ لائن نہیں۔</p>
      </details>
      <details>
        <summary>کیا مجھے پہلے سے AI کا تجربہ ہونا چاہیے؟</summary>
        <p>بالکل نہیں۔ یہ کورس بالکل شروع سے شروع ہوتا ہے — AI کیا ہے سے لے کر ویب سائٹ بنانے تک۔ کوئی پیشگی تجربہ درکار نہیں۔</p>
      </details>
      <details>
        <summary>سرٹیفکیٹ کیسے ملتا ہے؟</summary>
        <p>تمام 9 اسباق کے کوئزز پاس کرنے کے بعد سرٹیفکیٹ فارم بھریں۔ PDF سرٹیفکیٹ آپ کے ای میل پر خودکار طور پر بھیج دیا جائے گا۔</p>
      </details>
      <details>
        <summary>کیا یہ کورس موبائل پر چلتا ہے؟</summary>
        <p>جی ہاں۔ ویب سائٹ اور اردو اے آئی ایپ دونوں پر یہ کورس موبائل فرینڈلی ہے۔ Play Store سے ایپ ڈاؤن لوڈ کریں یا براؤزر میں urduai.org کھولیں۔</p>
      </details>
      <details>
        <summary>کورس شروع کرنے سے پہلے کون سا سبق یا گائیڈ پڑھوں؟</summary>
        <p>اگر آپ بالکل نئے ہیں تو پہلے <a href={`${base}/guides/ai-kya-hai-urdu-ai-master-class-1/`}>AI کیا ہے؟</a> پڑھیں، پھر <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو گائیڈ</a> دیکھیں، اور اس کے بعد سبق 1 شروع کریں۔</p>
      </details>
    </div>

    <!-- WhatsApp CTA -->
    <div class="mc-whatsapp">
      <a href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        اردو اے آئی واٹس ایپ چینل جوائن کریں
      </a>
    </div>
  </div>

  <style>
    .mc-landing {
      max-width: var(--max-width);
      padding-block-end: var(--space-2xl);
    }

    /* Hero */
    .mc-hero {
      margin-block: var(--space-lg);
    }
    .mc-hero h1 {
      margin-block-start: var(--space-xs);
    }
    .mc-hero__subtitle {
      font-size: 1.1rem;
      color: var(--ink-soft);
      max-width: 600px;
    }

    .mc-start-path {
      border-block: 1px solid var(--border);
      padding-block: var(--space-lg);
      margin-block: var(--space-lg);
    }

    .mc-start-path h2 {
      font-size: var(--text-h2);
      line-height: var(--lh-heading);
      margin-block-end: var(--space-xs);
    }

    .mc-start-path p {
      color: var(--ink-soft);
      line-height: var(--lh-prose);
      max-width: 680px;
    }

    .mc-start-path__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
      margin-block-start: var(--space-sm);
    }

    .mc-start-path__links a {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.45em 0.9em;
      background: var(--paper-card);
      color: var(--teal);
      text-decoration: none;
      font-size: var(--text-sm);
    }

    .mc-start-path__links a:hover {
      border-color: var(--teal);
    }

    .badge--gold {
      background: var(--gold);
      color: var(--ink);
      padding: 0.2rem 0.8rem;
      border-radius: 4px;
      font-size: var(--text-sm);
      font-weight: bold;
    }
    .mc-stats {
      display: flex;
      gap: var(--space-lg);
      margin-block-start: var(--space-lg);
    }
    .mc-stat {
      text-align: center;
    }
    .mc-stat__number {
      display: block;
      font-size: var(--text-h2);
      font-weight: bold;
      color: var(--navy);
      line-height: 1.3;
    }
    .mc-stat__label {
      font-size: var(--text-sm);
      color: var(--ink-muted);
    }

    /* Subscribe */
    .mc-subscribe {
      margin-block: var(--space-xl);
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-lg);
    }
    .mc-subscribe h2 {
      color: var(--navy);
      margin-block-end: var(--space-xs);
    }
    .mc-subscribe__form {
      margin-block: var(--space-md);
    }
    .mc-subscribe__input-group {
      display: flex;
      gap: var(--space-sm);
      max-width: 500px;
    }
    .mc-subscribe__input-group input {
      flex: 1;
      padding: 0.7rem 1rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      background: var(--paper-card);
    }
    .mc-subscribe__input-group input:focus {
      outline: 2px solid var(--navy);
      border-color: var(--navy);
    }
@media (max-width: 480px) {
      .mc-subscribe__input-group {
        flex-direction: column;
      }
    }
    .btn-primary {
      display: inline-block;
      background: var(--navy);
      color: #fff;
      border: none;
      padding: 0.8rem 2rem;
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-primary:hover {
      background: var(--navy-dark);
    }
    .btn-secondary {
      display: inline-block;
      background: transparent;
      color: var(--navy);
      border: 2px solid var(--navy);
      padding: 0.7rem 1.8rem;
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-secondary:hover {
      background: var(--navy);
      color: #fff;
    }

    /* Syllabus */
    .mc-syllabus {
      margin-block: var(--space-xl);
    }
    .mc-syllabus h2 {
      color: var(--navy);
      margin-block-end: var(--space-md);
    }
    .mc-syllabus__list {
      list-style: none;
      padding: 0;
      margin: 0;
      counter-reset: none;
    }
    .mc-syllabus__item {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-block-end: var(--space-xs);
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .mc-syllabus__item:hover {
      border-color: var(--navy);
    }
    .mc-syllabus__item.completed {
      border-color: #0e6b5e;
      background: #f0faf8;
    }
    .mc-syllabus__link {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space-md);
      text-decoration: none;
      color: var(--ink);
    }
    .mc-syllabus__num {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--navy);
      color: #fff;
      font-size: var(--text-sm);
      font-weight: bold;
      flex-shrink: 0;
    }
    .mc-syllabus__item.completed .mc-syllabus__num {
      background: #0e6b5e;
    }
    .mc-syllabus__title {
      flex: 1;
      font-weight: bold;
    }
    .mc-syllabus__status {
      font-size: var(--text-sm);
      color: var(--ink-muted);
    }
    .mc-syllabus__tools {
      display: block;
      padding: 0 var(--space-md) var(--space-sm);
      padding-inline-start: calc(var(--space-md) + 2rem + var(--space-sm));
      font-size: var(--text-sm);
      color: var(--ink-muted);
    }

    /* Progress */
    .mc-progress-overview {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      margin-block-end: var(--space-md);
    }
    .mc-progress__bar {
      flex: 1;
      height: 8px;
      background: var(--paper-warm);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .mc-progress__fill {
      height: 100%;
      background: var(--navy);
      border-radius: 4px;
      transition: width 0.3s ease;
      width: 0%;
    }
    .mc-progress__text {
      font-size: var(--text-sm);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    /* Certificate CTA */
    .mc-cert-cta {
      background: var(--gold-pale);
      border: 2px solid var(--gold);
      border-radius: 8px;
      padding: var(--space-lg);
      text-align: center;
      margin-block: var(--space-xl);
    }
    .mc-cert-cta h2 {
      color: var(--navy);
    }

    /* What you'll learn */
    .mc-learn {
      margin-block: var(--space-xl);
    }
    .mc-learn h2 {
      color: var(--navy);
      margin-block-end: var(--space-md);
    }
    .mc-learn__list {
      padding-inline-start: var(--space-md);
    }
    .mc-learn__list li {
      margin-block-end: var(--space-xs);
    }

    /* FAQ */
    .mc-faq {
      margin-block: var(--space-xl);
    }
    .mc-faq h2 {
      color: var(--navy);
      margin-block-end: var(--space-md);
    }
    .mc-faq details {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-block-end: var(--space-xs);
      overflow: hidden;
    }
    .mc-faq summary {
      padding: var(--space-sm) var(--space-md);
      cursor: pointer;
      font-weight: bold;
      background: var(--paper-warm);
    }
    .mc-faq summary:hover {
      background: var(--paper-card);
    }
    .mc-faq details p {
      padding: var(--space-sm) var(--space-md);
      margin: 0;
    }

    /* WhatsApp */
    .mc-whatsapp {
      text-align: center;
      margin-block: var(--space-lg);
    }

    @media (max-width: 600px) {
      .mc-stats {
        gap: var(--space-md);
      }
      .mc-stat__number {
        font-size: var(--text-h3);
      }
      .mc-subscribe {
        padding: var(--space-sm);
      }
    }
  </style>

  <script is:inline>
    var totalLessons = 9;

    function getCompleted() {
      var count = 0;
      for (var i = 1; i <= totalLessons; i++) {
        if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true') count++;
      }
      return count;
    }

    // Check enrollment
    var isEnrolled = localStorage.getItem('urai-mc-enrolled') === 'true';
    var completed = getCompleted();

    function goToNextLesson() {
      var target = 1;
      for (var i = 1; i <= totalLessons; i++) {
        if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') !== 'true') {
          target = i;
          break;
        }
      }
      window.location.href = window.location.pathname.replace(/\/$/, '') + '/' + target + '/';
    }

    if (isEnrolled || completed > 0) {
      // Already enrolled — hide subscribe section entirely
      var subscribeSection = document.getElementById('mc-subscribe');
      if (subscribeSection) {
        subscribeSection.innerHTML = '<a href="javascript:void(0)" class="btn-primary" id="continue-btn" style="font-size:1.1rem; padding:1rem 2.5rem;">' +
          (completed > 0 ? 'کورس جاری رکھیں →' : 'کورس شروع کریں →') + '</a>';
        document.getElementById('continue-btn').addEventListener('click', goToNextLesson);
      }
    }

    // Subscribe form
    var subForm = document.getElementById('subscribe-form');
    if (subForm) {
      subForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = document.getElementById('subscribe-email').value.trim();
        if (!email) return;
        // Open Substack subscribe in new tab with email prefilled
        window.open('https://www.urduaiupdates.com/subscribe?email=' + encodeURIComponent(email), '_blank');
        // Mark enrolled and navigate
        localStorage.setItem('urai-mc-enrolled', 'true');
        goToNextLesson();
      });
    }

    // Update syllabus status + locking
    for (var i = 1; i <= totalLessons; i++) {
      var isComplete = localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true';
      var statusEl = document.getElementById('status-' + i);
      var itemEl = document.querySelector('[data-lesson="' + i + '"]');
      if (isComplete) {
        if (statusEl) statusEl.textContent = 'مکمل';
        if (itemEl) itemEl.classList.add('completed');
      } else if (i > 1) {
        // Lock if previous lesson not complete
        var prevComplete = localStorage.getItem('urai-mc-lesson-' + (i - 1) + '-complete') === 'true';
        if (!prevComplete && itemEl) {
          itemEl.classList.add('locked');
          if (statusEl) statusEl.textContent = 'لاکڈ';
          // Disable the link
          var link = itemEl.querySelector('.mc-syllabus__link');
          if (link) {
            link.style.pointerEvents = 'none';
            link.style.opacity = '0.5';
          }
        }
      }
    }

    // Show progress if any lessons completed
    if (completed > 0) {
      var progressOverview = document.getElementById('mc-progress-overview');
      if (progressOverview) progressOverview.style.display = 'flex';
      var fill = document.getElementById('mc-progress-fill');
      var text = document.getElementById('mc-progress-text');
      var pct = Math.round((completed / totalLessons) * 100);
      if (fill) fill.style.width = pct + '%';
      if (text) text.textContent = completed + '/' + totalLessons + ' مکمل';
    }

    // Show certificate CTA if all complete
    if (completed === totalLessons) {
      var certCta = document.getElementById('mc-cert-cta');
      if (certCta) certCta.style.display = 'block';
    }
  </script>
</Base>
