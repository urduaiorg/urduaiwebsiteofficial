const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="AI course in Urdu free Pakistan: online certificate"
  description="AI course in Urdu free Pakistan: beginners کے لیے 9 online video lessons، quizzes، certificate path، ChatGPT، Gemini، prompts اور AI tools۔"
  canonical="https://urduai.org/courses/masterclass/"
  adsense={false}
  schema={courseSchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container mc-landing" style="margin-block-start: var(--space-xl);">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/courses/`}>کورسز</a></li>
        <li aria-current="page">ماسٹرکلاس</li>
      </ol>
    </nav>

    <!-- Hero -->
    <div class="mc-hero">
      <span class="badge badge--gold">Free AI course</span>
      <h1>AI course in Urdu free Pakistan: online lessons اور certificate</h1>
      <p class="mc-hero__subtitle">
        AI course in Urdu free Pakistan کا واضح راستہ اردو اے آئی ماسٹرکلاس ہے: beginners کے لیے 9 online video lessons، quizzes اور completion certificate pathway۔ اس میں AI کیا ہے، ChatGPT، Gemini، Claude، prompts، AI images، voice، avatars، vibe coding اور website building سادہ ترتیب سے سکھائی جاتی ہے۔
      </p>
      <div class="mc-stats">
        <div class="mc-stat">
          <span class="mc-stat__number">9</span>
          <span class="mc-stat__label">ویڈیو اسباق</span>
        </div>
        <div class="mc-stat">
          <span class="mc-stat__number">50K+</span>
          <span class="mc-stat__label">سیکھنے والے</span>
        </div>
        <div class="mc-stat">
          <span class="mc-stat__number">مفت</span>
          <span class="mc-stat__label">certificate</span>
        </div>
      </div>
    </div>

    <section class="mc-answer" aria-labelledby="mc-answer-title">
      <h2 id="mc-answer-title">فوری جواب: یہ AI course کس کے لیے ہے؟</h2>
      <p>
        یہ AI course in Urdu ان beginners کے لیے ہے جو Pakistan یا اردو بولنے والی community میں mobile یا laptop پر AI سیکھنا چاہتے ہیں۔ پہلے سبق میں <a href={`${base}/guides/ai-kya-hai-urdu-ai-master-class-1/`}>AI کیا ہے؟</a> سمجھایا جاتا ہے، پھر <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini</a>، ChatGPT، Claude، prompts، AI images، voice اور beginner web ideas کی practice آتی ہے۔
      </p>
      <div class="mc-answer__grid">
        <div>
          <strong>شروع کرنے کے لیے</strong>
          <span>Google account، internet اور 20-30 minutes روزانہ</span>
        </div>
        <div>
          <strong>مناسب learners</strong>
          <span>students، teachers، freelancers، job seekers، small business owners</span>
        </div>
        <div>
          <strong>اگلا practical step</strong>
          <span><a href={`${base}/courses/masterclass/1/`}>سبق 1 شروع کریں</a> یا پہلے <a href={`${base}/learn/artificial-intelligence/`}>مصنوعی ذہانت</a> پڑھیں</span>
        </div>
        <div>
          <strong>یہ course کس کے لیے ہے؟</strong>
          <span>AI course، AI courses online free، artificial intelligence course، AI courses in Pakistan</span>
        </div>
      </div>
    </section>

    <section class="mc-start-path" aria-labelledby="mc-start-path-title">
      <h2 id="mc-start-path-title">اگر آپ بالکل نئے ہیں تو یہاں سے شروع کریں</h2>
      <p>
        ماسٹرکلاس شروع کرنے سے پہلے بنیاد صاف رکھیں: پہلے AI کی سادہ تعریف پڑھیں، پھر Gemini میں اردو سوال پوچھنے کی مشق کریں، اور پھر سبق 1 شروع کریں۔
      </p>
      <div class="mc-start-path__links">
        <a href={`${base}/learn/artificial-intelligence/`}>مصنوعی ذہانت کیا ہے؟</a>
        <a href={`${base}/guides/free-ai-course-urdu/`}>مفت AI کورس گائیڈ</a>
        <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`}>Gemini اردو گائیڈ</a>
        <a href={`${base}/blog/google-ai-studio-kia-hai/`}>Google AI Studio گائیڈ</a>
        <a href={`${base}/tools/`}>AI Tools Directory</a>
      </div>
    </section>

    <section class="mc-course-fit" aria-labelledby="mc-course-fit-title">
      <h2 id="mc-course-fit-title">AI courses in Pakistan تلاش کر رہے ہیں؟</h2>
      <p>
        اگر آپ Google پر AI course، AI courses online free، artificial intelligence course یا AI courses in Pakistan تلاش کر رہے ہیں تو پہلے یہ دیکھیں کہ course beginner-friendly، Urdu/English mix کو سمجھنے والا، mobile پر readable، اور practical prompts کے ساتھ ہو۔ Urdu AI Masterclass اسی need کے لیے بنایا گیا ہے: پہلے foundation، پھر tools، پھر small practical projects۔
      </p>
      <ul>
        <li>Beginners کے لیے: کوئی coding background ضروری نہیں۔</li>
        <li>Students کے لیے: Gemini، prompts، summaries اور self-test practice سے شروع کریں۔</li>
        <li>Freelancers کے لیے: writing، proposal، content اور client workflow کی بنیاد بنائیں۔</li>
        <li>Small business کے لیے: WhatsApp posts، product descriptions اور basic marketing prompts سیکھیں۔</li>
      </ul>
    </section>

    <!-- Subscribe + enroll section -->
    <div class="mc-subscribe" id="mc-subscribe">
      <h2>AI course شروع کریں</h2>
      <p class="text-muted">اپنا ای میل درج کریں — اردو اے آئی اپڈیٹس آپ کو ملتی رہیں گی اور کورس شروع ہو جائے گا۔</p>
      <form id="subscribe-form" class="mc-subscribe__form">
        <div class="mc-subscribe__input-group">
          <input
            type="email"
            id="subscribe-email"
            name="email"
            required
            placeholder="آپ کا ای میل ایڈریس"
            dir="ltr"
          />
          <button type="submit" class="btn-primary">سبسکرائب کریں</button>
        </div>
      </form>
    </div>

    <!-- Syllabus -->
    <div class="mc-syllabus">
      <h2>نصاب — 9 اسباق</h2>
      <div class="mc-progress-overview" id="mc-progress-overview" style="display:none;">
        <div class="mc-progress__bar">
          <div class="mc-progress__fill" id="mc-progress-fill"></div>
        </div>
        <span class="mc-progress__text" id="mc-progress-text"></span>
      </div>
      <ol class="mc-syllabus__list">
        {lessons.map((lesson) => (
          <li class="mc-syllabus__item" data-lesson={lesson.number}>
            <a href={`${base}/courses/masterclass/${lesson.number}/`} class="mc-syllabus__link">
              <span class="mc-syllabus__num">{lesson.number}</span>
              <span class="mc-syllabus__title">{lesson.title}</span>
              <span class="mc-syllabus__status" id={`status-${lesson.number}`}></span>
            </a>
            {lesson.tools.length > 0 && (
              <span class="mc-syllabus__tools">
                {lesson.tools.map((t) => t.name).join('، ')}
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>

    <!-- Certificate CTA -->
    <div class="mc-cert-cta" id="mc-cert-cta" style="display:none;">
      <h2>تمام اسباق مکمل!</h2>
      <p>آپ نے 9 میں سے 9 اسباق مکمل کر لیے ہیں۔ اب اپنا سرٹیفکیٹ حاصل کریں۔</p>
      <a href={`${base}/courses/masterclass/certificate/`} class="btn-primary">
        سرٹیفکیٹ حاصل کریں →
      </a>
    </div>

    <!-- What you'll learn -->
    <div class="mc-learn">
      <h2>آپ کیا سیکھیں گے؟</h2>
      <ul class="mc-learn__list">
        <li>AI کیا ہے اور یہ کیسے کام کرتا ہے — بالکل شروع سے</li>
        <li>ChatGPT، Gemini، Claude — مشہور AI ٹولز استعمال کرنا</li>
        <li>AI سے اردو میں لکھنا، ترجمہ کرنا، اور تجزیہ کرنا</li>
        <li>AI سے تصاویر، ویڈیوز، آواز، اور موسیقی بنانا</li>
        <li>وائب کوڈنگ — بغیر کوڈ سیکھے ایپس اور ویب سائٹس بنانا</li>
        <li>AI اوتار بنانا — ڈیجیٹل انسان جو آپ کے لیے بولے</li>
        <li>اپنی پہلی ویب سائٹ AI سے بنانا اور لائیو کرنا</li>
      </ul>
    </div>

    <!-- FAQ section -->
    <div class="mc-faq">
      <h2>عام سوالات</h2>
      <details>
        <summary>کیا یہ AI course Urdu میں free ہے؟</summary>
