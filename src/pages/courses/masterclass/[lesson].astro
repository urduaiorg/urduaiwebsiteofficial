---
import Base from '../../../layouts/Base.astro';
import { lessons } from '../../../data/masterclass-lessons';

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { lesson: String(lesson.number) },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Convert simple Markdown to HTML
function mdToHtml(md: string): string {
  return md
    .split('\n\n')
    .map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('## ')) {
        return `<h2>${block.slice(3)}</h2>`;
      }
      // Bold
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      // Line breaks within a paragraph
      block = block.replace(/\n/g, '<br>');
      return `<p>${block}</p>`;
    })
    .join('\n');
}

const lessonHtml = mdToHtml(lesson.description);

const prevLesson = lesson.number > 1 ? lesson.number - 1 : null;
const nextLesson = lesson.number < lessons.length ? lesson.number + 1 : null;

// Extract first paragraph as plain text for description
function toPlainText(text: string): string {
  return text
    .replace(/<[^>]+>/g, '')
    .replace(/\*\*/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

const firstPara = toPlainText(lesson.description.split('\n\n').find(b => !b.trim().startsWith('##')) || '').slice(0, 160) || lesson.title;
const pageTitle = lesson.number === 1
  ? 'Free AI course in Urdu: سبق 1 — AI کیا ہے؟'
  : `سبق ${lesson.number}: ${lesson.title} — اردو اے آئی ماسٹرکلاس`;
const pageDescription = lesson.number === 1
  ? 'AI kya hai in Urdu کا آسان جواب، مصنوعی ذہانت کی تعریف، روزمرہ examples، Gemini/ChatGPT practice، quiz اور free course path۔'
  : `${firstPara.slice(0, 140)}۔ ویڈیو دیکھیں، سیکھیں، کوئز دیں — مفت اردو AI کورس۔`;

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "learningResourceType": "Video Lesson",
  "name": `سبق ${lesson.number}: ${lesson.title}`,
  "description": firstPara,
  "provider": { "@type": "Organization", "name": "اردو اے آئی", "url": "https://urduai.org" },
  "inLanguage": "ur",
  "isAccessibleForFree": true,
  ...(lesson.number === 1 ? {
    "educationalLevel": "Beginner",
    "teaches": [
      "AI kya hai in Urdu",
      "AI meaning in Urdu",
      "Machine learning basics",
      "Beginner AI practice with ChatGPT and Gemini",
      "AI courses online free in Pakistan",
      "Artificial intelligence course for beginners",
    ],
    "about": [
      { "@type": "Thing", "name": "Artificial Intelligence" },
      { "@type": "Thing", "name": "Machine Learning" },
      { "@type": "Thing", "name": "AI course Urdu" },
    ],
  } : {}),
  "url": `https://urduai.org/courses/masterclass/${lesson.number}/`,
  "isPartOf": {
    "@type": "Course",
    "name": "اردو اے آئی ماسٹرکلاس",
    "url": "https://urduai.org/courses/masterclass/",
  },
  "position": lesson.number,
  "instructor": {
    "@type": "Person",
    "name": "قیصر رونجھا",
  },
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": `سبق ${lesson.number}: ${lesson.title} — اردو اے آئی ماسٹرکلاس`,
  "description": firstPara,
  "thumbnailUrl": `https://img.youtube.com/vi/${lesson.videoId}/maxresdefault.jpg`,
  "uploadDate": "2024-01-01",
  "contentUrl": `https://www.youtube.com/watch?v=${lesson.videoId}`,
  "embedUrl": `https://www.youtube.com/embed/${lesson.videoId}`,
  "inLanguage": "ur",
  "publisher": {
    "@type": "Organization",
    "name": "اردو اے آئی",
    "url": "https://urduai.org",
  },
};

const lessonOneFaq = lesson.number === 1 ? [
  {
    question: "AI kya hai in Urdu?",
    answer: "AI یعنی artificial intelligence کمپیوٹر کی وہ صلاحیت ہے جس سے وہ examples سے pattern سیکھ کر writing، translation، image، recommendation یا decision جیسے کاموں میں مدد دے سکتا ہے۔",
  },
  {
    question: "AI meaning in Urdu کیا ہے؟",
    answer: "AI meaning in Urdu عام طور پر مصنوعی ذہانت ہے۔ اس کا مطلب ایسا کمپیوٹر سسٹم ہے جو data، examples اور instructions سے pattern سمجھ کر انسان کی مدد کرتا ہے۔",
  },
  {
    question: "What is AI in Urdu کا آسان جواب کیا ہے؟",
    answer: "آسان جواب یہ ہے کہ AI ایک مددگار tool ہے جو زبان، تصویر، آواز، search، translation اور recommendations جیسے کاموں میں patterns سمجھ کر جواب یا مشورہ دیتا ہے۔",
  },
  {
    question: "کیا یہ AI course Urdu میں beginners کے لیے ہے؟",
    answer: "جی ہاں۔ یہ پہلا سبق beginners کے لیے ہے۔ اس میں AI کی تعریف، machine learning، روزمرہ examples، ChatGPT/Gemini practice اور quiz شامل ہے۔",
  },
  {
    question: "کیا یہ free AI course Urdu ہے؟",
    answer: "جی ہاں۔ اردو اے آئی ماسٹرکلاس کا یہ پہلا سبق مفت ہے، ad-free ہے، اور beginners کو AI کی بنیادی تعریف، examples، practice prompt اور quiz سے شروع کرواتا ہے۔",
  },
  {
    question: "AI course online free Pakistan میں کیسے شروع کریں؟",
    answer: "سب سے پہلے lesson 1 سے AI kya hai in Urdu سمجھیں، پھر Gemini یا ChatGPT میں ایک practical prompt آزمائیں، اور Masterclass کے 9 lessons ترتیب سے مکمل کریں۔",
  },
  {
    question: "Artificial intelligence course free certificate کا راستہ کیا ہے؟",
    answer: "Urdu AI Masterclass میں lessons اور quizzes مکمل کریں، پھر certificate form پر جائیں۔ یہ Urdu AI completion certificate ہے، university degree نہیں۔",
  },
  {
    question: "AI course شروع کرنے کے لیے کیا پہلے coding آنا ضروری ہے؟",
    answer: "نہیں۔ پہلے سبق کے لیے coding ضروری نہیں۔ آپ phone یا laptop پر Gemini یا ChatGPT میں سادہ Urdu prompt لکھ کر practice شروع کر سکتے ہیں۔",
  },
  {
    question: "AI courses in Pakistan تلاش کرنے والے یہاں سے کیسے شروع کریں؟",
    answer: "اگر آپ Pakistan میں AI سیکھنا چاہتے ہیں تو پہلے lesson 1 سے AI کی بنیادی تعریف سمجھیں، پھر lesson 2 میں AI tools کی اقسام، اور بعد میں Gemini یا ChatGPT پر practical prompts کی practice کریں۔",
  },
  {
    question: "سبق 1 کے بعد اگلا قدم کیا ہے؟",
    answer: "سبق 1 کے بعد Masterclass کا lesson 2 کھولیں، AI tools directory دیکھیں، اور Gemini Urdu guide یا ChatGPT app guide سے ایک real task پر practice کریں۔",
  },
] : [];

const faqSchema = lessonOneFaq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": lessonOneFaq.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer },
  })),
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "کورسز", "item": "https://urduai.org/courses/" },
    { "@type": "ListItem", "position": 3, "name": "ماسٹرکلاس", "item": "https://urduai.org/courses/masterclass/" },
    { "@type": "ListItem", "position": 4, "name": `سبق ${lesson.number}`, "item": `https://urduai.org/courses/masterclass/${lesson.number}/` },
  ],
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={`https://urduai.org/courses/masterclass/${lesson.number}/`}
  adsense={false}
  schema={courseSchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="container lesson-page" style="margin-block-start: var(--space-xl);">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/courses/`}>کورسز</a></li>
        <li><a href={`${base}/courses/masterclass/`}>ماسٹرکلاس</a></li>
        <li aria-current="page">سبق {lesson.number}</li>
      </ol>
    </nav>

    <!-- Progress bar -->
    <div class="mc-progress" id="mc-progress">
      <div class="mc-progress__bar">
        <div class="mc-progress__fill" id="mc-progress-fill"></div>
      </div>
      <span class="mc-progress__text" id="mc-progress-text"></span>
    </div>

    <!-- Lesson locked message (shown via JS if previous lesson not complete) -->
    {lesson.number > 1 && (
      <div id="lesson-locked" class="lesson-locked" style="display:none;">
        <h1>سبق {lesson.number}: {lesson.title}</h1>
        <div class="lesson-locked__box">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="var(--navy)" style="margin-block-end: var(--space-sm);"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM12 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/></svg>
          <p><strong>یہ سبق ابھی لاکڈ ہے۔</strong></p>
          <p>اس سبق تک رسائی کے لیے پہلے سبق {lesson.number - 1} کا کوئز پاس کریں۔</p>
          <a href={`${base}/courses/masterclass/${lesson.number - 1}/`} class="btn-primary" style="margin-block-start: var(--space-md);">
            سبق {lesson.number - 1} پر جائیں ←
          </a>
        </div>
      </div>
    )}

    <!-- Lesson content (hidden via JS if locked) -->
    <div id="lesson-content">
    <!-- Lesson title -->
    <h1>{lesson.number === 1 ? 'سبق 1: AI کیا ہے؟' : `سبق ${lesson.number}: ${lesson.title}`}</h1>

    {lesson.number === 1 && (
      <p class="lesson-deck">Free AI course in Urdu کا پہلا سبق: مصنوعی ذہانت کی آسان تعریف، روزمرہ examples اور پہلا practical prompt۔</p>
    )}

    {lesson.number === 1 && (
      <section class="lesson-answer" aria-labelledby="lesson-answer-title">
        <h2 id="lesson-answer-title">فوری جواب: AI kya hai in Urdu؟</h2>
        <p>
          AI یعنی artificial intelligence یا مصنوعی ذہانت کمپیوٹر کی وہ صلاحیت ہے جس سے وہ examples سے pattern سیکھ کر writing، translation، image، recommendation اور decision support جیسے کاموں میں مدد دیتا ہے۔ یہ free AI course Urdu کا پہلا سبق ہے: پہلے تعریف سمجھیں، پھر Gemini یا ChatGPT میں ایک prompt آزمائیں، پھر quiz دے کر اگلا lesson کھولیں۔
        </p>
        <table>
          <tbody>
            <tr>
              <th>Course type</th>
              <td>Free online AI course in Urdu</td>
            </tr>
            <tr>
              <th>Beginner topic</th>
              <td>AI kya hai in Urdu، AI meaning، machine learning basics</td>
            </tr>
            <tr>
              <th>Practice</th>
              <td>Gemini یا ChatGPT میں آسان Urdu prompt لکھنا</td>
            </tr>
            <tr>
              <th>Next step</th>
              <td><a href={`${base}/courses/masterclass/2/`}>سبق 2: AI کی اقسام</a></td>
            </tr>
          </tbody>
        </table>
      </section>
    )}

    <!-- YouTube embed -->
    <div class="video-embed">
      <iframe
        src={`https://www.youtube.com/embed/${lesson.videoId}?rel=0`}
        title={lesson.title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    {lesson.number === 1 && (
      <section class="lesson-start" aria-labelledby="lesson-start-title">
        <h2 id="lesson-start-title">AI course Urdu شروع کرنے کا صحیح طریقہ</h2>
        <p>
          اگر آپ پاکستان یا کسی بھی اردو بولنے والی کمیونٹی میں AI پہلی بار سیکھ رہے ہیں تو یہی پہلا سبق شروع کریں۔ پہلے AI کا آسان مطلب سمجھیں، پھر ایک چھوٹا prompt Gemini یا ChatGPT میں آزمائیں، اور آخر میں quiz دے کر lesson 2 پر جائیں۔
        </p>
        <div class="lesson-start__grid">
          <a href={`${base}/learn/artificial-intelligence/`} data-analytics-event="course_path_click" data-analytics-location="lesson_1_definition">
            <strong>1. تعریف سمجھیں</strong>
            <span>مصنوعی ذہانت کیا ہے؟</span>
          </a>
          <a href={`${base}/how-to/how-to-use-gemini-in-urdu/`} data-analytics-event="course_path_click" data-analytics-location="lesson_1_practice">
            <strong>2. عملی مشق کریں</strong>
            <span>Gemini میں اردو سوال پوچھیں</span>
          </a>
          <a href={`${base}/guides/free-ai-course-urdu/`} data-analytics-event="course_path_click" data-analytics-location="lesson_1_learning_path">
            <strong>3. مکمل راستہ دیکھیں</strong>
            <span>مفت AI کورس اردو میں کہاں سے شروع کریں</span>
          </a>
        </div>
      </section>
    )}

    <!-- Written lesson content -->
    <article class="lesson-content prose" set:html={lessonHtml} />

    {lesson.number === 1 && (
      <section class="lesson-faq" aria-labelledby="lesson-faq-title">
        <h2 id="lesson-faq-title">سبق 1 کے عام سوالات</h2>
        {lessonOneFaq.map(({ question, answer }) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>
    )}

    <!-- Tools box -->
    {lesson.tools.length > 0 && (
      <div class="tools-box">
        <h2 class="tools-box__title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-inline-end: 0.5rem;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          اس سبق میں استعمال ہونے والے ٹولز
        </h2>
        <ul class="tools-box__list">
          {lesson.tools.map((tool) => (
            <li class="tools-box__item">
              <a href={tool.url} target="_blank" rel="noopener noreferrer" class="tools-box__link" data-analytics-event="course_tool_open" data-analytics-location={tool.name}>
                {tool.name}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-inline-start: 0.3rem;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <span class="tools-box__desc">{tool.descriptionUr}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Quiz section -->
    <div class="quiz-section" id="quiz-section">
      <h2>کوئز — سبق {lesson.number}</h2>
      <p class="text-muted">60% یا اس سے زیادہ نمبر حاصل کریں تاکہ اگلے سبق تک رسائی ملے۔</p>

      <form id="quiz-form" class="quiz-form">
        {lesson.quiz.map((q, qi) => (
          <fieldset class="quiz-question" data-correct={q.correctIndex}>
            <legend>{qi + 1}. {q.question}</legend>
            {q.options.map((opt, oi) => (
              <label class="quiz-option">
                <input type="radio" name={`q${qi}`} value={String(oi)} required />
                <span>{opt}</span>
              </label>
            ))}
          </fieldset>
        ))}
        <button type="submit" class="btn-primary" id="quiz-submit" data-analytics-event="course_quiz_submit" data-analytics-location={`lesson_${lesson.number}`}>جوابات جمع کرائیں</button>
      </form>

      <div id="quiz-result" class="quiz-result" style="display:none;">
        <div id="quiz-result-content"></div>
      </div>
    </div>

    </div><!-- /lesson-content -->

    <!-- Navigation -->
    <div class="lesson-nav" id="lesson-nav">
      {prevLesson && (
        <a href={`${base}/courses/masterclass/${prevLesson}/`} class="lesson-nav__link lesson-nav__prev">
          پچھلا سبق ←
        </a>
      )}
      {nextLesson ? (
        <a href={`${base}/courses/masterclass/${nextLesson}/`} class="lesson-nav__link lesson-nav__next" id="next-lesson-link" style="display:none;">
          → اگلا سبق
        </a>
      ) : (
        <a href={`${base}/courses/masterclass/certificate/`} class="lesson-nav__link lesson-nav__next" id="next-lesson-link" style="display:none;">
          → سرٹیفکیٹ حاصل کریں
        </a>
      )}
    </div>
  </div>

  <style>
    .lesson-page {
      max-width: var(--max-width);
      padding-block-end: var(--space-2xl);
    }

    /* Lesson locked */
    .lesson-locked__box {
      text-align: center;
      background: var(--paper-warm);
      border: 2px solid var(--navy);
      border-radius: 12px;
      padding: var(--space-xl);
      margin-block: var(--space-lg);
    }
    .lesson-locked__box p {
      margin-block-end: var(--space-xs);
    }

    /* Progress bar */
    .mc-progress {
      margin-block: var(--space-md);
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }
    .mc-progress__bar {
      flex: 1;
      height: 8px;
      background: var(--paper-warm);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .lesson-answer {
      border-block: 1px solid var(--border);
      padding-block: var(--space-md);
      margin-block: var(--space-md);
    }

    .lesson-deck {
      max-width: 760px;
      color: var(--ink-soft);
      font-size: 1.08rem;
      line-height: var(--lh-prose);
      margin-block: calc(-1 * var(--space-xs)) var(--space-md);
    }

    .lesson-answer h2 {
      font-size: var(--text-h2);
      line-height: var(--lh-heading);
      margin-block-end: var(--space-xs);
    }

    .lesson-answer p {
      color: var(--ink-soft);
      line-height: var(--lh-prose);
      max-width: 760px;
    }

    .lesson-answer table {
      width: 100%;
      border-collapse: collapse;
      margin-block-start: var(--space-sm);
      background: var(--paper-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }

    .lesson-answer th,
    .lesson-answer td {
      border-block-end: 1px solid var(--border);
      padding: 0.75rem;
      text-align: start;
      vertical-align: top;
    }

    .lesson-answer tr:last-child th,
    .lesson-answer tr:last-child td {
      border-block-end: 0;
    }

    .lesson-answer th {
      color: var(--ink);
      width: 34%;
      background: var(--paper-warm);
    }
    .mc-progress__fill {
      height: 100%;
      background: var(--navy);
      border-radius: 4px;
      transition: width 0.3s ease;
      width: 0%;
    }
    .mc-progress__text {
      font-size: var(--text-sm);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    /* Video embed */
    .video-embed {
      position: relative;
      width: 100%;
      padding-block-end: 56.25%;
      margin-block: var(--space-lg);
      border-radius: 8px;
      overflow: hidden;
      background: var(--ink);
    }
    .video-embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .lesson-start {
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-md);
      margin-block: var(--space-lg);
    }
    .lesson-start h2 {
      color: var(--navy);
      margin-block-end: var(--space-xs);
    }
    .lesson-start p {
      margin-block-end: var(--space-md);
    }
    .lesson-start__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-sm);
    }
    .lesson-start__grid a {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-height: 96px;
      padding: var(--space-sm);
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--paper-card);
      text-decoration: none;
    }
    .lesson-start__grid strong {
      color: var(--navy);
    }
    .lesson-start__grid span {
      color: var(--ink-soft);
      font-size: var(--text-sm);
      line-height: var(--lh-body);
    }

    /* Lesson content */
    .lesson-content {
      margin-block: var(--space-lg);
      line-height: var(--lh-prose);
    }
    .lesson-content :global(h2) {
      font-size: var(--text-h2);
      line-height: var(--lh-heading);
      margin-block-start: var(--space-lg);
      margin-block-end: var(--space-sm);
      color: var(--navy);
    }
    .lesson-content :global(p) {
      margin-block-end: var(--space-sm);
    }

    .lesson-faq {
      margin-block: var(--space-xl);
    }
    .lesson-faq h2 {
      color: var(--navy);
      margin-block-end: var(--space-sm);
    }
    .lesson-faq details {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-block-end: var(--space-xs);
      overflow: hidden;
      background: var(--paper-card);
    }
    .lesson-faq summary {
      padding: var(--space-sm) var(--space-md);
      cursor: pointer;
      font-weight: bold;
      background: var(--paper-warm);
    }
    .lesson-faq p {
      padding: var(--space-sm) var(--space-md);
      margin: 0;
    }

    /* Tools box */
    .tools-box {
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-md);
      margin-block: var(--space-lg);
    }
    .tools-box__title {
      font-size: var(--text-h3);
      line-height: var(--lh-h3);
      margin-block-end: var(--space-sm);
      color: var(--navy);
    }
    .tools-box__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .tools-box__item {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem;
    }
    .tools-box__link {
      font-weight: bold;
      color: var(--navy);
      text-decoration: none;
      border-bottom: 1px solid var(--navy);
    }
    .tools-box__link:hover {
      color: var(--navy-light);
    }
    .tools-box__desc {
      color: var(--ink-muted);
      font-size: var(--text-sm);
    }

    /* Quiz */
    .quiz-section {
      margin-block: var(--space-xl);
      background: var(--paper-card);
      border: 2px solid var(--navy);
      border-radius: 8px;
      padding: var(--space-lg);
    }
    .quiz-section h2 {
      color: var(--navy);
      margin-block-end: var(--space-xs);
    }
    .quiz-question {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-md);
      margin-block: var(--space-md);
    }
    .quiz-question legend {
      font-weight: bold;
      padding: 0 var(--space-xs);
    }
    .quiz-option {
      display: flex;
      align-items: flex-start;
      gap: var(--space-xs);
      padding: var(--space-xs) 0;
      cursor: pointer;
    }
    .quiz-option input[type="radio"] {
      margin-block-start: 0.6rem;
      accent-color: var(--navy);
    }
    .quiz-option span {
      flex: 1;
    }
    .quiz-option.correct span {
      color: #0e6b5e;
      font-weight: bold;
    }
    .quiz-option.wrong span {
      color: #c0392b;
      text-decoration: line-through;
    }

    .btn-primary {
      display: inline-block;
      background: var(--navy);
      color: #fff;
      border: none;
      padding: 0.8rem 2rem;
      border-radius: 6px;
      font-size: var(--text-base);
      font-family: inherit;
      cursor: pointer;
      margin-block-start: var(--space-sm);
    }
    .btn-primary:hover {
      background: var(--navy-dark);
    }
    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .quiz-result {
      margin-block-start: var(--space-md);
      padding: var(--space-md);
      border-radius: 8px;
    }
    .quiz-result.pass {
      background: #d4edda;
      border: 1px solid #0e6b5e;
    }
    .quiz-result.fail {
      background: #fde8e8;
      border: 1px solid #c0392b;
    }

    /* Lesson nav */
    .lesson-nav {
      display: flex;
      justify-content: space-between;
      gap: var(--space-md);
      margin-block-start: var(--space-xl);
      padding-block-start: var(--space-lg);
      border-block-start: 1px solid var(--border);
    }
    .lesson-nav__link {
      display: inline-block;
      padding: 0.6rem 1.5rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
    }
    .lesson-nav__prev {
      color: var(--ink-muted);
      border: 1px solid var(--border);
    }
    .lesson-nav__prev:hover {
      background: var(--paper-warm);
    }
    .lesson-nav__next {
      background: var(--navy);
      color: #fff;
    }
    .lesson-nav__next:hover {
      background: var(--navy-dark);
    }

    @media (max-width: 600px) {
      .quiz-section {
        padding: var(--space-sm);
      }
      .lesson-start__grid {
        grid-template-columns: 1fr;
      }
      .lesson-nav {
        flex-direction: column;
      }
      .lesson-nav__link {
        text-align: center;
      }
    }
  </style>

  <script is:inline define:vars={{ lessonNumber: lesson.number, totalLessons: lessons.length }}>
    // Lesson locking — must complete previous lesson first
    (function() {
      if (lessonNumber > 1) {
        var prevComplete = localStorage.getItem('urai-mc-lesson-' + (lessonNumber - 1) + '-complete') === 'true';
        if (!prevComplete) {
          // Show locked, hide content and nav
          var locked = document.getElementById('lesson-locked');
          var content = document.getElementById('lesson-content');
          var nav = document.getElementById('lesson-nav');
          if (locked) locked.style.display = 'block';
          if (content) content.style.display = 'none';
          if (nav) nav.style.display = 'none';
          return;
        }
      }
    })();

    // Progress tracking
    function getCompleted() {
      let count = 0;
      for (let i = 1; i <= totalLessons; i++) {
        if (localStorage.getItem('urai-mc-lesson-' + i + '-complete') === 'true') count++;
      }
      return count;
    }

    function updateProgress() {
      const completed = getCompleted();
      const pct = Math.round((completed / totalLessons) * 100);
      const fill = document.getElementById('mc-progress-fill');
      const text = document.getElementById('mc-progress-text');
      if (fill) fill.style.width = pct + '%';
      if (text) text.textContent = completed + '/' + totalLessons + ' مکمل';
    }

    function showNextIfComplete() {
      const isComplete = localStorage.getItem('urai-mc-lesson-' + lessonNumber + '-complete') === 'true';
      const nextLink = document.getElementById('next-lesson-link');
      if (nextLink && isComplete) {
        nextLink.style.display = 'inline-block';
      }
    }

    updateProgress();
    showNextIfComplete();

    // If already completed, disable quiz re-submission and show result
    if (localStorage.getItem('urai-mc-lesson-' + lessonNumber + '-complete') === 'true') {
      var savedScore = localStorage.getItem('urai-mc-lesson-' + lessonNumber + '-score');
      if (savedScore !== null) {
        var resultDiv = document.getElementById('quiz-result');
        var resultContent = document.getElementById('quiz-result-content');
        var submitBtn = document.getElementById('quiz-submit');
        resultDiv.style.display = 'block';
        resultDiv.className = 'quiz-result pass';
        resultContent.innerHTML = '<strong>آپ یہ سبق مکمل کر چکے ہیں۔</strong> نمبر: ' + savedScore + '%';
        if (submitBtn) submitBtn.style.display = 'none';
      }
    }

    // Quiz handler
    document.getElementById('quiz-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var questions = document.querySelectorAll('.quiz-question');
      var total = questions.length;
      var correct = 0;

      questions.forEach(function(q, i) {
        var correctIdx = parseInt(q.getAttribute('data-correct'));
        var selected = q.querySelector('input[name="q' + i + '"]:checked');
        var selectedIdx = selected ? parseInt(selected.value) : -1;

        // Visual feedback
        var options = q.querySelectorAll('.quiz-option');
        options.forEach(function(opt, j) {
          opt.classList.remove('correct', 'wrong');
          if (j === correctIdx) opt.classList.add('correct');
          else if (j === selectedIdx && j !== correctIdx) opt.classList.add('wrong');
        });

        if (selectedIdx === correctIdx) correct++;
      });

      var score = Math.round((correct / total) * 100);
      var passed = score >= 60;

      var resultDiv = document.getElementById('quiz-result');
      var resultContent = document.getElementById('quiz-result-content');
      resultDiv.style.display = 'block';

      if (passed) {
        resultDiv.className = 'quiz-result pass';
        resultContent.innerHTML = '<strong>مبارک ہو!</strong> آپ نے ' + correct + '/' + total + ' سوالات درست کیے (' + score + '%)۔ آپ اگلے سبق پر جا سکتے ہیں۔';
        try {
          localStorage.setItem('urai-mc-lesson-' + lessonNumber + '-complete', 'true');
          localStorage.setItem('urai-mc-lesson-' + lessonNumber + '-score', score);
        } catch (e) {
          // localStorage full (QuotaExceededError) — common on iOS Safari with ITP
          // Progress is shown in the UI but won't persist across sessions
          resultContent.innerHTML += '<br><small style="color:#c0392b;">نوٹ: آپ کا براؤزر پیش رفت محفوظ نہیں کر سکا۔ براہ کرم اگلا سبق ابھی کھولیں۔</small>';
        }
        showNextIfComplete();
        updateProgress();
        document.getElementById('quiz-submit').disabled = true;
      } else {
        resultDiv.className = 'quiz-result fail';
        resultContent.innerHTML = '<strong>دوبارہ کوشش کریں۔</strong> آپ نے ' + correct + '/' + total + ' درست کیے (' + score + '%)۔ 60% درکار ہے۔';
      }

      resultDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
