---
// Base.astro — urduai.org
// All pages extend this layout.
// lang="ur" dir="rtl" is set here — NEVER override.

import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  adsense?: boolean;
  schema?: object;
  articleMeta?: {
    publishedTime?: string;
    author?: string;
    section?: string;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og/urduai-og.jpg',
  ogType = 'website',
  adsense = false,
  schema,
  articleMeta,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, 'https://urduai.org').href;
const ogImageURL = new URL(ogImage, 'https://urduai.org').href;

// Organization schema — present on every page
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "اردو اے آئی",
  "alternateName": "Urdu AI",
  "url": "https://urduai.org",
  "logo": "https://urduai.org/images/logo.png",
  "sameAs": [
    "https://www.facebook.com/urduaiorg",
    "https://www.youtube.com/playlist?list=PLcj1P8Ql0CihyALOpajIbj_yquUC6NlXI",
    "https://www.instagram.com/urduaiorg/",
    "https://x.com/urduaiorg",
    "https://www.tiktok.com/@urduaiorg"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://urduai.org",
  "name": "اردو اے آئی",
  "inLanguage": "ur",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://urduai.org/search/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="ur" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ur" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ur_PK" />
    <meta property="og:site_name" content="اردو اے آئی" />

    {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@urduaiorg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Sitemap & RSS -->
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title="اردو اے آئی" href={`${base}/rss.xml`} />

    <!-- Favicon — SVG primary, PNG fallback, Apple touch icon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.json`} />
    <meta name="theme-color" content="#1d559f" />

    <!-- Google Fonts — Noto Nastaliq Urdu — non-blocking preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;500;600;700&family=Inter:wght@700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;500;600;700&family=Inter:wght@700;800&display=swap"
      />
    </noscript>

    <slot name="head" />

    <!-- Structured data — Organization (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Page-specific schema -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google Analytics 4 + Google Tag -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=GT-T945ZSRZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'GT-T945ZSRZ');
      gtag('config', 'G-CW98PY3REY');
    </script>

    <!-- AdSense — loads ONLY when adsense: true in frontmatter -->
    {adsense && (
      <script>
        window.urduAiAdsInAppBrowser = /FBAN|FBAV|FB_IAB|Instagram/i.test(navigator.userAgent);

        const adsenseScript = document.createElement('script');
        adsenseScript.async = true;
        adsenseScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8532451951782012';
        adsenseScript.crossOrigin = 'anonymous';
        document.head.appendChild(adsenseScript);
      </script>
    )}
    {adsense && (
      <script>
        window.urduAiRetryAdSlot = function (slot, reason) {
          const attempts = Number(slot.dataset.urduAiAdAttempts || '0');
          const maxAttempts = window.urduAiAdsInAppBrowser ? 10 : 4;

          if (attempts >= maxAttempts) {
            slot.dataset.urduAiAdState = `skipped-${reason || 'unavailable'}`;
            return;
          }

          slot.dataset.urduAiAdAttempts = String(attempts + 1);
          slot.dataset.urduAiAdState = 'retrying';
          window.setTimeout(() => {
            delete slot.dataset.urduAiAdState;
            window.urduAiPushSingleAd(slot);
          }, window.urduAiAdsInAppBrowser ? 900 : 500);
        };

        window.urduAiPushSingleAd = function (slot) {
          if (!slot) return;

          const state = slot.dataset.urduAiAdState;
          if (state === 'pushed' || state?.startsWith('skipped') || state === 'error') return;

          const container = slot.closest('.ad-slot') || slot;
          const slotBox = slot.getBoundingClientRect();
          const containerBox = container.getBoundingClientRect();
          const availableWidth = Math.max(slotBox.width, containerBox.width);

          if (availableWidth < 160) {
            window.urduAiRetryAdSlot(slot, 'no-width');
            return;
          }

          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
            slot.dataset.urduAiAdState = 'pushed';
          } catch (error) {
            if (/slot size|availableWidth|No slot/i.test(error?.message || '')) {
              window.urduAiRetryAdSlot(slot, 'slot-size');
              return;
            }

            slot.dataset.urduAiAdState = 'error';
            console.warn('AdSense slot skipped:', error?.message || error);
          }
        };

        window.urduAiPushAds = function () {
          if (window.matchMedia('(max-width: 768px)').matches) {
            document.querySelectorAll(
              '.ad-slot--desktop-only .adsbygoogle[data-ad-slot], .article-layout__sidebar .adsbygoogle[data-ad-slot]'
            ).forEach((slot) => {
              if (slot.dataset.urduAiAdState === 'pushed') return;

              // AdSense always fills the first unprocessed .adsbygoogle node.
              // Remove intentionally hidden desktop slots so a visible mobile
              // in-article push cannot be assigned to a zero-width element.
              slot.classList.remove('adsbygoogle');
              slot.dataset.urduAiAdState = 'skipped-responsive';
            });
          }

          if (!window.urduAiAdTargets) {
            window.urduAiAdTargets = new WeakMap();
          }

          if (!window.urduAiAdObserver && 'IntersectionObserver' in window) {
            window.urduAiAdObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                const slot = window.urduAiAdTargets.get(entry.target);
                window.urduAiAdObserver.unobserve(entry.target);
                window.urduAiPushSingleAd(slot);
              });
            }, { rootMargin: '600px 0px' });
          }

          document.querySelectorAll('.adsbygoogle[data-ad-slot]:not([data-urdu-ai-ad-state])').forEach((slot) => {
            const container = slot.closest('.ad-slot') || slot;
            const box = container.getBoundingClientRect();
            if (box.width < 1 || box.height < 1) {
              window.urduAiRetryAdSlot(slot, 'hidden');
              return;
            }

            if (window.urduAiAdObserver) {
              slot.dataset.urduAiAdState = 'waiting';
              window.urduAiAdTargets.set(container, slot);
              window.urduAiAdObserver.observe(container);
              return;
            }

            window.urduAiPushSingleAd(slot);
          });
        };
      </script>
    )}
  </head>

  <body>
    <a href="#main" class="skip-link">مواد پر جائیں</a>

    <!-- Site header -->
    <header class="site-header">
      <div class="container">
        <div class="site-header__inner">
          <a href={`${base}/`} class="site-logo">Urdu <span>Ai</span></a>
          <nav aria-label="مرکزی نیویگیشن" id="main-nav">
            <ul class="site-nav" id="site-nav-list">
              <li><a href={`${base}/blog/`}>بلاگ</a></li>
              <li><a href={`${base}/guides/`}>گائیڈز</a></li>
              <li><a href={`${base}/how-to/`}>ہاؤ ٹو</a></li>
              <li><a href={`${base}/prompts/`}>پرامٹس</a></li>
              <li><a href={`${base}/tools/`}>ٹولز</a></li>
              <li><a href={`${base}/learn/`}>اردو لغت</a></li>
              <li><a href={`${base}/newsletter/`}>نیوز لیٹر</a></li>
              <li><a href={`${base}/courses/`}>کورسز</a></li>
              <li><a href={`${base}/app/`}>ایپ</a></li>
              <li><a href={`${base}/search/`} class="nav-search-link" aria-label="تلاش">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="vertical-align: -3px;">
                  <circle cx="11" cy="11" r="7"/><path d="M16 16l5 5" stroke-linecap="round"/>
                </svg>
                تلاش
              </a></li>
            </ul>
          </nav>
          <button
            class="nav-hamburger"
            id="nav-hamburger"
            aria-label="نیویگیشن کھولیں"
            aria-expanded="false"
            aria-controls="site-nav-list"
          >
            <svg id="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <svg id="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none;">
              <path d="M18 6L6 18M6 6l12 12" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <script>
      const btn = document.getElementById('nav-hamburger');
      const nav = document.getElementById('site-nav-list');
      const openIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (btn && nav) {
        btn.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('site-nav--open');
          btn.setAttribute('aria-expanded', String(isOpen));
          if (openIcon) openIcon.style.display = isOpen ? 'none' : '';
          if (closeIcon) closeIcon.style.display = isOpen ? '' : 'none';
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
          if (!btn.contains(e.target) && !nav.contains(e.target)) {
            nav.classList.remove('site-nav--open');
            btn.setAttribute('aria-expanded', 'false');
            if (openIcon) openIcon.style.display = '';
            if (closeIcon) closeIcon.style.display = 'none';
          }
        });
      }
    </script>

    <!-- Page content -->
    <main id="main">
      <slot />
    </main>

    <!-- Back to top button -->
    <button class="back-to-top" id="back-to-top" aria-label="اوپر جائیں" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1d559f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <script>
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        window.addEventListener('scroll', () => {
          backToTop.classList.toggle('is-visible', window.scrollY > 500);
        }, { passive: true });
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>

    <script>
      (() => {
        const latinRun = /[A-Za-z0-9][A-Za-z0-9+.#:/@&%$€£₹₨₽₺¥,.'’()_-]*(?:\s+[A-Za-z0-9+.#:/@&%$€£₹₨₽₺¥,.'’()_-]+)*/g;
        const skipSelector = [
          'script',
          'style',
          'noscript',
          'template',
          'code',
          'pre',
          'kbd',
          'samp',
          'textarea',
          'input',
          'select',
          'option',
          'svg',
          'math',
          'iframe',
          'bdi',
          '[dir="ltr"]',
          '.ltr',
          '.bidi-ltr',
          '.site-logo',
          '.adsbygoogle',
          '.pagefind-ui'
        ].join(',');

        const shouldSkip = (node) => {
          const parent = node.parentElement;
          return !parent || parent.closest(skipSelector) || parent.closest('[data-bidi-skip]');
        };

        const isolateMixedText = (root = document.body) => {
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
              if (!node.nodeValue || !latinRun.test(node.nodeValue) || shouldSkip(node)) {
                latinRun.lastIndex = 0;
                return NodeFilter.FILTER_REJECT;
              }
              latinRun.lastIndex = 0;
              return NodeFilter.FILTER_ACCEPT;
            }
          });

          const textNodes = [];
          while (walker.nextNode()) textNodes.push(walker.currentNode);

          textNodes.forEach((node) => {
            const text = node.nodeValue;
            const fragment = document.createDocumentFragment();
            let lastIndex = 0;

            text.replace(latinRun, (match, index) => {
              if (index > lastIndex) {
                fragment.appendChild(document.createTextNode(text.slice(lastIndex, index)));
              }

              const bdi = document.createElement('bdi');
              bdi.dir = 'ltr';
              bdi.className = 'bidi-ltr';
              bdi.textContent = match;
              fragment.appendChild(bdi);
              lastIndex = index + match.length;
              return match;
            });

            if (lastIndex < text.length) {
              fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
            }

            node.parentNode.replaceChild(fragment, node);
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => isolateMixedText(), { once: true });
        } else {
          isolateMixedText();
        }
      })();
    </script>

    <!-- Site footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div>
            <p><strong>اردو اے آئی</strong></p>
            <p>پاکستان کا سب سے بڑا اردو زبان میں اے آئی خواندگی پلیٹ فارم</p>
          </div>
          <div>
            <p><strong>مواد</strong></p>
            <ul style="list-style:none">
              <li><a href={`${base}/blog/`}>بلاگ</a></li>
              <li><a href={`${base}/guides/`}>گائیڈز</a></li>
              <li><a href={`${base}/how-to/`}>ہاؤ ٹو ٹیوٹوریلز</a></li>
              <li><a href={`${base}/prompts/`}>پرامٹ کلیکشنز</a></li>
              <li><a href={`${base}/tools/`}>اے آئی ٹولز</a></li>
              <li><a href={`${base}/learn/`}>اردو اے آئی لغت</a></li>
              <li><a href={`${base}/search/`}>تلاش</a></li>
              <li><a href={`${base}/newsletter/`}>نیوز لیٹر</a></li>
              <li><a href={`${base}/chat/`}>اردو AI چیٹ</a></li>
              <li><a href={`${base}/code/`}>کوڈ پریویو</a></li>
            </ul>
          </div>
          <div>
            <p><strong>ادارہ</strong></p>
            <ul style="list-style:none">
              <li><a href={`${base}/about/`}>ہمارے بارے میں</a></li>
              <li><a href={`${base}/team/`}>ٹیم</a></li>
              <li><a href={`${base}/partners/`}>شراکت دار</a></li>
              <li><a href={`${base}/advertise/`}>اشتہار دیں</a></li>
              <li><a href={`${base}/contact/`}>رابطہ</a></li>
            </ul>
          </div>
          <div>
            <p><strong>سوشل میڈیا</strong></p>
            <ul style="list-style:none">
              <li><a href="https://www.facebook.com/urduaiorg" rel="noopener" target="_blank">فیس بک</a></li>
              <li><a href="https://www.youtube.com/playlist?list=PLcj1P8Ql0CihyALOpajIbj_yquUC6NlXI" rel="noopener" target="_blank">یوٹیوب</a></li>
              <li><a href="https://www.instagram.com/urduaiorg/" rel="noopener" target="_blank">انسٹاگرام</a></li>
              <li><a href="https://x.com/urduaiorg" rel="noopener" target="_blank">X (ٹوئٹر)</a></li>
              <li><a href="https://www.tiktok.com/@urduaiorg" rel="noopener" target="_blank">ٹک ٹاک</a></li>
              <li><a href="https://play.google.com/store/apps/details?id=com.yourname.urduaiwebwrapperfixed" rel="noopener" target="_blank">پلے اسٹور</a></li>
              <li><a href="https://www.aiviewer.ai/" rel="noopener" target="_blank">AI Viewer (انگریزی)</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>
            &copy; {new Date().getFullYear()} Urdu Ai — A product of <a href="https://walipak.com" rel="noopener">Wang Lab of Innovation (WALI)</a> |
            <a href={`${base}/privacy/`}>پرائیویسی پالیسی</a> |
            <a href={`${base}/terms/`}>شرائط</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
