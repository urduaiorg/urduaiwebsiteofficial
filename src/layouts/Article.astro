<!-- Reading progress bar -->
<script>
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    const update = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0;
      progressBar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<!-- Reading time estimate -->
<script>
  const body = document.getElementById('article-body');
  const timeEl = document.getElementById('reading-time-text');
  if (body && timeEl) {
    const text = body.innerText || '';
    // Urdu reads slower than English — ~150 words/min
    const words = text.trim().split(/\s+/).length;
    const minutes = Math.max(1, Math.ceil(words / 150));
    timeEl.textContent = minutes + ' منٹ مطالعہ';
  }
</script>

<!-- Table of Contents auto-generator (desktop sidebar + mobile collapsible) -->
<script>
  const articleBody = document.getElementById('article-body');
  const tocList = document.getElementById('toc-list');
  const tocWidget = document.getElementById('toc-widget');
  const mobileToc = document.getElementById('mobile-toc');
  const mobileTocList = document.getElementById('mobile-toc-list');
  if (articleBody && tocList && tocWidget) {
    const headings = articleBody.querySelectorAll('h2');
    if (headings.length >= 2) {
      headings.forEach((h, i) => {
        const id = 'section-' + i;
        h.setAttribute('id', id);

        // Desktop TOC
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        tocList.appendChild(li);

        // Mobile TOC
        if (mobileTocList) {
          const mLi = document.createElement('li');
          const mA = document.createElement('a');
          mA.href = '#' + id;
          mA.textContent = h.textContent;
          mA.addEventListener('click', (e) => {
            e.preventDefault();
            mobileToc.removeAttribute('open');
            h.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          mLi.appendChild(mA);
          mobileTocList.appendChild(mLi);
        }
      });

      // Highlight active TOC item on scroll
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocList.querySelectorAll('a').forEach(a => {
              a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
            });
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px' });

      headings.forEach(h => observer.observe(h));
    } else {
      tocWidget.style.display = 'none';
      if (mobileToc) mobileToc.style.display = 'none';
    }
  }
</script>

<!-- Floating share bar visibility -->
<script>
  const floatingShare = document.getElementById('floating-share');
  const articleMain = document.getElementById('article-main');
  if (floatingShare && articleMain) {
    const showShare = () => {
      const scrolled = window.scrollY;
      floatingShare.classList.toggle('is-visible', scrolled > 400);
    };
    window.addEventListener('scroll', showShare, { passive: true });

    // Copy link button
    const copyBtn = document.getElementById('floating-copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const url = copyBtn.getAttribute('data-url');
        navigator.clipboard.writeText(url).then(() => {
          copyBtn.classList.add('copied');
          setTimeout(() => copyBtn.classList.remove('copied'), 2000);
        });
      });
    }
  }
</script>

<!-- Mobile share actions -->
<script>
  const nativeShareBtn = document.getElementById('mobile-native-share');
  if (nativeShareBtn) {
    nativeShareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            text: document.title,
            url: window.location.href,
          });
        } catch {
          // User cancelled share sheet.
        }
      } else {
        navigator.clipboard.writeText(window.location.href);
        nativeShareBtn.textContent = 'لنک کاپی ہو گیا';
        setTimeout(() => {
          nativeShareBtn.textContent = 'شیئر';
        }, 2000);
      }
    });
  }

  const mobileCopyBtn = document.getElementById('mobile-copy-btn');
  if (mobileCopyBtn) {
    mobileCopyBtn.addEventListener('click', () => {
      const url = mobileCopyBtn.getAttribute('data-url');
      navigator.clipboard.writeText(url).then(() => {
        mobileCopyBtn.classList.add('copied');
        setTimeout(() => mobileCopyBtn.classList.remove('copied'), 2000);
      });
    });
  }
</script>

<!-- Premium Prompt UI Enhancer -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prose = document.getElementById('article-body');
    if (!prose) return;

    let rawHtml = prose.innerHTML;
    // Early exit if no prompts
    if (!rawHtml.includes('─────────────────────────────')) return;

    // Replace separators with a safe delimiter
    const DELIM = '||PROMPT_SPLIT||';
    rawHtml = rawHtml.replace(/─────────────────────────────/g, DELIM);

    const chunks = rawHtml.split(DELIM);
    if (chunks.length >= 3) {
        let newHtml = chunks[0];

        for (let i = 1; i < chunks.length - 1; i++) {
            let fullHtml = chunks[i];

            let title = 'مفید پرامٹ';
            let tool = '';
            let result = '';

            const titleMatch = fullHtml.match(/عنوان:\s*([^\n<]+)/);
            if (titleMatch) {
                title = titleMatch[1].trim();
                fullHtml = fullHtml.replace(titleMatch[0], '');
            }

            const toolMatch = fullHtml.match(/کہاں استعمال کریں:\s*([^\n<]+)/);
            if (toolMatch) {
                tool = toolMatch[1].trim();
                fullHtml = fullHtml.replace(toolMatch[0], '');
            }

            const resultSplit = fullHtml.split(/نتیجہ:/);
            if (resultSplit.length > 1) {
                result = resultSplit[1].replace(/<\/p>$/, '').replace(/<br\s*\/?>$/, '').trim();
                fullHtml = resultSplit[0];
            }

            fullHtml = fullHtml.replace(/پرامٹ:/, '');
            fullHtml = fullHtml.replace(/^(<br\s*\/?>|\n|<p>|<\/p>|\s)+/, '');
            fullHtml = fullHtml.replace(/(<br\s*\/?>|\n|<p>|<\/p>|\s)+$/, '');

            let tempDiv = document.createElement('div');
            tempDiv.innerHTML = fullHtml;
            let promptTextToCopy = tempDiv.innerText.trim();

            const btnId = 'copy-btn-' + i;

            let metaHtml = '';
            if (tool || result) {
                metaHtml = '<div class="prompt-ui-meta">';
                if (tool) metaHtml += `<div><strong>کہاں استعمال کریں:</strong> ${tool}</div>`;
                if (result) metaHtml += `<div><strong>نتیجہ:</strong> ${result}</div>`;
                metaHtml += '</div>';
            }

            const cardHtml = `
                <div class="prompt-ui-card">
                    <div class="prompt-ui-header">
                        <h3 class="prompt-ui-title">${title}</h3>
                        <button class="prompt-ui-copy-btn" id="${btnId}" data-prompt="${encodeURIComponent(promptTextToCopy)}" title="پرامٹ کاپی کریں">
                           <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                           کاپی کریں
                        </button>
                    </div>
                    <div class="prompt-ui-body">
                        ${fullHtml}
                    </div>
                    ${metaHtml}
                </div>
            `;
            newHtml += cardHtml;
        }

        newHtml += chunks[chunks.length - 1];
        prose.innerHTML = newHtml;

        for (let i = 1; i < chunks.length - 1; i++) {
            const btn = document.getElementById('copy-btn-' + i);
            if (btn) {
                btn.addEventListener('click', function() {
                    const text = decodeURIComponent(this.getAttribute('data-prompt'));
                    navigator.clipboard.writeText(text).then(() => {
                        const originalSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> ';
                        this.innerHTML = 'کاپی ہو گیا';
                        this.classList.add('copied');
                        setTimeout(() => {
                            this.innerHTML = originalSvg + 'کاپی کریں';
                            this.classList.remove('copied');
                        }, 2000);
                    }).catch(err => console.error('Copy failed', err));
                });
            }
        }
    }
  });
</script>

<!-- Copy-ready prompt boxes -->
<script>
  document.querySelectorAll('.prose .prompt-box').forEach((box) => {
    const text = box.textContent.trim();
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'prompt-copy';
    btn.setAttribute('aria-label', 'پرامٹ کاپی کریں');
    btn.innerHTML =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>کاپی کریں</span>';
    const label = btn.querySelector('span');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (err) {}
        ta.remove();
      }
      label.textContent = 'کاپی ہو گیا';
      btn.classList.add('copied');
      setTimeout(() => {
        label.textContent = 'کاپی کریں';
        btn.classList.remove('copied');
      }, 1600);
    });
    box.appendChild(btn);
  });
</script>

<!-- App CTA scroll trigger -->
<script>
  const cta = document.getElementById('app-cta');
  if (cta) {
    const onScroll = () => {
      const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
      if (scrolled > 0.7) {
        cta.classList.add('is-visible');
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
