---
// Article.astro — urduai.org — Premium Editorial Layout
// Used by: blog/[slug].astro, guides/[slug].astro, prompts/[slug].astro

import Base from './Base.astro';
import LegacyCommentsSection from '../components/LegacyCommentsSection.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import RelatedTools from '../components/RelatedTools.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import { getToolsByNames } from '../data/tools';
import legacyCommentsPayload from '../data/legacy-comments.json';

export interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  date: string;
  publishedAt?: string;
  author?: string;
  category?: string;
  tags?: string[];
  image?: string;
  ogImage?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageFit?: 'cover' | 'contain' | 'portrait';
  adsense?: boolean;
  slug: string;
  collection: string; // 'blog' | 'guides' | 'prompts'
  tools?: string[];
  faq?: { question: string; answer: string }[];
  focusKeyphrase?: string;
  secondaryKeyphrases?: string[];
  howToSteps?: { name: string; text: string }[];
  last_updated?: string;
}

const {
  title,
  seoTitle,
  description,
  date,
  publishedAt,
  author = 'اردو اے آئی ٹیم',
  category,
  tags = [],
  image,
  ogImage,
  imageWidth,
  imageHeight,
  imageFit = 'cover',
  adsense = true,
  slug,
  collection,
  tools: toolNames = [],
  faq = [],
  focusKeyphrase,
  secondaryKeyphrases = [],
  howToSteps = [],
  last_updated,
} = Astro.props;

// Author bios — keyed by name
const authorBios: Record<string, string> = {
  'اردو اے آئی ٹیم': 'اردو اے آئی کی ایڈیٹوریل ٹیم — پاکستان کا سب سے بڑا اردو زبان میں اے آئی خواندگی پلیٹ فارم۔',
  'معراج احمد': 'Urdu Ai کے کنٹینٹ لیڈ ہیں اور اے آئی ٹیکنالوجی پر گہری نظر رکھتے ہیں۔ اس وقت وہ لسبیلہ یونیورسٹی میں آئی ٹی کے طالبعلم ہیں۔',
  'قیصر رونجھا': 'اردو اے آئی کے بانی اور پاکستان کے سرکردہ اے آئی خواندگی ماہر۔ S&P Global Foundation StepForward ایوارڈ یافتہ — اردو بولنے والوں تک اے آئی کو آسان بنانے کے مشن پر۔',
};
const authorBio = authorBios[author] ?? '';

// Resolve tool names to tool data for schema.org mentions + RelatedTools component
const resolvedTools = toolNames.length > 0 ? getToolsByNames(toolNames) : [];

const canonical = `https://urduai.org/${collection}/${slug}/`;
const socialImage = ogImage ?? image ?? `/og/default.jpg`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const legacyCommentsData = legacyCommentsPayload as {
  commentsByCollection: Record<string, Record<string, unknown[]>>;
};

// Date-only frontmatter should display as the same calendar day in every timezone.
const dateParts = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);
const dateObj = dateParts
  ? new Date(Number(dateParts[1]), Number(dateParts[2]) - 1, Number(dateParts[3]))
  : new Date(date);
const formattedDate = dateObj.toLocaleDateString('ur-PK', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const collectionComments = legacyCommentsData.commentsByCollection[collection] ?? {};
const legacyComments = collectionComments[slug] ?? [];

// Article/NewsArticle schema — auto-switches type for اے آئی اپڈیٹ category
const isNewsPost = category === 'اے آئی اپڈیٹ';
const articleKeywords = [focusKeyphrase, ...secondaryKeyphrases].filter(
  (keyword): keyword is string => Boolean(keyword),
);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": isNewsPost ? "NewsArticle" : "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical,
  },
  "headline": title,
  "description": description,
  "datePublished": publishedAt ?? date,
  "dateModified": last_updated ?? date,
  ...(articleKeywords.length > 0 ? { "keywords": articleKeywords } : {}),
  ...(isNewsPost ? {
    "articleSection": "اے آئی اپڈیٹ",
    "dateline": "پاکستان",
  } : {}),
  "author": author === 'اردو اے آئی ٹیم' ? {
    "@type": "Organization",
    "name": "اردو اے آئی",
    "url": "https://urduai.org",
  } : {
    "@type": "Person",
    "name": author,
    "url": author === 'معراج احمد' ? "https://urduai.org/author/mairaj-ahmed/" : "https://urduai.org/about/",
  },
  "publisher": {
    "@type": "Organization",
    "name": "اردو اے آئی",
    "url": "https://urduai.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://urduai.org/images/logo.png",
    },
  },
  "inLanguage": "ur",
  "url": canonical,
  ...(image ? { "image": {
    "@type": "ImageObject",
    "url": `https://urduai.org${image}`,
    "width": imageWidth ?? (imageFit === 'portrait' ? 1055 : 860),
    "height": imageHeight ?? (imageFit === 'portrait' ? 1491 : 480),
  }} : {}),
  // Schema.org mentions — links article to tool entities for AEO
  ...(resolvedTools.length > 0 ? { "mentions": resolvedTools.map(t => ({
    "@type": "SoftwareApplication",
    "name": t.name,
    "alternateName": t.urduName,
    "url": t.url,
    "applicationCategory": "AI Tool",
    "offers": {
      "@type": "Offer",
      "price": t.pricing === 'free' ? "0" : undefined,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
    },
  }))} : {}),
};

// Speakable schema — tells Google Assistant/voice search which content to read aloud
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".article-header__title", ".prose > p:first-of-type"]
  },
  "url": canonical,
};

// FAQPage schema — generated when faq array is present in frontmatter
const faqSchema = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer,
    },
  })),
} : null;

// Guide-only HowTo schema. Existing guides opt in through frontmatter steps.
const howToSchema = collection === 'guides' && howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": description,
  "url": canonical,
  "inLanguage": "ur",
  ...(image ? { "image": `https://urduai.org${image}` } : {}),
  "step": howToSteps.map(({ name, text }, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "name": name,
    "text": text,
  })),
} : null;

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ہوم",
      "item": "https://urduai.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": category ?? collection,
      "item": `https://urduai.org/${collection}/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonical
    }
  ]
};

const combinedSchema = [
  articleSchema,
  breadcrumbSchema,
  speakableSchema,
  ...(howToSchema ? [howToSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
];
---

<Base
  title={seoTitle ?? title}
  description={description}
  canonical={canonical}
  ogImage={socialImage}
  ogType="article"
  adsense={adsense}
  schema={combinedSchema}
  articleMeta={{
    publishedTime: publishedAt ?? date,
    author: author,
    section: category,
  }}
>

  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ============================================================
       ARTICLE HEADER — Clean Card Style
       ============================================================ -->
  <div class="article-header container" dir="rtl" lang="ur">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب" class="article-header__breadcrumb">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/${collection}/`}>{category ?? collection}</a></li>
      </ol>
    </nav>

    {category && <span class="badge">{category}</span>}
    <h1 class="article-header__title">{title}</h1>

    <div class="article-header__meta">
      <div class="article-header__author">
        <div class="article-header__author-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <span>{author}</span>
      </div>
      <time datetime={date} class="article-header__date">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {formattedDate}
      </time>
      <span class="article-header__reading-time" id="reading-time">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id="reading-time-text"></span>
      </span>
    </div>

    <!-- Cover image card — only for guides & how-to (visual tool reference) -->
    {image && (collection === 'guides' || collection === 'how-to') && (
      <div class={`article-header__cover${imageFit === 'contain' ? ' article-header__cover--contain' : ''}${imageFit === 'portrait' ? ' article-header__cover--portrait' : ''}`}>
        <img src={`${base}${image}`} alt={title} class="article-header__cover-img" loading="eager" />
      </div>
    )}
  </div>

  <!-- Top banner ad — hidden on mobile, in-article ad serves that role -->
  {adsense && (
    <div class="container ad-slot ad-slot--desktop-only" data-ad-placement="top-banner" aria-hidden="true">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-8532451951782012"
        data-ad-slot="3562374472"
        data-ad-format="auto"
        data-full-width-responsive="true">
      </ins>
      <script>window.urduAiPushAds?.();</script>
    </div>
  )}

  <!-- ============================================================
       FLOATING SHARE BAR (desktop only)
       ============================================================ -->
  <aside class="floating-share" id="floating-share" aria-label="شیئر کریں">
    <a href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + canonical)}`} target="_blank" rel="noopener" class="floating-share__btn floating-share__btn--whatsapp" title="واٹس ایپ">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener" class="floating-share__btn floating-share__btn--facebook" title="فیس بک">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener" class="floating-share__btn floating-share__btn--x" title="X">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <button class="floating-share__btn floating-share__btn--copy" id="floating-copy-btn" title="لنک کاپی کریں" data-url={canonical}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </button>
  </aside>

  <!-- ============================================================
       ARTICLE BODY + SIDEBAR
       ============================================================ -->
  <div class="article-layout container" dir="rtl" lang="ur">
    <!-- Main article -->
    <article class="article-layout__main" id="article-main" dir="rtl" lang="ur">

      <!-- Mobile TOC — collapsible, visible only on mobile -->
      <details class="mobile-toc" id="mobile-toc">
        <summary class="mobile-toc__toggle">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          فہرست مضمون
        </summary>
        <ol class="mobile-toc__list" id="mobile-toc-list"></ol>
      </details>

      <!-- Article content. The ad is moved after the first rendered paragraph below. -->
      <div class="prose" id="article-body" dir="rtl" lang="ur">
        <slot />

        {adsense && (
          <div class="ad-slot ad-slot--in-article ad-slot--after-intro" data-ad-placement="after-intro" aria-hidden="true">
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-client="ca-pub-8532451951782012"
              data-ad-slot="3972865568"
              data-ad-format="fluid"
              data-ad-layout="in-article">
            </ins>
          </div>
        )}

        {adsense && (
          <div class="ad-slot ad-slot--in-article ad-slot--mid-article" data-ad-placement="mid-article" aria-hidden="true">
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-client="ca-pub-8532451951782012"
              data-ad-slot="3972865568"
              data-ad-format="fluid"
              data-ad-layout="in-article">
            </ins>
          </div>
        )}
      </div>

      <script>
        const articleBody = document.getElementById('article-body');
        const introAd = articleBody?.querySelector(':scope > .ad-slot--after-intro');
        const midAd = articleBody?.querySelector(':scope > .ad-slot--mid-article');
        const firstParagraph = articleBody?.querySelector(':scope > p');
        if (introAd && firstParagraph) {
          firstParagraph.insertAdjacentElement('afterend', introAd);
        }

        if (articleBody && midAd) {
          const paragraphs = Array.from(articleBody.querySelectorAll(':scope > p'));
          const articleTextLength = paragraphs.reduce((total, paragraph) => total + (paragraph.textContent?.trim().length || 0), 0);

          // A second in-article placement is useful only when the reader has
          // enough substantial content on both sides of it. Short articles
          // keep the lighter intro + bottom experience.
          if (paragraphs.length >= 8 && articleTextLength >= 3000) {
            const targetIndex = Math.min(
              paragraphs.length - 4,
              Math.max(4, Math.round(paragraphs.length * 0.55))
            );
            paragraphs[targetIndex].insertAdjacentElement('afterend', midAd);
          } else {
            midAd.remove();
          }
        }

        window.urduAiPushAds?.();
      </script>

      <!-- Bottom ad -->
      {adsense && (
        <div class="ad-slot" data-ad-placement="article-bottom" aria-hidden="true">
          <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-8532451951782012"
            data-ad-slot="4411022916"
            data-ad-format="auto"
            data-full-width-responsive="true">
          </ins>
          <script>window.urduAiPushAds?.();</script>
        </div>
      )}

      <!-- Related AI tools — driven by frontmatter tools: [] field -->
      {resolvedTools.length > 0 && <RelatedTools toolNames={toolNames} />}

      <!-- Author card -->
      <div class="author-card">
        <div class="author-card__avatar">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="author-card__info">
          <p class="author-card__name">{author}</p>
          <p class="author-card__bio">{authorBio}</p>
          <div class="author-card__social">
            <a href="https://x.com/urduaiorg" rel="noopener" target="_blank">X</a>
            <a href="https://www.facebook.com/urduaiorg" rel="noopener" target="_blank">Facebook</a>
            <a href="https://www.instagram.com/urduaiorg/" rel="noopener" target="_blank">Instagram</a>
          </div>
        </div>
      </div>

      <LegacyCommentsSection comments={legacyComments} />

      <!-- Related posts — same category -->
      {category && <RelatedPosts currentSlug={slug} category={category} />}

      <!-- Inline newsletter — captures engaged readers -->
      <InlineNewsletter />

      <!-- App CTA strip — shown after 70% scroll -->
      <div class="app-cta-strip" id="app-cta" aria-label="ایپ ڈاؤنلوڈ">
        <p>يہ مضمون پسند آيا؟ اردو اے آئی ايپ ميں ہزاروں ايسے مضامين پڑھيں</p>
        <a href={`${base}/app/`} class="btn-playstore" data-analytics-event="app_cta_click" data-analytics-location="article_end">مفت ڈاؤن لوڈ کريں</a>
      </div>
    </article>

    <!-- Sidebar -->
    <aside class="article-layout__sidebar">
      <!-- Table of Contents — auto-generated from h2 headings -->
      <div class="toc-widget" id="toc-widget">
        <p class="toc-widget__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          فہرست
        </p>
        <ol class="toc-widget__list" id="toc-list">
          <!-- JS populates this -->
        </ol>
      </div>

      <!-- Sidebar sticky ad -->
      {adsense && (
        <div class="ad-slot ad-slot--sidebar" data-ad-placement="sidebar" aria-hidden="true">
          <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-8532451951782012"
            data-ad-slot="5135310593"
            data-ad-format="auto"
            data-full-width-responsive="false">
          </ins>
          <script>window.urduAiPushAds?.();</script>
        </div>
      )}
  </aside>

  <!-- Mobile share bar -->
  <div class="mobile-share" id="mobile-share" aria-label="موبائل شیئر">
    <button class="mobile-share__btn mobile-share__btn--native" id="mobile-native-share" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51L8.59 10.49"/></svg>
      شیئر
    </button>
    <a href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + canonical)}`} target="_blank" rel="noopener" class="mobile-share__btn mobile-share__btn--whatsapp">
