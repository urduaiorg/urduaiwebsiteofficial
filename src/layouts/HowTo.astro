---
// HowTo.astro — urduai.org
// Used by: how-to/[slug].astro
// Living articles — last_verified date shown prominently.
// HowTo schema with numbered steps fed via props.

import Base from './Base.astro';
import LegacyCommentsSection from '../components/LegacyCommentsSection.astro';
import RelatedTools from '../components/RelatedTools.astro';
import RelatedHowTo from '../components/RelatedHowTo.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import { getToolsByNames } from '../data/tools';
import legacyCommentsPayload from '../data/legacy-comments.json';

export interface HowToStep {
  name: string;
  text: string;
  image?: string;
}

export interface Props {
  title: string;
  description: string;
  date: string;
  last_verified: string;
  tool?: string;
  difficulty?: string;
  time_required?: string;
  image?: string;
  adsense?: boolean;
  slug: string;
  category?: string;
  steps?: HowToStep[];
  tools?: string[];
  faq?: { question: string; answer: string }[];
}

const {
  title,
  description,
  date,
  last_verified,
  tool,
  difficulty = 'آسان',
  time_required,
  image,
  adsense = true,
  slug,
  category = 'ہاؤ ٹو',
  steps = [],
  tools: toolNames = [],
  faq = [],
} = Astro.props;

const resolvedTools = toolNames.length > 0 ? getToolsByNames(toolNames) : [];

const canonical = `https://urduai.org/how-to/${slug}/`;
const ogImage = image ?? `/og/default.jpg`;
const legacyCommentsData = legacyCommentsPayload as {
  commentsByCollection: Record<string, Record<string, unknown[]>>;
};
const legacyComments = legacyCommentsData.commentsByCollection.howto?.[slug] ?? [];

// Date-only strings parse as UTC midnight and can render as the previous day
// in North American time zones. Noon UTC keeps the intended calendar date.
const dateObj = new Date(`${last_verified}T12:00:00Z`);
const verifiedFormatted = dateObj.toLocaleDateString('ur-PK', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const publishedObj = new Date(`${date}T12:00:00Z`);
const publishedFormatted = publishedObj.toLocaleDateString('ur-PK', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const timeMinutes = time_required?.match(/\d+/)?.[0];
const isoTotalTime = timeMinutes ? `PT${timeMinutes}M` : undefined;

// HowTo schema
const howtoSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": description,
  "inLanguage": "ur",
  "datePublished": date,
  "dateModified": last_verified,
  ...(tool ? { "tool": [{ "@type": "HowToTool", "name": tool }] } : {}),
  ...(isoTotalTime ? { "totalTime": isoTotalTime } : {}),
  "step": steps.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text,
    ...(step.image ? { "image": `https://urduai.org${step.image}` } : {}),
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ہوم", "item": "https://urduai.org/" },
    { "@type": "ListItem", "position": 2, "name": "ہاؤ ٹو", "item": "https://urduai.org/how-to/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonical },
  ],
};

const faqSchema = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer,
    },
  })),
} : null;

const combinedSchema = [howtoSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  adsense={adsense}
  schema={combinedSchema}
  articleMeta={{
    publishedTime: date,
    section: "ہاؤ ٹو",
  }}
>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- Top banner ad — hidden on mobile so the tutorial answer stays above the fold -->
  {adsense && (
    <div class="container ad-slot ad-slot--desktop-only" data-ad-placement="top-banner" aria-hidden="true">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-8532451951782012"
        data-ad-slot="3562374472"
        data-ad-format="auto"
        data-full-width-responsive="true">
      </ins>
      <script>window.urduAiPushAds?.();</script>
    </div>
  )}

  <div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="بریڈکرمب">
      <ol class="breadcrumb">
        <li><a href={`${base}/`}>ہوم</a></li>
        <li><a href={`${base}/how-to/`}>ہاؤ ٹو</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
  </div>

  <div class="article-layout container">
    <article class="article-layout__main">
      <header>
        <span class="badge">ہاؤ ٹو</span>
        <h1 class="article-header__title">{title}</h1>

        <!-- Freshness signal — prominently shown above fold -->
        <div class="freshness-signal" style="margin-block: var(--space-sm);">
          آخری اپڈیٹ: {verifiedFormatted} — معلومات دوبارہ چیک کی گئی ہیں
        </div>

        <div class="article-meta">
          <time datetime={date}>شائع: {publishedFormatted}</time>
          {tool && <span class="badge badge--teal">{tool}</span>}
          {difficulty && <span>مشکل: {difficulty}</span>}
          {time_required && <span>وقت: {time_required}</span>}
          <span class="article-header__reading-time" id="reading-time">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="reading-time-text"></span>
          </span>
        </div>

        <!-- Before you start summary box -->
        <div class="card howto-start-card" style="margin-block: var(--space-md);">
          <p class="card__meta">شروع کرنے سے پہلے</p>
          <ul style="list-style:none; padding:0;">
            {tool && <li>ٹول: {tool}</li>}
            {time_required && <li>وقت: {time_required}</li>}
            {difficulty && <li>مشکل: {difficulty}</li>}
          </ul>
        </div>

        {image && (
          <img
            src={image}
            alt={title}
            width="860"
            height="480"
            loading="eager"
            style="border-radius:8px; margin-block-end: var(--space-md);"
          />
        )}
      </header>

      <!-- Mobile TOC — kept after the useful page summary and cover -->
      <details class="mobile-toc" id="mobile-toc">
        <summary class="mobile-toc__toggle">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          فہرست مضمون
        </summary>
        <ol class="mobile-toc__list" id="mobile-toc-list"></ol>
      </details>

      <div class="prose" id="article-body">
        <!-- Full tutorial content; the ad is placed after its first paragraph below. -->
        <slot />

        {adsense && (
          <div class="ad-slot ad-slot--in-article ad-slot--after-intro" data-ad-placement="after-intro" aria-hidden="true">
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-client="ca-pub-8532451951782012"
              data-ad-slot="3972865568"
              data-ad-format="fluid"
              data-ad-layout="in-article">
            </ins>
          </div>
        )}

        {adsense && (
          <div class="ad-slot ad-slot--in-article ad-slot--mid-article" data-ad-placement="mid-article" aria-hidden="true">
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-client="ca-pub-8532451951782012"
              data-ad-slot="3972865568"
              data-ad-format="fluid"
              data-ad-layout="in-article">
            </ins>
          </div>
        )}
      </div>

      <script>
        const articleBody = document.getElementById('article-body');
        const introAd = articleBody?.querySelector(':scope > .ad-slot--after-intro');
        const midAd = articleBody?.querySelector(':scope > .ad-slot--mid-article');
        const firstParagraph = articleBody?.querySelector(':scope > p');
        if (introAd && firstParagraph) {
          firstParagraph.insertAdjacentElement('afterend', introAd);
        }

        if (articleBody && midAd) {
          const paragraphs = Array.from(articleBody.querySelectorAll(':scope > p'));
          const articleTextLength = paragraphs.reduce((total, paragraph) => total + (paragraph.textContent?.trim().length || 0), 0);

          if (paragraphs.length >= 8 && articleTextLength >= 3000) {
            const targetIndex = Math.min(
              paragraphs.length - 4,
              Math.max(4, Math.round(paragraphs.length * 0.55))
            );
            paragraphs[targetIndex].insertAdjacentElement('afterend', midAd);
          } else {
            midAd.remove();
          }
        }

        window.urduAiPushAds?.();
      </script>

      <!-- Last verified note -->
      <div class="last-verified">
        آخری بار تصدیق: {verifiedFormatted}
        — اگر اسکرین مختلف نظر آئے تو <a href={`${base}/contact/`}>یہاں بتائیں</a>
      </div>

      <!-- Bottom ad -->
      {adsense && (
        <div class="ad-slot" data-ad-placement="article-bottom" aria-hidden="true">
          <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-8532451951782012"
            data-ad-slot="4411022916"
            data-ad-format="auto"
            data-full-width-responsive="true">
          </ins>
          <script>window.urduAiPushAds?.();</script>
        </div>
      )}

      <!-- Related AI tools -->
      {resolvedTools.length > 0 && <RelatedTools toolNames={toolNames} />}

      <LegacyCommentsSection comments={legacyComments} />

      <!-- Related how-to tutorials -->
      <RelatedHowTo currentSlug={slug} category={category} />

      <!-- Inline newsletter -->
      <InlineNewsletter />

      <!-- App CTA strip -->
      <div class="app-cta-strip" id="app-cta" aria-label="ایپ ڈاؤنلوڈ">
        <p>يہ ٹيوٹوريل پسند آيا؟ اردو اے آئی ايپ ميں ہزاروں ايسے گائيڈز پڑھيں</p>
        <a href={`${base}/app/`} class="btn-playstore" data-analytics-event="app_cta_click" data-analytics-location="howto_end">مفت ڈاؤن لوڈ کريں</a>
      </div>
    </article>

    <!-- Sidebar -->
    <aside class="article-layout__sidebar">
      <!-- Table of Contents — auto-generated from h2 headings -->
      <div class="toc-widget" id="toc-widget">
        <p class="toc-widget__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          فہرست
        </p>
        <ol class="toc-widget__list" id="toc-list">
          <!-- JS populates this -->
        </ol>
      </div>

      {adsense && (
        <div class="ad-slot ad-slot--sidebar" data-ad-placement="sidebar" aria-hidden="true">
          <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-8532451951782012"
            data-ad-slot="5135310593"
            data-ad-format="auto"
            data-full-width-responsive="false">
          </ins>
          <script>window.urduAiPushAds?.();</script>
        </div>
      )}
    </aside>
  </div>
</Base>

<!-- Reading progress bar -->
<script>
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    const update = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0;
      progressBar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<!-- Reading time estimate -->
<script>
  const body = document.getElementById('article-body');
  const timeEl = document.getElementById('reading-time-text');
  if (body && timeEl) {
    const text = body.innerText || '';
    // Urdu reads slower than English — ~150 words/min
    const words = text.trim().split(/\s+/).length;
    const minutes = Math.max(1, Math.ceil(words / 150));
    timeEl.textContent = minutes + ' منٹ مطالعہ';
  }
</script>

<!-- Table of Contents auto-generator (desktop sidebar + mobile collapsible) -->
<script>
  const articleBody = document.getElementById('article-body');
  const tocList = document.getElementById('toc-list');
  const tocWidget = document.getElementById('toc-widget');
  const mobileToc = document.getElementById('mobile-toc');
  const mobileTocList = document.getElementById('mobile-toc-list');
  if (articleBody && tocList && tocWidget) {
    const headings = articleBody.querySelectorAll('h2');
    if (headings.length >= 2) {
      headings.forEach((h, i) => {
        const id = 'section-' + i;
        h.setAttribute('id', id);

        // Desktop TOC
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        tocList.appendChild(li);

        // Mobile TOC
        if (mobileTocList) {
          const mLi = document.createElement('li');
          const mA = document.createElement('a');
          mA.href = '#' + id;
          mA.textContent = h.textContent;
          mA.addEventListener('click', (e) => {
            e.preventDefault();
            mobileToc.removeAttribute('open');
            h.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          mLi.appendChild(mA);
          mobileTocList.appendChild(mLi);
        }
      });

      // Highlight active TOC item on scroll
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocList.querySelectorAll('a').forEach(a => {
              a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
            });
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px' });

      headings.forEach(h => observer.observe(h));
    } else {
      tocWidget.style.display = 'none';
      if (mobileToc) mobileToc.style.display = 'none';
    }
  }
</script>

<!-- App CTA scroll trigger -->
<script>
  const cta = document.getElementById('app-cta');
  if (cta) {
    const onScroll = () => {
      const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
      if (scrolled > 0.7) {
        cta.classList.add('is-visible');
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
