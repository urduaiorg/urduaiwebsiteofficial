---
// RelatedHowTo.astro — urduai.org
// Shows 3 how-to tutorials from the same category below each tutorial

import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category?: string;
}

const { currentSlug, category } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allHowTos = await getCollection('howto', ({ data }) => !data.draft);

// Prefer same category, fall back to most recent
let related = allHowTos
  .filter(p => p.id !== currentSlug && category && p.data.category === category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// If fewer than 3 in same category, fill with most recent from any category
if (related.length < 3) {
  const existingIds = new Set([currentSlug, ...related.map(r => r.id)]);
  const filler = allHowTos
    .filter(p => !existingIds.has(p.id))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3 - related.length);
  related = [...related, ...filler];
}
---

{related.length > 0 && (
  <section class="related-howto" aria-label="متعلقہ ٹیوٹوریلز">
    <h3 class="related-howto__heading">متعلقہ ٹیوٹوریلز</h3>
    <div class="related-howto__grid">
      {related.map(post => (
        <a href={`${base}/how-to/${post.id}/`} class="related-howto-card">
          {post.data.image ? (
            <img
              src={`${base}${post.data.image}`}
              alt={post.data.title}
              width="280"
              height="157"
              loading="lazy"
              class="related-howto-card__img"
            />
          ) : (
            <div class="related-howto-card__placeholder">
              <span>Urdu Ai</span>
            </div>
          )}
          <div class="related-howto-card__body">
            <span class="related-howto-card__title">{post.data.title}</span>
            <div class="related-howto-card__meta">
              {post.data.tool && <span class="related-howto-card__tool">{post.data.tool}</span>}
              {post.data.difficulty && <span>{post.data.difficulty}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-howto {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: 2px solid var(--border);
  }

  .related-howto__heading {
    font-size: var(--text-h3);
    color: var(--ink);
    margin-block-end: var(--space-md);
  }

  .related-howto__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .related-howto-card {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .related-howto-card:hover {
    border-color: var(--navy);
  }

  .related-howto-card__img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    display: block;
  }

  .related-howto-card__placeholder {
    width: 100%;
    height: 130px;
    background: var(--paper-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .related-howto-card__body {
    padding: var(--space-xs) var(--space-sm) var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .related-howto-card__title {
    font-size: var(--text-sm);
    line-height: var(--lh-h3);
    color: var(--ink);
  }

  .related-howto-card__meta {
    display: flex;
    gap: var(--space-xs);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .related-howto-card__tool {
    background: var(--paper-warm);
    padding: 0.1em 0.5em;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .related-howto__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
