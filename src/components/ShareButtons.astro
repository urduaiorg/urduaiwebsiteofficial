---
// ShareButtons.astro — urduai.org
// WhatsApp-first share row for Pakistan audience

export interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const fullUrl = url.startsWith('http') ? url : `https://urduai.org${url}`;
const encoded = encodeURIComponent(fullUrl);
const encodedTitle = encodeURIComponent(title);
---

<div class="share-row" aria-label="مضمون شیئر کریں">
  <span class="share-row__label">شیئر کریں:</span>

  <!-- WhatsApp -->
  <a
    href={`https://api.whatsapp.com/send?text=${encodedTitle}+${encoded}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-btn--whatsapp"
    aria-label="واٹس ایپ پر شیئر کریں"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" fill="currentColor"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.528 5.852L.057 23.5l5.793-1.438A11.946 11.946 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.891 0-3.664-.5-5.195-1.377l-.371-.22-3.441.854.883-3.358-.242-.387A9.946 9.946 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z" fill="currentColor"/>
    </svg>
    <span>واٹس ایپ</span>
  </a>

  <!-- Facebook -->
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encoded}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-btn--facebook"
    aria-label="فیس بک پر شیئر کریں"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.932-1.956 1.888v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" fill="currentColor"/>
    </svg>
    <span>فیس بک</span>
  </a>

  <!-- X / Twitter -->
  <a
    href={`https://x.com/intent/tweet?text=${encodedTitle}&url=${encoded}&via=urduaiorg`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-btn--x"
    aria-label="X پر شیئر کریں"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>
    </svg>
    <span>X</span>
  </a>

  <!-- Copy link -->
  <button
    class="share-btn share-btn--copy"
    data-url={fullUrl}
    aria-label="لنک کاپی کریں"
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="copy-label">لنک کاپی</span>
  </button>
</div>

<style>
  .share-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-block: var(--space-lg);
    padding-block: var(--space-md);
    border-block-start: 1px solid var(--border);
    border-block-end: 1px solid var(--border);
  }

  .share-row__label {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.4em 0.9em;
    border-radius: 6px;
    border: 1.5px solid transparent;
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: var(--lh-body);
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
  }

  .share-btn:hover { opacity: 0.85; }
  .share-btn:active { transform: scale(0.97); }

  .share-btn--whatsapp {
    background: #25d366;
    color: white;
  }

  .share-btn--facebook {
    background: #1877f2;
    color: white;
  }

  .share-btn--x {
    background: #000;
    color: white;
  }

  .share-btn--copy {
    background: var(--paper-warm);
    color: var(--ink-soft);
    border-color: var(--border);
  }

  .share-btn--copy.copied {
    background: var(--teal-light);
    color: var(--teal);
    border-color: var(--teal);
  }
</style>

<script>
  document.querySelectorAll('.share-btn--copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      const label = btn.querySelector('.copy-label');
      try {
        await navigator.clipboard.writeText(url);
        btn.classList.add('copied');
        if (label) label.textContent = 'کاپی ہو گیا';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'لنک کاپی';
        }, 2000);
      } catch {}
    });
  });
</script>
