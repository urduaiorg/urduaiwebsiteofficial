---
export interface LegacyComment {
  id: number;
  parentId: number;
  depth: number;
  author: string;
  date: string;
  content: string;
}

export interface Props {
  comments: LegacyComment[];
}

const { comments } = Astro.props;
const commentCount = comments.length;

function formatLegacyCommentDate(value: string) {
  const commentDate = new Date(value.replace(' ', 'T'));
  if (Number.isNaN(commentDate.getTime())) {
    return value;
  }

  return commentDate.toLocaleDateString('ur-PK', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{commentCount > 0 && (
  <section class="legacy-comments" aria-labelledby="legacy-comments-heading">
    <div class="legacy-comments__header">
      <div class="legacy-comments__eyebrow">آرکائیو</div>
      <div class="legacy-comments__title-row">
        <h2 id="legacy-comments-heading">پرانے قارئین کے تبصرے</h2>
        <span class="legacy-comments__count">
          {commentCount.toLocaleString('ur-PK')} تبصرے
        </span>
      </div>
      <p>
        یہ تبصرے پرانی ورڈپریس ویب سائٹ سے محفوظ کر کے یہاں منتقل کیے گئے ہیں۔
        نئے تبصرے فی الحال بند ہیں۔
      </p>
    </div>

    <ol class="legacy-comments__list">
      {comments.map((comment) => (
        <li
          class="legacy-comments__item"
          style={`--comment-depth: ${Math.min(comment.depth, 4)};`}
        >
          <article class="legacy-comments__card">
            <header class="legacy-comments__meta">
              <strong>{comment.author}</strong>
              <time datetime={comment.date}>{formatLegacyCommentDate(comment.date)}</time>
            </header>
            <p class="legacy-comments__content">{comment.content}</p>
          </article>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .legacy-comments {
    margin-block: var(--space-xl);
    padding: var(--space-lg);
    background: linear-gradient(180deg, var(--paper-card) 0%, var(--paper) 100%);
    border: 1px solid var(--border-dark);
    border-radius: 14px;
    box-shadow: 0 10px 24px rgba(61, 50, 34, 0.05);
  }

  .legacy-comments__header {
    margin-block-end: var(--space-md);
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid var(--border);
  }

  .legacy-comments__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.75rem;
    border-radius: 999px;
    background: var(--gold-pale);
    color: var(--ink-soft);
    font-size: var(--text-xs);
    margin-block-end: var(--space-xs);
  }

  .legacy-comments__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .legacy-comments__title-row h2 {
    margin: 0;
  }

  .legacy-comments__count {
    flex-shrink: 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--paper-warm);
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .legacy-comments__header p {
    color: var(--ink-soft);
    margin: 0;
  }

  .legacy-comments__list {
    list-style: none;
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
  }

  .legacy-comments__item {
    margin-inline-start: calc(var(--comment-depth, 0) * 1.25rem);
    min-width: 0;
  }

  .legacy-comments__card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: var(--space-sm) var(--space-md);
    position: relative;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .legacy-comments__card::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
    background: var(--gold-light);
  }

  .legacy-comments__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin-block-end: var(--space-xs);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .legacy-comments__meta strong {
    color: var(--ink);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .legacy-comments__content {
    margin: 0;
    white-space: pre-line;
    line-height: var(--lh-prose);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 720px) {
    .legacy-comments {
      padding: var(--space-md);
    }

    .legacy-comments__title-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .legacy-comments__item {
      margin-inline-start: 0;
    }
  }
</style>
