---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'img'> & { src: string; alt: string };
const { src, alt, width, height, sizes, ...attributes } = Astro.props;
// Import the local originals as image metadata so Astro can generate derivatives.
// The public URLs remain available for existing links and social previews.
const originals = import.meta.glob<{ default: ImageMetadata }>(
  '/public/images/**/*.{png,jpg,jpeg,webp}',
);
const load = originals[`/public${src}`];
const metadata = load ? (await load()).default : undefined;
const maximumWidth = Math.min(metadata?.width ?? 1200, 1200);
const widths = [...new Set([400, 800, maximumWidth].filter(value => value <= maximumWidth))];
---

{metadata ? (
  <Image
    {...attributes}
    src={metadata}
    alt={alt}
    width={maximumWidth}
    widths={widths}
    sizes={sizes ?? '(max-width: 800px) calc(100vw - 32px), 800px'}
    format="webp"
    quality={85}
  />
) : (
  <img {...attributes} src={src} alt={alt} width={width} height={height} sizes={sizes} />
)}
