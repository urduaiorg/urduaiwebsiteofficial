---
// RelatedTools.astro — Shows relevant AI tools at end of articles
// Driven by frontmatter `tools: ["ChatGPT", "Gemini"]` field
// Links back to /tools/ page for SEO interlinking

import { getToolsByNames, type Tool } from '../data/tools';

export interface Props {
  toolNames: string[];
}

const { toolNames } = Astro.props;
const matchedTools = getToolsByNames(toolNames);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toolAnchor = (name: string) => `tool-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Don't render if no tools matched
if (matchedTools.length === 0) return null;
---

{matchedTools.length > 0 && (
  <section class="related-tools" aria-label="متعلقہ اے آئی ٹولز">
    <h2 class="related-tools__title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
      </svg>
      متعلقہ AI ٹولز
    </h2>

    <div class="related-tools__grid">
      {matchedTools.map((tool: Tool) => (
        <a
          href={`${base}/tools/#${toolAnchor(tool.name)}`}
          class="related-tool"
        >
          <img
            class="related-tool__logo"
            src={`${base}${tool.logo}`}
            alt={tool.name}
            width="36"
            height="36"
            loading="lazy"
          />
          <div class="related-tool__info">
            <span class="related-tool__name">{tool.name}</span>
            <span class="related-tool__urdu">{tool.urduName} — {tool.by}</span>
          </div>
          <div class="related-tool__meta">
            <span class={`badge ${tool.pricing === 'free' ? 'badge--green' : tool.pricing === 'freemium' ? 'badge--blue' : 'badge--muted'}`}>
              {tool.pricingLabel}
            </span>
          </div>
        </a>
      ))}
    </div>

    <a href={`${base}/tools/`} class="related-tools__all">
      تمام اے آئی ٹولز دیکھیں ←
    </a>
  </section>
)}

<style>
  .related-tools {
    margin-block: var(--space-xl);
    padding: var(--space-lg);
    background: var(--paper-warm);
    border: 1.5px solid var(--border);
    border-radius: 10px;
  }

  .related-tools__title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 1.15rem;
    color: var(--ink);
    margin-block-end: var(--space-md);
    line-height: 1.8;
  }

  .related-tools__title svg {
    flex-shrink: 0;
    color: var(--navy);
  }

  .related-tools__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .related-tool {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .related-tool:hover {
    border-color: var(--navy);
    box-shadow: 0 2px 8px rgba(29, 85, 159, 0.1);
  }

  .related-tool__logo {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: contain;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    padding: 3px;
    flex-shrink: 0;
  }

  .related-tool__info {
    flex: 1;
    min-width: 0;
  }

  .related-tool__name {
    display: block;
    font-weight: 700;
    color: var(--ink);
    font-size: var(--text-base);
    line-height: 1.4;
  }

  .related-tool__urdu {
    display: block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .related-tool__meta {
    flex-shrink: 0;
  }

  .related-tools__all {
    display: inline-block;
    margin-block-start: var(--space-md);
    color: var(--teal);
    font-size: var(--text-sm);
    text-decoration: none;
    font-weight: 600;
  }

  .related-tools__all:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .related-tool__meta {
      display: none;
    }
  }
</style>
