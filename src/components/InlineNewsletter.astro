---
// InlineNewsletter.astro — urduai.org
// Newsletter subscribe + WhatsApp + App CTA — placed inside articles after content
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="inline-newsletter" aria-label="اردو اے آئی سے جڑیں">
  <div class="inline-newsletter__inner">
    <strong class="inline-newsletter__title">اردو اے آئی سے جڑے رہیں</strong>
    <p class="inline-newsletter__sub">ہفتہ وار نیوز لیٹر سبسکرائب کریں یا واٹس ایپ چینل جوائن کریں</p>
    <div class="inline-newsletter__buttons">
      <a
        href="https://www.urduaiupdates.com/subscribe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-newsletter__btn inline-newsletter__btn--newsletter"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        نیوز لیٹر سبسکرائب کریں
      </a>
      <a
        href="https://whatsapp.com/channel/0029VaFMqhb002TnKByMOp0D"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-newsletter__btn inline-newsletter__btn--whatsapp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        واٹس ایپ چینل جوائن کریں
      </a>
      <a
        href="https://play.google.com/store/apps/details?id=org.urduai.app"
        target="_blank"
        rel="noopener"
        class="inline-newsletter__btn inline-newsletter__btn--app"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 13l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/></svg>
        ایپ ڈاؤن لوڈ کریں
      </a>
    </div>
  </div>
</div>

<style>
  .inline-newsletter {
    background: var(--ink);
    border-radius: 10px;
    padding: var(--space-lg);
    margin-block: var(--space-xl);
    text-align: center;
  }

  .inline-newsletter__title {
    display: block;
    font-size: var(--text-h3);
    color: var(--gold-light);
    margin-block-end: var(--space-xs);
  }

  .inline-newsletter__sub {
    color: var(--gold-pale);
    font-size: var(--text-sm);
    margin-block-end: var(--space-md);
    line-height: var(--lh-body);
  }

  .inline-newsletter__buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .inline-newsletter__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6em 1.2em;
    border-radius: 8px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .inline-newsletter__btn:hover {
    opacity: 0.9;
  }

  .inline-newsletter__btn--newsletter {
    background: var(--navy);
    color: #fff;
  }

  .inline-newsletter__btn--whatsapp {
    background: #25D366;
    color: #fff;
  }

  .inline-newsletter__btn--app {
    background: var(--gold);
    color: var(--ink);
  }
</style>
