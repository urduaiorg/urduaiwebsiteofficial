---
// InlineNewsletter.astro — urduai.org
// Substack embed — placed inside articles after content
---

<div class="inline-newsletter" aria-label="نیوز لیٹر">
  <div class="inline-newsletter__inner">
    <strong class="inline-newsletter__title">اردو اے آئی نیوز لیٹر</strong>
    <p class="inline-newsletter__sub">ہر ہفتے اے آئی کی تازہ ترین خبریں، گائیڈز اور پرامٹس — سیدھے آپ کی ای میل میں</p>
    <div class="inline-newsletter__embed">
      <iframe
        src="https://www.urduaiupdates.com/embed"
        width="480"
        height="320"
        style="border:1px solid #EEE; background:white;"
        frameborder="0"
        scrolling="no"
        title="اردو اے آئی نیوز لیٹر سبسکرائب کریں"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .inline-newsletter {
    background: var(--ink);
    border-radius: 10px;
    padding: var(--space-lg);
    margin-block: var(--space-xl);
    text-align: center;
  }

  .inline-newsletter__title {
    display: block;
    font-size: var(--text-h3);
    color: var(--gold-light);
    margin-block-end: var(--space-xs);
  }

  .inline-newsletter__sub {
    color: var(--gold-pale);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-md);
    line-height: var(--lh-body);
  }

  .inline-newsletter__embed {
    display: flex;
    justify-content: center;
  }

  .inline-newsletter__embed iframe {
    max-width: 100%;
    border-radius: 6px;
  }
</style>
